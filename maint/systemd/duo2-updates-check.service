[Unit]
Description=OpenDuo: look for system updates (Settings > Updates)
Documentation=file:///usr/local/lib/duo2-maint/duo2-updates
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/duo2-updates run-check
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=30min
