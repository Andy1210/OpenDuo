def set_conf_key(text, key, value):
    """The config text with `key = value` (the first active line, else a
    commented-out one, else appended). Pure."""
    lines = text.splitlines()
    out, done = [], False
    for line in lines:
        bare = line.strip()
        if (
            not done
            and "=" in bare
            and not bare.startswith("#")
            and bare.split("=", 1)[0].strip() == key
        ):
            out.append("%s = %s" % (key, value))
            done = True
        else:
            out.append(line)
    if not done:
        for i, line in enumerate(out):
            bare = line.strip().lstrip("#").strip()
            if "=" in bare and bare.split("=", 1)[0].strip() == key:
                out[i] = "%s = %s" % (key, value)
                done = True
                break
    if not done:
        out.append("%s = %s" % (key, value))
    return "\n".join(out) + "\n"


def edit_conf(path, key, value, mode=0o644):
    try:
        with open(path) as f:
            text = f.read()
    except FileNotFoundError:
        text = ""
    new = set_conf_key(text, key, value)
    if new != text:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path + ".new", "w") as f:
            f.write(new)
        os.chmod(path + ".new", mode)
        os.replace(path + ".new", path)


def pen_fw_set():
    """The newest firmware set folder (by its version-like name), or None."""
    try:
        names = [n for n in os.listdir(PEN_FW_SETS) if os.path.isdir(os.path.join(PEN_FW_SETS, n))]
    except OSError:
        return None

    def key(n):
        return [int(x) if x.isascii() and x.isdigit() else -1 for x in n.split(".")]

    return os.path.join(PEN_FW_SETS, max(names, key=key)) if names else None


def pen_fw_unit_active():
    return subprocess.run(["systemctl", "is-active", "--quiet", PEN_FW_UNIT]).returncode == 0


def pen_fw(command):
    if command == "fw-available":
        d = pen_fw_set()
        if not d:
            print("{}")
            return 0
        r = subprocess.run(
            [sys.executable, "-I", PEN_FW, "inspect", "--json", d],
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
            timeout=60,
        )
        print(r.stdout.strip() if r.returncode == 0 and r.stdout.strip() else "{}")
        return 0
    if command == "fw-update":
        d = pen_fw_set()
        if not d or pen_fw_unit_active():
            return 1
        return subprocess.run(
            [
                "systemd-run",
                "--unit=" + PEN_FW_UNIT,
                "--collect",
                "--quiet",
                "-p",
                "RuntimeMaxSec=7200",
                sys.executable,
                "-I",
                PEN_FW,
                "update",
                "--fw",
                d,
                "--go",
                "--until-done",
                "--status",
                PEN_FW_STATUS,
            ],
            stdout=subprocess.DEVNULL,
        ).returncode
    if command == "fw-stop":
        if pen_fw_unit_active():
            subprocess.run(["systemctl", "stop", PEN_FW_UNIT], stdout=subprocess.DEVNULL)
        return 0
    return 2


def read_key(path, key):
    try:
        with open(path) as f:
            for line in f:
                line = line.split("#", 1)[0]
                if "=" in line and line.split("=", 1)[0].strip() == key:
                    return line.split("=", 1)[1].strip()
    except OSError:
        pass
    return None


def write_refresh(value):
    try:
        with open(REFRESH_PARAM, "w") as f:
            f.write(value)
        return True
    except OSError as e:
        print("duo-settings-helper: %s: %s" % (REFRESH_PARAM, e), file=sys.stderr)
        return False


def valid_zone(zone):
    if not re.fullmatch(r"[A-Za-z0-9_+-]+(/[A-Za-z0-9_+-]+){0,2}", zone):
        return False
    path = os.path.realpath(os.path.join(ZONEINFO, zone))
    return path.startswith(ZONEINFO + "/") and os.path.isfile(path)


def generated_locales(listing=None):
    """The xx_YY.UTF-8 locales built into the system (`locale -a`), sorted. Pure
    when `listing` (the command's output) is given."""
    if listing is None:
        listing = subprocess.run(
            ["locale", "-a"],
            capture_output=True,
            text=True,
            env={"LC_ALL": "C", "PATH": "/usr/bin:/bin"},
        ).stdout
    out = set()
    for name in listing.split():
        m = re.fullmatch(r"([a-z]{2,3}_[A-Z]{2})\.utf-?8", name, re.I)
        if m:
            out.add(m.group(1) + ".UTF-8")
    return sorted(out)


def valid_locale_args(lang, region, day, generated):
    return (
        LOCALE_RE.fullmatch(lang) is not None
        and LOCALE_RE.fullmatch(region) is not None
        and lang in generated
        and region in generated
        and day in ("auto", "mon", "sun", "sat")
    )


def time_source(read, base, first):
    """A locale source holding only `base`'s LC_TIME with first_weekday `first`
    (1 Sunday, 2 Monday, 7 Saturday). `read(name)` returns a locales file's text
    (a `copy "x"` is followed). Pure."""
    name, text = base, None
    for _ in range(6):
        text = read(name)
        m = re.search(r"^LC_TIME\n(.*?)^END LC_TIME", text, re.S | re.M)
        if not m:
            raise ValueError("no LC_TIME in " + name)
        body = m.group(1)
        c = re.match(r'\s*copy\s+"([A-Za-z0-9_@.-]+)"\s*$', body)
        if not c:
            break
        name = c.group(1)
    else:
        raise ValueError("copy loop")
    esc = re.search(r"^escape_char\s+(\S)", text, re.M)
    com = re.search(r"^comment_char\s+(\S)", text, re.M)
    body = re.sub(r"^first_weekday\s.*\n?", "", body, flags=re.M)
    body = (
        re.sub(r"^(week\s.*)$", r"\1\nfirst_weekday %s" % first, body, count=1, flags=re.M)
        if re.search(r"^week\s", body, re.M)
        else body + "first_weekday %s\n" % first
    )
    return "comment_char %s\nescape_char %s\nLC_TIME\n%sEND LC_TIME\n" % (
        com.group(1) if com else "%",
        esc.group(1) if esc else "/",
        body,
    )


def time_locale_name(region, day):
    return region + "@" + day


def locale_conf_text(lang, region, tname):
    return (
        "# Written by Duo Settings (Language & region). /etc/default/locale is a link to\n"
        "# this file; duo-wc.service reads it when the session starts.\n"
        "LANG=%s\nLC_NUMERIC=%s\nLC_TIME=%s\nLC_MONETARY=%s\nLC_PAPER=%s\nLC_MEASUREMENT=%s\n"
        % (lang, region, tname, region, region, region)
    )


def first_weekday_of(locale_name):
    r = subprocess.run(
        ["locale", "first_weekday"],
        capture_output=True,
        text=True,
        env={"LC_ALL": locale_name, "PATH": "/usr/bin:/bin"},
    )
    return r.stdout.strip()


def locale_set(lang, region, day):
    tname = region
    if day != "auto" and first_weekday_of(region) != DAYS[day]:
        tname = time_locale_name(region, day)

        def read(n):
            with open(os.path.join(LOCALE_SRC, n)) as f:
                return f.read()

        src = time_source(read, region.split(".")[0], DAYS[day])
        tmp = "/run/duo-locale-src"
        with open(tmp, "w") as f:
            f.write(src)
        subprocess.run(
            [
                "localedef",
                "--no-archive",
                "-c",
                "-i",
                tmp,
                "-f",
                "UTF-8",
                os.path.join(LOCALE_DIR, tname),
            ],
            capture_output=True,
        )
        os.unlink(tmp)
        if first_weekday_of(tname) != DAYS[day]:
            print("duo-settings-helper: could not build %s" % tname, file=sys.stderr)
            return False
    os.makedirs(os.path.dirname(REGION_CONF), exist_ok=True)
    edit_conf(REGION_CONF, "first_weekday", day)
    with open(LOCALE_CONF + ".new", "w") as f:
        f.write(locale_conf_text(lang, region, tname))
    os.chmod(LOCALE_CONF + ".new", 0o644)
    os.replace(LOCALE_CONF + ".new", LOCALE_CONF)
    return True


def valid_matrix(vals):
    if len(vals) != 6:
        return False
    try:
        nums = [float(v) for v in vals]
    except ValueError:
        return False
    if not all(re.fullmatch(r"-?[0-9]+(\.[0-9]+)?", v) for v in vals):
        return False
    a, b, c, d, e, f = nums
    # A calibration, not a remapping: near identity.
    return (
        0.8 <= a <= 1.2
        and 0.8 <= e <= 1.2
        and abs(b) <= 0.2
        and abs(d) <= 0.2
        and abs(c) <= 0.2
        and abs(f) <= 0.2
    )


def touch_rules(current, panel, matrix):
    """The rules file text with `panel`'s line replaced (matrix None: removed).
    Pure."""
    name = TOUCH_NAMES[panel]
    keep = [
        ln
        for ln in current.splitlines()
        if ln.strip() and not ln.startswith("#") and ('ATTRS{name}=="%s"' % name) not in ln
    ]
    if matrix is not None:
        keep.append(
            'ACTION!="remove", SUBSYSTEM=="input", KERNEL=="event*", '
            'ATTRS{name}=="%s", ENV{LIBINPUT_CALIBRATION_MATRIX}="%s"' % (name, " ".join(matrix))
        )
    if not keep:
        return ""
    head = (
        "# Written by Duo Settings (Touch calibration): overrides the shipped\n"
        "# matrix in 90-duo2-touch.rules. Delete to go back to it.\n"
    )
    return head + "\n".join(sorted(keep)) + "\n"


def touch_matrix(panel, matrix):
    try:
        with open(TOUCH_RULES) as f:
            cur = f.read()
    except FileNotFoundError:
        cur = ""
    text = touch_rules(cur, panel, matrix)
    if text:
        with open(TOUCH_RULES + ".new", "w") as f:
            f.write(text)
        os.chmod(TOUCH_RULES + ".new", 0o644)
        os.replace(TOUCH_RULES + ".new", TOUCH_RULES)
    elif os.path.exists(TOUCH_RULES):
        os.unlink(TOUCH_RULES)
    subprocess.run(["udevadm", "control", "--reload"], check=False)
    subprocess.run(
        [
            "udevadm",
            "trigger",
            "--action=change",
            "--subsystem-match=input",
            "--attr-match=name=" + TOUCH_NAMES[panel],
        ],
        check=False,
    )
    subprocess.run(["udevadm", "settle", "--timeout=5"], check=False)
    return True


