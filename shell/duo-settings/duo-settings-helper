def wc_admin(request, **args):
    """One request on duo-wc's admin socket (as root): True if it was done."""
    return wc_admin_reply(request, **args) is not None


def wc_admin_reply(request, **args):
    """One request on duo-wc's admin socket (as root): its answer (the "ok"
    part), or None when it was not done."""
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
            s.settimeout(3)
            s.connect(WC_ADMIN)
            s.sendall((json.dumps(dict(id=1, request=request, **args)) + "\n").encode())
            buf = b""
            while not buf.endswith(b"\n"):
                chunk = s.recv(65536)
                if not chunk:
                    break
                buf += chunk
        reply = json.loads(buf.decode() or "{}")
        return reply.get("ok", {}) if isinstance(reply, dict) and "ok" in reply else None
    except (OSError, ValueError):
        return None


def ask_user(detail):
    """Ask the user in the shell (duo-wc's confirm, action "helper", waited
    for): True only on a yes. No answer, no shell: no."""
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
            s.settimeout(WC_ADMIN_SOCKET_WAIT_S)
            s.connect(WC_ADMIN)
            request = {"id": 1, "request": "confirm", "action": "helper", "detail": detail}
            s.sendall((json.dumps(dict(request, wait=True)) + "\n").encode())
            buf = b""
            while b"\n" not in buf:
                chunk = s.recv(4096)
                if not chunk:
                    break
                buf += chunk
        reply = json.loads(buf.split(b"\n")[0] or b"{}")
    except (OSError, ValueError):
        return False
    return isinstance(reply, dict) and (reply.get("ok") or {}).get("yes") is True


SIM_QUESTION = {
    "1": "Use the SIM card in the tray for calls, messages and mobile data? The eSIM is "
    "switched off until you switch back. The phone has no signal for about a minute.",
    "2": "Use the eSIM for calls, messages and mobile data? The SIM card in the tray is "
    "switched off until you switch back. The phone has no signal for about a minute.",
}


def sim_tool(args, timeout):
    """duo2-sim as a transient service that systemd (PID 1) starts: it talks
    QMI over QRTR, which the GUI's programs, and this helper under their
    sudo, may not (docs/hardware/security.md). (exit code, stdout, stderr)."""
    cmd = [
        SYSTEMD_RUN,
        "--quiet",
        "--pipe",
        "--wait",
        "--collect",
        "--service-type=exec",
        "--unit=duo-settings-sim-%d" % os.getpid(),
        "--description=Duo Settings: the SIM slots",
        "--property=RuntimeMaxSec=%d" % timeout,
        "--",
        SIM_TOOL,
    ] + list(args)
    try:
        r = subprocess.run(
            cmd, stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=timeout + 15
        )
    except (OSError, subprocess.TimeoutExpired) as e:
        return -1, "", str(e)
    return r.returncode, r.stdout, r.stderr


def sim_use(slot):
    """Switch the SIM in use after the user's yes; prints the JSON answer."""
    if not ask_user(SIM_QUESTION[slot]):
        print(json.dumps({"ok": False, "error": "not confirmed"}))
        return 1
    code, out, err = sim_tool(["use", slot], 150)
    if code == 0:
        print(json.dumps({"ok": True, "message": (out.strip().splitlines() or [""])[-1]}))
        return 0
    why = (err.strip().splitlines() or out.strip().splitlines() or ["it did not work"])[-1]
    print(json.dumps({"ok": False, "error": why}))
    return 1


def battery_stats(action, report=None, wait_s=10.0):
    """Ask the collector for a fresh report (refresh) or to clear its usage
    history (clear); True once its report has been rewritten."""
    report = report or BATTERY_REPORT
    try:
        before = os.stat(report).st_mtime_ns
    except OSError:
        before = None
    r = subprocess.run(
        [
            "systemctl",
            "kill",
            "--kill-whom=main",
            "--signal=" + BATTERY_SIGNALS[action],
            "duo2-battery-stats.service",
        ],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
    if r.returncode != 0:
        return False
    deadline = time.monotonic() + wait_s
    while time.monotonic() < deadline:
        try:
            if os.stat(report).st_mtime_ns != before:
                return True
        except OSError:
            pass
        time.sleep(0.1)
    return False


JUNK_SERIALS = (
    "",
    "0",
    "none",
    "unknown",
    "default string",
    "to be filled by o.e.m.",
    "not specified",
    "system serial number",
    "not applicable",
)


def clean_serial(text):
    """A SMBIOS serial, or None for the empty and placeholder ones. Pure."""
    value = (text or "").strip()
    if value.lower() in JUNK_SERIALS or not re.fullmatch(r"[A-Za-z0-9._-]{4,64}", value):
        return None
    return value


def read_serial(base=DMI):
    for name in ("product_serial", "board_serial", "chassis_serial"):
        try:
            with open(os.path.join(base, name)) as f:
                got = clean_serial(f.read())
        except OSError:
            continue
        if got:
            return got
    return None


def qmi_ids():
    """The modem's IMEIs: the reader runs as a transient system service, which
    systemd (PID 1) starts without the session's seccomp filter. -> list of
    {"sub", "imei", "sv"} ([] when it fails)."""
    cmd = [
        SYSTEMD_RUN,
        "--quiet",
        "--pipe",
        "--wait",
        "--collect",
        "--service-type=exec",
        "--description=duo-settings: modem identity",
    ]
    cmd += ["--property=" + p for p in QMI_UNIT_PROPERTIES]
    cmd += ["--", "/usr/bin/python3", "-I", QMI_SCRIPT]
    try:
        r = subprocess.run(
            cmd,
            stdin=subprocess.DEVNULL,
            capture_output=True,
            text=True,
            timeout=25,
            env={"PATH": "/usr/sbin:/usr/bin:/sbin:/bin"},
        )
        data = json.loads(r.stdout.strip().splitlines()[-1]) if r.returncode == 0 else {}
    except (OSError, subprocess.TimeoutExpired, ValueError, IndexError):
        return []
    out = []
    for item in data.get("ids", []):
        if isinstance(item, dict) and re.fullmatch(r"[0-9]{14,16}", str(item.get("imei", ""))):
            sv = str(item.get("sv", ""))
            out.append(
                {
                    "sub": int(item.get("sub", 0)),
                    "imei": item["imei"],
                    "sv": sv if sv.isascii() and sv.isdigit() else "",
                }
            )
    return out


def identity():
    print(json.dumps({"serial": read_serial(), "imeis": qmi_ids()}))
    return 0


GEOCLUE_APPS_CONF = "/etc/geoclue/conf.d/91-duo2-apps.conf"
GEOCLUE_APP_ID = re.compile(r"[A-Za-z0-9][A-Za-z0-9._-]{0,127}")


def valid_app_ids(ids):
    return len(ids) <= 64 and all(GEOCLUE_APP_ID.fullmatch(i) for i in ids)


def geoclue_apps_text(ids):
    """geoclue's per-app sections for the refused apps (`allowed=false`:
    geoclue answers them no whatever the agent says)."""
    out = [
        "# Written by duo-settings-helper (Settings > Privacy): the apps that may",
        "# not learn the phone's position. One section per desktop id.",
    ]
    for app in sorted(set(ids)):
        out += ["", "[%s]" % app, "allowed=false", "system=false", "users="]
    return "\n".join(out) + "\n"


def geoclue_deny(ids):
    tmp = GEOCLUE_APPS_CONF + ".new"
    os.makedirs(os.path.dirname(GEOCLUE_APPS_CONF), exist_ok=True)
    with open(tmp, "w") as f:
        f.write(geoclue_apps_text(ids))
    os.chmod(tmp, 0o644)
    os.replace(tmp, GEOCLUE_APPS_CONF)
    # geoclue reads its config when it starts (it is D-Bus activated and
    # stops when idle): a running one starts anew, its clients reconnect.
    subprocess.run(["systemctl", "try-restart", "geoclue.service"], check=False)
    return True


def main(argv):
    n = len(argv)
    if n == 2 and argv[0] == "refresh" and argv[1] in ("60", "90"):
        edit_conf(DISPLAY_CONF, "refresh", argv[1])
        return 0 if write_refresh(argv[1]) else 1
    if argv == ["refresh-boot"]:
        value = read_key(DISPLAY_CONF, "refresh")
        if value not in ("60", "90"):
            return 0
        for _ in range(100):  # the panel module may still be loading
            if os.path.exists(REFRESH_PARAM):
                break
            time.sleep(0.1)
        return 0 if write_refresh(value) else 1
    if n == 3 and argv[0] == "wc-conf" and argv[1] in WC_KEYS and WC_KEYS[argv[1]](argv[2]):
        if argv[1] in WC_NEW:
            request, build = WC_LIVE[argv[1]]
            reply = wc_admin_reply(request, **build(argv[2]))
            if not isinstance(reply, dict) or WC_NEW[argv[1]] not in reply:
                print(
                    "duo-wc does not know %s yet (update duo-wc first)" % argv[1], file=sys.stderr
                )
                return 1
            edit_conf(WC_CONF, argv[1], argv[2])
            return 0
        edit_conf(WC_CONF, argv[1], argv[2])
        if argv[1] in WC_LIVE:
            request, build = WC_LIVE[argv[1]]
            wc_admin(request, **build(argv[2]))
        return 0
    if n == 3 and argv[:2] == ["pen", "palm"] and argv[2] in PALM_MODES:
        edit_conf(PEN_CONF, "palm_rejection", argv[2])
        return 0
    if n == 3 and argv[:2] == ["pen", "feel"] and argv[2] in FEELS:
        edit_conf(PEN_CONF, "writing_feel", argv[2])
        return 0
    if (
        n == 3
        and argv[:2] == ["pen", "strength"]
        and is_ascii_number(argv[2])
        and 1 <= int(argv[2]) <= 100
    ):
        edit_conf(PEN_CONF, "feel_strength", str(int(argv[2])))
        return 0
    if n == 2 and argv[0] == "pen" and argv[1] in ("fw-available", "fw-update", "fw-stop"):
        return pen_fw(argv[1])
    if n == 3 and argv[:2] == ["pen", "click"] and argv[2] in ("on", "off"):
        edit_conf(PEN_CONF, "button_click", argv[2])
        return 0
    if n == 3 and argv[:2] == ["pen", "charge"] and argv[2] in ("on", "off"):
        return subprocess.run([PEN_CHARGER, argv[2]], stdout=subprocess.DEVNULL).returncode
    if argv[:1] == ["laptop"] and laptop_request(argv[1:]) is not None:
        return 0 if wc_admin("set_laptop", **laptop_request(argv[1:])) else 1
    if argv[:1] == ["display"] and display_request(argv[1:]) is not None:
        return 0 if wc_admin("set_external", **display_request(argv[1:])) else 1
    if argv[:1] == ["pose"] and tuple(argv[1:]) in POSES:
        return 0 if wc_admin("set_pose", **POSES[tuple(argv[1:])]) else 1
    if argv == ["sim", "slots"]:
        code, out, _err = sim_tool(["slots"], 40)
        print((out.strip().splitlines() or ["[]"])[-1])
        return 0 if code == 0 else 1
    if n == 3 and argv[:2] == ["sim", "use"] and argv[2] in SIM_QUESTION:
        return sim_use(argv[2])
    if argv == ["restart-display"]:
        # Not `systemctl restart`: any app can run this helper. duo-wc asks
        # the user in the shell, and restarts (it exits, systemd brings it
        # back) only on that question's yes.
        return 0 if wc_admin("confirm", action="restart-display") else 1
    if argv[:2] == ["posed", "panels"] and n == 3 and argv[2] in ("both", "left", "right"):
        edit_conf(POSED_CONF, "panels", argv[2])
        subprocess.run(["systemctl", "try-reload-or-restart", "duo-posed.service"], check=False)
        pose = {"both": ("dual",), "left": ("single", "DSI-1"), "right": ("single", "DSI-2")}[
            argv[2]
        ]
        wc_admin("set_pose", **POSES[pose])
        return 0
    if n == 3 and argv[0] == "posed" and argv[1] in POSED_KEYS and argv[2] in ("on", "off"):
        edit_conf(POSED_CONF, argv[1], argv[2])
        subprocess.run(["systemctl", "try-reload-or-restart", "duo-posed.service"], check=False)
        return 0
    if n == 2 and argv[0] == "timezone" and valid_zone(argv[1]):
        return subprocess.run(["timedatectl", "set-timezone", argv[1]]).returncode
    if n == 2 and argv[0] == "ntp" and argv[1] in ("on", "off"):
        return subprocess.run(
            ["timedatectl", "set-ntp", "true" if argv[1] == "on" else "false"]
        ).returncode
    if n == 4 and argv[0] == "locale-set" and valid_locale_args(*argv[1:], generated_locales()):
        return 0 if locale_set(*argv[1:]) else 1
    if n >= 3 and argv[0] == "touch-matrix" and argv[1] in TOUCH_NAMES:
        if argv[2:] == ["reset"]:
            return 0 if touch_matrix(argv[1], None) else 1
        if valid_matrix(argv[2:]):
            return 0 if touch_matrix(argv[1], argv[2:]) else 1
    if n == 2 and argv[0] == "battery" and argv[1] in BATTERY_SIGNALS:
        if not battery_stats(argv[1]):
            return 1
        try:
            with open(BATTERY_REPORT) as f:  # the report on stdout: Duo Settings
                sys.stdout.write(f.read(4 << 20))  # needs no group to read it
        except OSError:
            return 1
        return 0
    if argv == ["identity"]:
        return identity()
    if argv[:1] == ["geoclue-deny"] and valid_app_ids(argv[1:]):
        return 0 if geoclue_deny(argv[1:]) else 1
    print(__doc__.strip(), file=sys.stderr)
    return 2


if __name__ == "__main__":
    # Whatever sudo handed over: the helper starts only the system's tools.
    os.environ["PATH"] = "/usr/sbin:/usr/bin:/sbin:/bin"
    sys.exit(main(sys.argv[1:]))
