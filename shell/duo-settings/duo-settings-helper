def is_ascii_number(value):
    """A short run of ASCII digits 0-9. str.isdigit() alone also takes
    superscripts and other scripts' digits, which int() may refuse and a
    config parser would not read. Pure."""
    return value.isascii() and value.isdigit() and len(value) <= 9


def pen_apps_ok(value):
    """duo-wc.conf's pen_apps: app ids (letters, digits, . _ -) separated by
    commas and spaces, or nothing; nothing that could end the line or start a
    comment. Pure."""
    if len(value) > 1000:
        return False
    ok = set("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789._-, ")
    return set(value) <= ok


