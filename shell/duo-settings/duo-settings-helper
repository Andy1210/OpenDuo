def laptop_request(args):
    """`laptop ...` -> the arguments of duo-wc's set_laptop, or None when
    they are not allowed. Pure."""
    if len(args) == 1 and args[0] in ("on", "off", "toggle"):
        return {"laptop": args[0]}
    if len(args) == 2 and args[0] == "auto" and args[1] in ("on", "off"):
        return {"auto": args[1]}
    if len(args) == 2 and args[0] == "keys" and args[1] in ("DSI-1", "DSI-2"):
        return {"keys": args[1]}
    return None


def display_request(args):
    """`display ...` -> the arguments of duo-wc's set_external, or None when
    they are not allowed. Pure."""
    if len(args) == 2 and args[0] == "on_connect" and args[1] in ("ask", "desk", "mirror"):
        return {"on_connect": args[1]}
    if len(args) == 2 and args[0] == "mirror" and args[1] in ("active", "both", "DSI-1", "DSI-2"):
        return {"mirror": args[1]}
    return None


