#!/usr/bin/python3 -sE
"""duo-appearance: Dark / Light / Automatic for the apps (Settings >
Appearance; duosettings/appearance.py says what follows and how). Runs as
the GUI user.

  duo-appearance                  apply the setting now (Settings, the
                                  timer of Automatic, the session)
  duo-appearance set dark|light|auto [--light-from HH:MM] [--dark-from HH:MM]
                                  save and apply; Automatic switches on its
                                  timer (every 15 minutes), the others off
  duo-appearance android [--force]
                                  Android's night mode only, if Android runs
                                  (duo2-waydroid-idle, once Android is up)
  duo-appearance status           the setting and what is applied (JSON)
"""

import json
import os
import subprocess
import sys
import time

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

from duosettings import appearance as ap  # noqa: E402

KDEGLOBALS = os.path.join(os.path.expanduser("~"), ".config", "kdeglobals")
STATE_DIR = os.path.join(os.path.expanduser("~"), ".local", "state", "duo2")
ANDROID_STATE = os.path.join(STATE_DIR, "appearance-android")
CGROUP = "/sys/fs/cgroup/lxc.payload.waydroid"
TASK = "/usr/local/sbin/duo2-android-task"


def log(msg):
    print("duo-appearance: %s" % msg, flush=True)


def read(path):
    try:
        with open(path) as f:
            return f.read()
    except OSError:
        return None


def now_minutes():
    t = time.localtime()
    return t.tm_hour * 60 + t.tm_min


def apply_gsettings(scheme):
    """The GTK side; True when something changed."""
    try:
        import gi

        gi.require_version("Gio", "2.0")
        from gi.repository import Gio

        settings = Gio.Settings.new("org.gnome.desktop.interface")
    except (ImportError, ValueError, TypeError) as e:
        log("no GSettings: %s" % e)
        return False
    changed = False
    keys = settings.props.settings_schema.list_keys()
    for key, value in ap.gsettings_for(scheme).items():
        if key in keys and settings.get_string(key) != value:
            settings.set_string(key, value)
            changed = True
    Gio.Settings.sync()
    return changed


def notify_kde():
    """Running Qt apps with the KDE platform theme reload their palette
    (KGlobalSettings' PaletteChanged, what Plasma sends)."""
    try:
        import gi

        gi.require_version("Gio", "2.0")
        from gi.repository import Gio, GLib

        bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
        bus.emit_signal(
            None,
            "/KGlobalSettings",
            "org.kde.KGlobalSettings",
            "notifyChange",
            GLib.Variant("(ii)", (0, 0)),
        )
        bus.flush_sync(None)
    except Exception as e:  # noqa: BLE001 (no bus: nothing runs to tell)
        log("could not tell running Qt apps: %s" % e)


def apply_kde(scheme):
    action, arg = ap.kde_action(scheme, read(KDEGLOBALS), read(ap.KDE_LIGHT))
    if action == "write":
        os.makedirs(os.path.dirname(KDEGLOBALS), exist_ok=True)
        with open(KDEGLOBALS + ".duo2-tmp", "w") as f:
            f.write(arg)
        os.replace(KDEGLOBALS + ".duo2-tmp", KDEGLOBALS)
    elif action == "remove":
        os.unlink(KDEGLOBALS)
    else:
        return False
    notify_kde()
    return True


def android_running():
    """Running and not frozen (a frozen container cannot be asked)."""
    try:
        with open(os.path.join(CGROUP, "cgroup.events")) as f:
            return "frozen 1" not in f.read()
    except OSError:
        return False


def apply_android(scheme, force=False):
    """'applied', 'same', 'not running' or 'failed'."""
    if not force and (read(ANDROID_STATE) or "").strip() == scheme:
        return "same"
    if not android_running() or not os.path.exists(TASK):
        return "not running"
    r = subprocess.run(
        ["sudo", "-n", TASK, "night", "yes" if scheme == "dark" else "no"],
        capture_output=True,
        text=True,
        timeout=60,
    )
    if r.returncode != 0:
        log("Android night mode: %s" % (r.stderr.strip() or r.returncode))
        return "failed"
    os.makedirs(STATE_DIR, exist_ok=True)
    with open(ANDROID_STATE + ".tmp", "w") as f:
        f.write(scheme + "\n")
    os.replace(ANDROID_STATE + ".tmp", ANDROID_STATE)
    return "applied"


def apply(prefs):
    scheme = ap.scheme_for(prefs, now_minutes())
    parts = []
    if apply_gsettings(scheme):
        parts.append("GTK")
    if apply_kde(scheme):
        parts.append("Qt")
    a = apply_android(scheme)
    if a == "applied":
        parts.append("Android")
    if parts:
        log("%s (%s): %s" % (scheme, prefs["mode"], ", ".join(parts)))
    return scheme


def timer(on):
    subprocess.run(
        ["systemctl", "--user", "enable" if on else "disable", "--now", "duo-appearance.timer"],
        capture_output=True,
        timeout=30,
    )


def main(argv):
    prefs = ap.load()
    if not argv:
        apply(prefs)
        return 0
    cmd = argv[0]
    if cmd == "set":
        if len(argv) < 2 or argv[1] not in ap.MODES:
            print(__doc__, file=sys.stderr)
            return 2
        prefs["mode"] = argv[1]
        rest = argv[2:]
        while rest:
            if len(rest) < 2 or rest[0] not in ("--light-from", "--dark-from"):
                print(__doc__, file=sys.stderr)
                return 2
            try:
                prefs[rest[0][2:].replace("-", "_")] = ap.parse_hhmm(rest[1])
            except ValueError as e:
                print("duo-appearance: %s" % e, file=sys.stderr)
                return 2
            rest = rest[2:]
        ap.save(prefs)
        timer(prefs["mode"] == "auto")
        print(apply(prefs))
        return 0
    if cmd == "android":
        scheme = ap.scheme_for(prefs, now_minutes())
        result = apply_android(scheme, force="--force" in argv[1:])
        print(result)
        return 0 if result in ("applied", "same") else 3
    if cmd == "status":
        scheme = ap.scheme_for(prefs, now_minutes())
        kde = read(KDEGLOBALS)
        print(
            json.dumps(
                {
                    "mode": prefs["mode"],
                    "light_from": ap.hhmm(prefs["light_from"]),
                    "dark_from": ap.hhmm(prefs["dark_from"]),
                    "scheme": scheme,
                    "qt": "light" if ap.is_ours(kde) else ("own file" if kde else "dark"),
                    "android": (read(ANDROID_STATE) or "").strip() or None,
                }
            )
        )
        return 0
    print(__doc__, file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
