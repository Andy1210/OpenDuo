 {
 	struct fastrpc_interface **ifaces;
 	struct hexagonfs_dirent *root_dir;
-	size_t n_ifaces = 2;
+	size_t n_ifaces = 3;
+	char *props_path;
 	int ret;
 
 	ifaces = malloc(sizeof(struct fastrpc_interface) * n_ifaces);
@@ -215,6 +217,20 @@ static void *start_reverse_tunnel(int fd, const char *device_dir, const char *ds
 	// Dynamic interfaces with no hardcoded handle
 	ifaces[1] = fastrpc_apps_std_init(root_dir);
 
+	/*
+	 * Android system properties the sensors process asks for while it
+	 * builds its registry, from <root>/sensors/properties.
+	 */
