+#ifndef INTERFACE_SNS_REGISTRY_DEF
+#define INTERFACE_SNS_REGISTRY_DEF
+
+#include <libhexagonrpc/interface.h>
+
+/*
+ * long get_property(in string prop_name, rout string prop_value);
+ * The first input buffer holds only the two lengths.
+ */
+HEXAGONRPC_DEFINE_REMOTE_METHOD(0, sns_registry_get_property, 0, 1, 0, 1)
+
+#endif /* INTERFACE_SNS_REGISTRY_DEF */
