diff --git a/hexagonrpcd/sns_registry.c b/hexagonrpcd/sns_registry.c
new file mode 100644
index 0000000..1cbdcd0
--- /dev/null
+++ b/hexagonrpcd/sns_registry.c
@@ -0,0 +1,134 @@
+/*
+ * FastRPC sns_registry interface (Android system properties for the SSC)
+ *
+ * Copyright (C) 2026 The duo2-os Contributors
+ *
+ * This program is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation, either version 3 of the License, or
+ * (at your option) any later version.
+ *
+ * The sensors process on the DSP calls this interface on the application
+ * processor while it builds its registry from the json configuration: a
+ * configuration may select itself by an Android system property (for example
+ * "ro.build.version.release"), and sns_reg_config may name properties too.
+ * On Android the vendor's libsns_registry_skel.so answers with property_get().
+ * Here the answers come from a plain "name=value" file in the root
+ * directory (sensors/properties); an unknown property is the empty string,
+ * which is what property_get() returns for an unset property.
+ */
+
+#include <libhexagonrpc/fastrpc.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "aee_error.h"
+#include "iobuffer.h"
+#include "listener.h"
+#include "sns_registry.h"
+#include "interfaces/sns_registry.def"
+
+struct sns_registry_ctx {
+	char *props_path;
+};
+
+static void lookup_property(const char *path, const char *name,
+			    char *value, size_t size)
+{
+	char line[512];
+	size_t n_name = strlen(name);
+	FILE *f;
+
+	value[0] = '\0';
+
+	f = fopen(path, "r");
+	if (f == NULL)
+		return;
+
+	while (fgets(line, sizeof(line), f) != NULL) {
+		char *end;
+
+		if (strncmp(line, name, n_name) || line[n_name] != '=')
+			continue;
+
+		end = line + strcspn(line, "\r\n");
+		*end = '\0';
+		strncpy(value, line + n_name + 1, size - 1);
+		value[size - 1] = '\0';
+		break;
+	}
+
+	fclose(f);
+}
+
+static uint32_t sns_registry_get_property(void *data,
+					  const struct fastrpc_io_buffer *inbufs,
+					  struct fastrpc_io_buffer *outbufs)
+{
+	struct sns_registry_ctx *ctx = data;
+	const char *name = inbufs[1].p;
+
+	if (inbufs[1].s == 0 || name[inbufs[1].s - 1] != 0)
+		return AEE_EBADPARM;
+
+	if (outbufs[0].s == 0)
+		return AEE_EBADPARM;
+
+	lookup_property(ctx->props_path, name, outbufs[0].p, outbufs[0].s);
+	fprintf(stderr, "sns_registry: property %s = \"%s\"\n",
+		name, (const char *) outbufs[0].p);
+
+	return 0;
+}
+
+static const struct fastrpc_function_impl sns_registry_procs[] = {
+	{
+		.def = &sns_registry_get_property_def,
+		.impl = sns_registry_get_property,
+	},
+};
+
+const struct fastrpc_interface sns_registry_interface = {
+	.name = "sns_registry",
+	.n_procs = 1,
+	.procs = sns_registry_procs,
+};
+
+struct fastrpc_interface *fastrpc_sns_registry_init(const char *props_path)
+{
+	struct fastrpc_interface *iface;
+	struct sns_registry_ctx *ctx;
+
+	iface = malloc(sizeof(struct fastrpc_interface));
+	if (iface == NULL)
+		return NULL;
+
+	ctx = malloc(sizeof(struct sns_registry_ctx));
+	if (ctx == NULL)
+		goto err_free_iface;
+
+	ctx->props_path = strdup(props_path);
+	if (ctx->props_path == NULL)
+		goto err_free_ctx;
+
+	memcpy(iface, &sns_registry_interface, sizeof(struct fastrpc_interface));
+	iface->data = ctx;
+
+	return iface;
+
+err_free_ctx:
+	free(ctx);
+err_free_iface:
+	free(iface);
+	return NULL;
+}
+
+void fastrpc_sns_registry_deinit(struct fastrpc_interface *iface)
+{
+	struct sns_registry_ctx *ctx = iface->data;
+
+	free(ctx->props_path);
+	free(ctx);
+	free(iface);
+}
