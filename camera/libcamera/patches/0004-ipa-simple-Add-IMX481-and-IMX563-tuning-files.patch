From 6c24abb58f539c72f41ecc900295a140f853fdfc Mon Sep 17 00:00:00 2001
From: Andy1210 <andy1210@gmail.com>
Date: Sun, 8 Nov 2026 07:49:10 +0100
Subject: [PATCH 4/6] ipa: simple: Add IMX481 and IMX563 tuning files

Start from the uncalibrated tuning with the sensors' black level, so the
black level is known from the first frame instead of being estimated
from the darkest pixels of the scene. No colour correction matrix yet.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/ipa/simple/data/imx481.yaml | 13 +++++++++++++
 src/ipa/simple/data/imx563.yaml | 13 +++++++++++++
 src/ipa/simple/data/meson.build |  2 ++
 3 files changed, 28 insertions(+)
 create mode 100644 src/ipa/simple/data/imx481.yaml
 create mode 100644 src/ipa/simple/data/imx563.yaml

diff --git a/src/ipa/simple/data/imx481.yaml b/src/ipa/simple/data/imx481.yaml
new file mode 100644
index 00000000..592b4974
--- /dev/null
+++ b/src/ipa/simple/data/imx481.yaml
@@ -0,0 +1,13 @@
+# SPDX-License-Identifier: CC0-1.0
+%YAML 1.1
+---
+version: 1
+algorithms:
+  - BlackLevel:
+      # 0x40 at 10 bits, measured on dark frames
+      blackLevel: 4096
+  - Awb:
+  # No colour correction matrix yet: not calibrated.
+  - Adjust:
+  - Agc:
+...
diff --git a/src/ipa/simple/data/imx563.yaml b/src/ipa/simple/data/imx563.yaml
new file mode 100644
index 00000000..592b4974
--- /dev/null
+++ b/src/ipa/simple/data/imx563.yaml
@@ -0,0 +1,13 @@
+# SPDX-License-Identifier: CC0-1.0
+%YAML 1.1
+---
+version: 1
+algorithms:
+  - BlackLevel:
+      # 0x40 at 10 bits, measured on dark frames
+      blackLevel: 4096
+  - Awb:
+  # No colour correction matrix yet: not calibrated.
+  - Adjust:
+  - Agc:
+...
diff --git a/src/ipa/simple/data/meson.build b/src/ipa/simple/data/meson.build
index 92795ee4..e9090c9b 100644
--- a/src/ipa/simple/data/meson.build
+++ b/src/ipa/simple/data/meson.build
@@ -1,6 +1,8 @@
 # SPDX-License-Identifier: CC0-1.0
 
 conf_files = files([
+    'imx481.yaml',
+    'imx563.yaml',
     'uncalibrated.yaml',
 ])
 
