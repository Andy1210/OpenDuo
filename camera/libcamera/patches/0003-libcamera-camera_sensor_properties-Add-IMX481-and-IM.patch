From d7edf2c76f68a988bf6e7c0f6149b99f83009383 Mon Sep 17 00:00:00 2001
From: Andy1210 <andy1210@gmail.com>
Date: Sun, 8 Nov 2026 07:48:54 +0100
Subject: [PATCH 3/6] libcamera: camera_sensor_properties: Add IMX481 and
 IMX563 properties

The IMX481 has 1.0um pixels (4656x3496, 1/3.06"), the IMX563 1.4um
pixels (4032x3024). Both drivers expose the MIPI CCS test patterns in
the standard order. Exposure and gain take effect two frames after they
are written, like on other Sony sensors with the CCS register layout.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../sensor/camera_sensor_properties.cpp       | 32 +++++++++++++++++++
 1 file changed, 32 insertions(+)

diff --git a/src/libcamera/sensor/camera_sensor_properties.cpp b/src/libcamera/sensor/camera_sensor_properties.cpp
index 28043150..8005dbbd 100644
--- a/src/libcamera/sensor/camera_sensor_properties.cpp
+++ b/src/libcamera/sensor/camera_sensor_properties.cpp
@@ -291,6 +291,22 @@ const CameraSensorProperties *CameraSensorProperties::get(const std::string &sen
 				.hblankDelay = 3
 			},
 		} },
+		{ "imx481", {
+			.unitCellSize = { 1000, 1000 },
+			.testPatternModes = {
+				{ controls::draft::TestPatternModeOff, 0 },
+				{ controls::draft::TestPatternModeSolidColor, 1 },
+				{ controls::draft::TestPatternModeColorBars, 2 },
+				{ controls::draft::TestPatternModeColorBarsFadeToGray, 3 },
+				{ controls::draft::TestPatternModePn9, 4 },
+			},
+			.sensorDelays = {
+				.exposureDelay = 2,
+				.gainDelay = 2,
+				.vblankDelay = 2,
+				.hblankDelay = 2
+			},
+		} },
 		{ "imx519", {
 			.unitCellSize = { 1220, 1220 },
 			.testPatternModes = {
@@ -309,6 +325,22 @@ const CameraSensorProperties *CameraSensorProperties::get(const std::string &sen
 				.hblankDelay = 3
 			},
 		} },
+		{ "imx563", {
+			.unitCellSize = { 1400, 1400 },
+			.testPatternModes = {
+				{ controls::draft::TestPatternModeOff, 0 },
+				{ controls::draft::TestPatternModeSolidColor, 1 },
+				{ controls::draft::TestPatternModeColorBars, 2 },
+				{ controls::draft::TestPatternModeColorBarsFadeToGray, 3 },
+				{ controls::draft::TestPatternModePn9, 4 },
+			},
+			.sensorDelays = {
+				.exposureDelay = 2,
+				.gainDelay = 2,
+				.vblankDelay = 2,
+				.hblankDelay = 2
+			},
+		} },
 		{ "imx678", {
 			.unitCellSize = { 2000, 2000 },
 			.testPatternModes = {},
