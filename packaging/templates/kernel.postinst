#!/bin/sh
# @PKG@: the modules' index, then the kernel on the ESP with its own boot
# entry, tried +3 times before the known-good one (duo2-boot, docs/UPDATES.md).
set -e
REL=@RELEASE@
case "$1" in
configure)
    depmod -a "$REL"
    if [ -x /usr/local/sbin/duo2-boot ]; then
        /usr/local/sbin/duo2-boot add "$REL"
    else
        echo "@PKG@: no duo2-boot (openduo-maint): $REL is not on the ESP" >&2
    fi
    touch /run/reboot-required 2>/dev/null || true
    echo "@PKG@" >>/run/reboot-required.pkgs 2>/dev/null || true
    ;;
esac
exit 0
