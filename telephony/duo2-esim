#!/usr/bin/python3 -I
"""duo2-esim: the built-in eUICC (the eSIM, physical slot 2) through lpac,
for Duo Settings' eSIM page. Run as root (sudo; Duo Settings' sudoers rule).

    duo2-esim info                      the chip: EID, free memory, versions (JSON)
    duo2-esim list                      the profiles (JSON; no icons)
    duo2-esim add CODE [CONFIRMATION]   download a profile by its activation code
                                        (LPA:1$<SM-DP+>$<matching id>)
    duo2-esim enable ICCID              switch to a profile
    duo2-esim disable ICCID
    duo2-esim rename ICCID NAME         its nickname (NAME empty: none)
    duo2-esim delete ICCID              deletes it from the chip: it is gone

Every change (add, enable, disable, rename, delete) is asked of the user in
the shell first (duo-wc's `confirm`, action `esim`, 45 s): any app of the
user can run this helper, so the question is what makes it the user's
decision; no answer is no. A change prints JSON {"ok": true} or {"ok":
false, "error": "...", "step": "...", "detail": "..."}: `error` says in
words what went wrong (no internet, what the operator's server answered, a
confirmation code missing...), `step` and `detail` are lpac's own (the
failing step and its reason, long digit runs masked). A download answers
{"ok": true, "profile": {...}} only once the new profile is in the chip's
list. While a change runs, lines {"progress": STEP} come first ("confirmed"
after the user's yes, lpac's own steps during a download, "checking"
before the list is read again): the answer is always the last line. The pending notifications for the operator (install / enable /
disable / delete) are then sent by lpac (`notification process -a -r`), as
a phone's LPA does. A download's steps and a failure's reason also go to
the system log (`journalctl -t duo2-esim`), without the code, the server or
any number that identifies the chip or a profile. lpac runs one at a time
(a lock in /run): the chip's QMI service takes one session at a time.

lpac (telephony/lpac/, built from source: Debian does not package it) talks
QMI over QRTR to the modem's UIM service: LPAC_APDU=qmi_qrtr,
LPAC_APDU_QMI_UIM_SLOT=2. The GUI's programs may not open QRTR sockets (a
seccomp filter on duo-wc.service and the user manager, inherited across
sudo: docs/hardware/security.md), so lpac does not run as this helper's child
but as a transient system service that systemd (PID 1) starts, without the
filter (systemd-run --pipe --wait: its output is ours, it ends with
RuntimeMaxSec at the latest). Only this helper decides what it runs: the
arguments are checked here first, as before. Testing without the chip: while root's
/etc/duo2/esim-fake exists, a fake lpac plays a chip with two profiles
(telephony/tests/fake_lpac.py, its state in /run/duo2-esim-fake.json).
Nothing here logs an EID or an ICCID.
"""

import fcntl
import json
import os
import re
import socket
import subprocess
import sys
import syslog

LPAC = "/usr/local/bin/lpac"
FAKE_SWITCH = "/etc/duo2/esim-fake"
FAKE_LPAC = "/usr/local/lib/duo2-telephony/fake_lpac.py"
WC_ADMIN = "/run/duo-wc/admin.sock"
CONFIRM_TIMEOUT_S = 50
LPAC_ENV = {"LPAC_APDU": "qmi_qrtr", "LPAC_APDU_QMI_UIM_SLOT": "2", "LPAC_HTTP": "curl"}
SYSTEMD_RUN = "/usr/bin/systemd-run"
# One lpac at a time: two at once (the page reads the chip's info and its
# list together) talk to the chip over one QMI UIM service, and one of
# them crashed (SIGSEGV) on the phone.
LOCK = "/run/duo2-esim.lock"
# lpac's service: QRTR (the modem), the network (curl to the SM-DP+, DNS),
# nothing it could write outside /run and /var.
UNIT_PROPERTIES = (
    "RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK AF_QIPCRTR",
    "NoNewPrivileges=yes",
    "ProtectSystem=full",
    "ProtectHome=yes",
    "PrivateTmp=yes",
)

ICCID = re.compile(r"^[0-9]{18,20}F?$")
# LPA:1$<SM-DP+ address>$<matching id>[$<OID>[$<1: confirmation code required>]]
ACTIVATION = re.compile(
    r"^(?:LPA:)?1\$([A-Za-z0-9.-]{1,253}(?::[0-9]{1,5})?)\$([A-Za-z0-9._-]{0,255})(?:\$[0-9.]*)?(?:\$1)?$"
)
CONFIRMATION = re.compile(r"^[A-Za-z0-9-]{1,64}$")


# -- pure ------------------------------------------------------------------------------


def valid_iccid(value):
    return bool(ICCID.match(value or ""))


def normalize_code(code):
    """An activation code as lpac takes it: no spaces around it, the
    scheme as "LPA:" (a QR code reader may give it in lower case, a typed
    code may leave it out)."""
    code = (code or "").strip()
    if code[:4].upper() == "LPA:":
        return "LPA:" + code[4:]
    return "LPA:" + code if code.startswith("1$") else code


def parse_activation(code):
    """(SM-DP+ address, matching id) of an activation code, or None."""
    m = ACTIVATION.match(normalize_code(code))
    return (m.group(1), m.group(2)) if m else None


def valid_nickname(name):
    return (
        name is not None
        and len(name) <= 64
        and all(c.isprintable() for c in name)
        and "\n" not in name
    )


def mask(value, keep=4):
    """An identifier as it may be shown or logged: its last digits only."""
    value = value or ""
    return ("•" * 4 + " " + value[-keep:]) if len(value) > keep else value


def lpac_lines(output):
    """lpac's JSON lines: (type, message, data) each, in order."""
    lines = []
    for line in (output or "").splitlines():
        line = line.strip()
        if not line.startswith("{"):
            continue
        try:
            obj = json.loads(line)
        except ValueError:
            continue
        if isinstance(obj, dict):
            p = obj.get("payload") or {}
            lines.append((obj.get("type"), p.get("message", ""), p.get("data"), p.get("code", -1)))
    return lines


def lpac_result(output):
    """The last {"type": "lpa"} line of lpac's output: (code, message, data)."""
    result = None
    for kind, message, data, code in lpac_lines(output):
        if kind == "lpa":
            result = (code, message, data)
    return result or (-1, "no answer from lpac", None)


def lpac_steps(output):
    """The steps a download went through (lpac's progress lines), in order."""
    return [m for kind, m, _d, _c in lpac_lines(output) if kind == "progress" and m]


def lpac_metadata(output):
    """What the operator's server said the profile is (the progress line
    lpac prints before it installs it), or {}."""
    for kind, message, data, _code in lpac_lines(output):
        if kind == "progress" and message == "es8p_meatadata_parse" and isinstance(data, dict):
            return data
    return {}


def mask_numbers(text):
    """Text that may be logged or shown: every run of 6 digits or more (an
    ICCID, an EID, an IMEI, a matching id's digits) cut to its last two."""
    return re.sub(r"[0-9]{6,}", lambda m: "…" + m.group()[-2:], str(text or ""))


NO_INTERNET = (
    "The operator's server could not be reached. The profile is downloaded over the "
    "internet: check that WiFi or mobile data really works (open a web page), then try again."
)
# lpac's failing step (its error's "message") -> what it means for the user.
STEP_TEXT = {
    "activation_code": "That is not a valid activation code.",
    "matching_id": "The activation code is not valid: its last part may have only letters, "
    "digits and dashes.",
    "confirmation_code": "This profile needs the confirmation code the operator gave with it. "
    "Type it in the second box.",
    "smdp": "The activation code does not name the operator's server.",
    "es10a_get_euicc_configured_addresses": "The eSIM chip did not answer.",
    "es10b_get_euicc_challenge_and_info": "The eSIM chip did not answer.",
    "es10b_authenticate_server": "The eSIM chip did not accept the operator's server.",
    "es8p_meatadata_parse": "The operator's server described the profile in a way that could "
    "not be read.",
    "es10b_prepare_download": "The eSIM chip did not take the download (a wrong confirmation "
    "code?).",
    "cancelled": "The download was cancelled.",
}
# es10b_load_bound_profile_package's reasons (lpac prints them by name).
INSTALL_TEXT = {
    "installFailedDueToIccidAlreadyExistsOnEuicc": "This profile is on the chip already.",
    "installFailedDueToInsufficientMemoryForProfile": "There is not enough free memory on the "
    "eSIM chip: delete a profile you do not need and try again.",
    "incorrectInputValues": "The operator's server sent a profile the chip could not take.",
    "invalidSignature": "The operator's server sent a profile the chip could not take.",
}


def explain(step, detail):
    """lpac's failure (the step and its detail) in words for the user."""
    step, detail = step or "", detail or ""
    if step.startswith("es9p_"):
        if detail in ("HTTP transport failed", ""):
            return NO_INTERNET
        if detail == "HTTP status code error":
            return "The operator's server answered with an error. Try again later."
        return (
            "The operator's server refused the download: “%s”. Ask the operator about it: "
            "an activation code usually works only once." % mask_numbers(detail)
        )
    if step == "es10b_load_bound_profile_package":
        reason = detail.split(",")[-1]
        return INSTALL_TEXT.get(
            reason,
            "The eSIM chip did not install the profile (%s)." % (reason or "no reason given"),
        )
    if step in STEP_TEXT:
        return STEP_TEXT[step]
    return "It did not work (%s)." % (step or "no answer from lpac")


def log(text):
    """A line in the system log (journalctl -t duo2-esim); never an
    identifier: the callers pass only steps and masked reasons."""
    try:
        syslog.openlog("duo2-esim", 0, syslog.LOG_USER)
        syslog.syslog(syslog.LOG_INFO, mask_numbers(text))
    except OSError:
        pass


def profiles(data):
    """lpac's profile list, without the icons, in a stable order."""
    out = []
    for p in data or []:
        out.append(
            {
                "iccid": p.get("iccid") or "",
                "name": p.get("profileName") or "",
                "nickname": p.get("profileNickname") or "",
                "provider": p.get("serviceProviderName") or "",
                "state": p.get("profileState") or "",
                "class": p.get("profileClass") or "",
            }
        )
    return out


def chip(data):
    data = data or {}
    info2 = data.get("EUICCInfo2") or {}
    addrs = data.get("EuiccConfiguredAddresses") or {}
    return {
        "eid": data.get("eidValue") or "",
        "default_smdp": addrs.get("defaultDpAddress") or "",
        "free_bytes": (info2.get("extCardResource") or {}).get("freeNonVolatileMemory"),
        "sgp22": info2.get("svn") or "",
        "firmware": info2.get("euiccFirmwareVer") or "",
    }


def describe(action, args, names):
    """The question's text: what will happen (names: ICCID -> profile name)."""

    def name(iccid):
        return names.get(iccid) or ("the profile ending in %s" % iccid[-4:])

    if action == "add":
        smdp = (parse_activation(args[0]) or (args[0], ""))[0]
        return "Download an eSIM profile from %s and install it." % smdp
    if action == "enable":
        return "Switch to the eSIM profile “%s”. The SIM in use now is switched off." % name(
            args[0]
        )
    if action == "disable":
        return (
            "Switch off the eSIM profile “%s”. Its number stops working until it is switched on."
            % name(args[0])
        )
    if action == "rename":
        return "Rename the eSIM profile “%s” to “%s”." % (name(args[0]), args[1])
    if action == "delete":
        return (
            "Delete the eSIM profile “%s”. It is removed from the phone for good: to use "
            "it again you need a new code from the operator." % name(args[0])
        )
    return action


# -- doing -------------------------------------------------------------------------------

_units = [0]


def unit_argv(argv, env, timeout, name):
    """argv as a transient system service `name` that systemd starts (not a
    child of ours: that one would inherit the GUI's QRTR filter), with env
    set in it, our stdin / stdout / stderr, and at most `timeout` seconds.
    Pure."""
    cmd = [
        SYSTEMD_RUN,
        "--quiet",
        "--pipe",
        "--wait",
        "--collect",
        "--service-type=exec",
        "--unit=" + name,
        "--description=duo2-esim: lpac",
        "--property=RuntimeMaxSec=%d" % timeout,
    ]
    cmd += ["--property=" + p for p in UNIT_PROPERTIES]
    cmd += ["--setenv=%s=%s" % kv for kv in sorted(env.items())]
    return cmd + ["--"] + list(argv)


def lpac_argv(env, timeout):
    """The command line that runs lpac (or, while FAKE_SWITCH exists, the
    fake) in its own service. The tests replace this with the bare fake."""
    _units[0] += 1
    real = [sys.executable, "-I", FAKE_LPAC] if os.path.exists(FAKE_SWITCH) else [LPAC]
    return unit_argv(real, env, timeout, "duo2-esim-lpac-%d-%d" % (os.getpid(), _units[0]))


def lpac_run(*args, timeout=180, on_step=None):
    """lpac's output for args: (its JSON lines, "") or ("", why it did not
    run). on_step(step) is called for each progress line as lpac prints it
    (lpac flushes every line; systemd-run --pipe passes them on)."""
    env = {"PATH": "/usr/sbin:/usr/bin:/sbin:/bin", **LPAC_ENV}
    if "FAKE_LPAC_STATE" in os.environ:  # the tests' fake (sudo drops it)
        env["FAKE_LPAC_STATE"] = os.environ["FAKE_LPAC_STATE"]
    lines = []
    try:
        with open(LOCK, "a") as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            with subprocess.Popen(
                lpac_argv(env, timeout) + list(args),
                stdin=subprocess.DEVNULL,
                stdout=subprocess.PIPE,
                stderr=subprocess.DEVNULL,
                text=True,
                env=env,
            ) as proc:
                # The unit's RuntimeMaxSec ends lpac (and with it this pipe)
                # in time; the wait below is the second guard.
                for line in proc.stdout:
                    lines.append(line)
                    if on_step is not None:
                        for kind, step, _data, _code in lpac_lines(line):
                            if kind == "progress" and step:
                                on_step(step)
                proc.wait(timeout=timeout + 15)
    except (OSError, subprocess.TimeoutExpired) as e:
        return "", str(e) or "lpac did not answer in time"
    return "".join(lines), ""


def lpac(*args, timeout=180):
    text, err = lpac_run(*args, timeout=timeout)
    return (-1, err, None) if err else lpac_result(text)


def confirm(detail):
    """Ask the user in the shell (duo-wc's confirm): True only on a yes."""
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
            s.settimeout(CONFIRM_TIMEOUT_S)
            s.connect(WC_ADMIN)
            s.sendall(
                (
                    json.dumps(
                        {
                            "id": 1,
                            "request": "confirm",
                            "action": "esim",
                            "detail": detail,
                            "wait": True,
                        }
                    )
                    + "\n"
                ).encode()
            )
            buf = b""
            while b"\n" not in buf:
                chunk = s.recv(4096)
                if not chunk:
                    break
                buf += chunk
        reply = json.loads(buf.split(b"\n")[0] or b"{}")
    except (OSError, ValueError):
        return False
    return (reply.get("ok") or {}).get("yes") is True


def names_now():
    code, _msg, data = lpac("profile", "list")
    if code != 0:
        return {}
    return {p["iccid"]: (p["nickname"] or p["name"] or p["provider"]) for p in profiles(data)}


def progress(step):
    """A line for the page while a change runs ({"progress": step}: lpac's
    step, or "confirmed" / "checking"); the answer stays the last line."""
    print(json.dumps({"progress": step}), flush=True)


def out(obj):
    print(json.dumps(obj))
    return 0 if obj.get("ok", True) else 1


def download(code, confirmation):
    """Download a profile; {"ok": true, "profile": ...} only when the chip
    lists it afterwards (lpac's word alone is not taken for it)."""
    code_now, _msg, data = lpac("profile", "list")
    before = {p["iccid"] for p in profiles(data)} if code_now == 0 else set()
    argv = ["profile", "download", "-a", code]
    if confirmation:
        argv += ["-c", confirmation]
    text, err = lpac_run(*argv, timeout=300, on_step=progress)
    if err:
        log("download: lpac did not run: %s" % err)
        return out({"ok": False, "error": "lpac did not run: %s" % err, "step": "", "detail": ""})
    log("download: steps " + " > ".join(lpac_steps(text) or ["none"]))
    result, step, detail = lpac_result(text)
    if result != 0:
        detail = detail if isinstance(detail, str) else ""
        log("download failed at %s: %s" % (step, mask_numbers(detail) or "no reason given"))
        return out(
            {
                "ok": False,
                "error": explain(step, detail),
                "step": step,
                "detail": mask_numbers(detail),
            }
        )
    meta = lpac_metadata(text)
    progress("checking")
    code_now, _msg, data = lpac("profile", "list")
    now = profiles(data) if code_now == 0 else []
    new = [p for p in now if p["iccid"] not in before]
    got = next((p for p in now if meta.get("iccid") and p["iccid"] == meta.get("iccid")), None)
    got = got or (new[0] if len(new) == 1 else None)
    if got is None:
        log(
            "download: lpac said done, but no new profile is listed (%d before, %d now)"
            % (len(before), len(now))
        )
        return out(
            {
                "ok": False,
                "error": "The download was reported done, but the profile is not on the chip. "
                "Try again; if it still fails, ask the operator for a new code.",
                "step": "profile list",
                "detail": "%d profiles before, %d now" % (len(before), len(now)),
            }
        )
    log("download: done, the chip lists the new profile")
    lpac("notification", "process", "-a", "-r", timeout=120)
    return out({"ok": True, "profile": got})


def change(action, args):
    detail = describe(action, args, names_now() if action != "add" else {})
    if not confirm(detail):
        return out({"ok": False, "error": "not confirmed"})
    progress("confirmed")
    if action == "add":
        return download(args[0], args[1] if len(args) > 1 else "")
    if action == "rename":
        code, msg, _ = lpac("profile", "nickname", args[0], args[1])
    else:
        code, msg, _ = lpac("profile", action, args[0])
    if code != 0:
        return out({"ok": False, "error": msg or "failed"})
    if action in ("enable", "disable", "delete"):
        # The operator is told (as a phone's LPA does); a failure here is
        # not the user's: the chip keeps the notification for later.
        lpac("notification", "process", "-a", "-r", timeout=120)
    return out({"ok": True})


def main(argv):
    n = len(argv)
    if argv == ["info"]:
        code, msg, data = lpac("chip", "info")
        return out({"ok": code == 0, "error": msg, **(chip(data) if code == 0 else {})})
    if argv == ["list"]:
        code, msg, data = lpac("profile", "list")
        return out({"ok": code == 0, "error": msg, "profiles": profiles(data) if code == 0 else []})
    if (
        n in (2, 3)
        and argv[0] == "add"
        and parse_activation(argv[1])
        and (n == 2 or not argv[2] or CONFIRMATION.match(argv[2]))
    ):
        return change("add", [normalize_code(argv[1])] + argv[2:])
    if n == 2 and argv[0] in ("enable", "disable", "delete") and valid_iccid(argv[1]):
        return change(argv[0], [argv[1]])
    if n == 3 and argv[0] == "rename" and valid_iccid(argv[1]) and valid_nickname(argv[2]):
        return change("rename", argv[1:])
    print(__doc__.strip(), file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
