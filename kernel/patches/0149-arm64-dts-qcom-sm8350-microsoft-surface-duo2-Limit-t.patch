From 98ab3693e127012f943db69778250faf95888543 Mon Sep 17 00:00:00 2001
From: Andy1210 <andy1210@gmail.com>
Date: Thu, 19 Nov 2026 11:21:54 +0100
Subject: [PATCH 149/149] arm64: dts: qcom: sm8350-microsoft-surface-duo2:
 Limit the WLAN link to Gen2

The stock kernel's cnss2 driver keeps the WCN6855's PCIe link at 5 GT/s.
Trained at 8 GT/s, the link reported receiver errors and completion
timeouts, after which the WLAN firmware crashed (MHI RDDM) or stopped
answering, and the recovery failed while the link stayed bad.

Assisted-by: Claude:claude-opus-5-5
---
 arch/arm64/boot/dts/qcom/sm8350-microsoft-surface-duo2.dts | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/sm8350-microsoft-surface-duo2.dts b/arch/arm64/boot/dts/qcom/sm8350-microsoft-surface-duo2.dts
index ac4af52c6963..71898b0c860f 100644
--- a/arch/arm64/boot/dts/qcom/sm8350-microsoft-surface-duo2.dts
+++ b/arch/arm64/boot/dts/qcom/sm8350-microsoft-surface-duo2.dts
@@ -1032,6 +1032,13 @@ &pcie0 {
 	pinctrl-0 = <&pcie0_default_state>;
 	pinctrl-names = "default";
 
+	/*
+	 * The stock kernel (cnss2) keeps the WCN6855's link at Gen2. At Gen3
+	 * the link reports receiver errors and completion timeouts, and the
+	 * WLAN firmware crashes or stops answering after a while.
+	 */
+	max-link-speed = <2>;
+
 	perst-gpios = <&tlmm 94 GPIO_ACTIVE_LOW>;
 	wake-gpios = <&tlmm 96 GPIO_ACTIVE_HIGH>;
 
