+static int imx48x_parse_endpoint(struct imx48x *sensor)
+{
+	struct v4l2_fwnode_endpoint ep = { .bus_type = V4L2_MBUS_CSI2_DPHY };
+	struct fwnode_handle *node;
+	unsigned int i;
+	int ret;
+
+	node = fwnode_graph_get_next_endpoint(dev_fwnode(sensor->dev), NULL);
+	if (!node)
+		return dev_err_probe(sensor->dev, -ENODEV, "no endpoint\n");
+
+	ret = v4l2_fwnode_endpoint_alloc_parse(node, &ep);
+	fwnode_handle_put(node);
+	if (ret)
+		return dev_err_probe(sensor->dev, ret, "endpoint\n");
+
+	sensor->lanes = ep.bus.mipi_csi2.num_data_lanes;
+	sensor->num_link_freqs = min_t(unsigned int, ep.nr_of_link_frequencies,
+				       IMX48X_MAX_MODES);
+	for (i = 0; i < sensor->num_link_freqs; i++)
+		sensor->link_freqs[i] = ep.link_frequencies[i];
+
+	v4l2_fwnode_endpoint_free(&ep);
+
+	if (!sensor->num_link_freqs)
+		return dev_err_probe(sensor->dev, -EINVAL, "no link-frequencies\n");
+
+	return 0;
+}
+
+static int imx48x_identify(struct imx48x *sensor)
+{
+	u64 model = 0, revision = 0;
+	int ret;
+
+	ret = cci_read(sensor->regmap, IMX48X_REG_MODEL_ID, &model, NULL);
+	cci_read(sensor->regmap, IMX48X_REG_REVISION, &revision, &ret);
+	if (ret)
+		return dev_err_probe(sensor->dev, ret, "no answer\n");
+
+	if (model != sensor->variant->model)
+		return dev_err_probe(sensor->dev, -ENODEV,
+				     "model 0x%04llx, not the %s's 0x%04x\n",
+				     model, sensor->variant->name,
+				     sensor->variant->model);
+
+	dev_info(sensor->dev, "Sony %s, revision 0x%02llx\n",
+		 sensor->variant->name, revision);
+
+	return 0;
+}
