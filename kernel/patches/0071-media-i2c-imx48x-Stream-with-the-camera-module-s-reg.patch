+/* -----------------------------------------------------------------------------
+ * Subdev operations
+ */
+
+static void imx48x_fill_format(const struct imx48x_mode *mode,
+			       struct v4l2_mbus_framefmt *fmt)
+{
+	fmt->code = MEDIA_BUS_FMT_SRGGB10_1X10;
+	fmt->width = mode->width;
+	fmt->height = mode->height;
+	fmt->field = V4L2_FIELD_NONE;
+	fmt->colorspace = V4L2_COLORSPACE_RAW;
+	fmt->ycbcr_enc = V4L2_YCBCR_ENC_601;
+	fmt->quantization = V4L2_QUANTIZATION_FULL_RANGE;
+	fmt->xfer_func = V4L2_XFER_FUNC_NONE;
+}
+
+static int imx48x_enable_streams(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state, u32 pad,
+				 u64 streams_mask)
+{
+	struct imx48x *sensor = to_imx48x(sd);
+	const struct v4l2_mbus_framefmt *fmt = v4l2_subdev_state_get_format(state, 0);
+	const struct imx48x_mode *mode = imx48x_find_mode(sensor, fmt->width, fmt->height);
+	int ret;
+
+	ret = pm_runtime_resume_and_get(sensor->dev);
+	if (ret < 0)
+		return ret;
+
+	ret = imx48x_write_table(sensor, sensor->init_regs, sensor->num_init_regs);
+	if (ret) {
+		dev_err(sensor->dev, "initial settings: %d\n", ret);
+		goto err_pm;
+	}
+
+	ret = imx48x_write_table(sensor, mode->regs, mode->num_regs);
+	if (ret) {
+		dev_err(sensor->dev, "mode %ux%u: %d\n", mode->width, mode->height, ret);
+		goto err_pm;
+	}
+
+	ret = __v4l2_ctrl_handler_setup(sensor->sd.ctrl_handler);
+	if (ret)
+		goto err_pm;
+
+	ret = cci_write(sensor->regmap, IMX48X_REG_MODE_SELECT,
+			IMX48X_MODE_STREAMING, NULL);
+	if (ret)
+		goto err_pm;
+
+	return 0;
+
+err_pm:
+	pm_runtime_put_autosuspend(sensor->dev);
+	return ret;
+}
+
+static int imx48x_disable_streams(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state, u32 pad,
+				  u64 streams_mask)
+{
+	struct imx48x *sensor = to_imx48x(sd);
+	int ret;
+
+	ret = cci_write(sensor->regmap, IMX48X_REG_MODE_SELECT,
+			IMX48X_MODE_STANDBY, NULL);
+	if (ret)
+		dev_err(sensor->dev, "standby: %d\n", ret);
+
+	pm_runtime_put_autosuspend(sensor->dev);
+
+	return ret;
+}
+
+static int imx48x_enum_mbus_code(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state,
+				 struct v4l2_subdev_mbus_code_enum *code)
+{
+	if (code->index)
+		return -EINVAL;
+
+	code->code = MEDIA_BUS_FMT_SRGGB10_1X10;
+
+	return 0;
+}
+
+static int imx48x_enum_frame_size(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state,
+				  struct v4l2_subdev_frame_size_enum *fse)
+{
+	struct imx48x *sensor = to_imx48x(sd);
+
+	if (fse->code != MEDIA_BUS_FMT_SRGGB10_1X10 ||
+	    fse->index >= sensor->num_modes)
+		return -EINVAL;
+
+	fse->min_width = sensor->modes[fse->index].width;
+	fse->max_width = fse->min_width;
+	fse->min_height = sensor->modes[fse->index].height;
+	fse->max_height = fse->min_height;
+
+	return 0;
+}
+
+static int imx48x_set_pad_format(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state,
+				 struct v4l2_subdev_format *fmt)
+{
+	struct imx48x *sensor = to_imx48x(sd);
+	const struct imx48x_mode *mode;
+	u32 fll;
+	int ret;
+
+	mode = imx48x_find_mode(sensor, fmt->format.width, fmt->format.height);
+	imx48x_fill_format(mode, &fmt->format);
+	*v4l2_subdev_state_get_format(state, 0) = fmt->format;
+	*v4l2_subdev_state_get_crop(state, 0) = mode->crop;
+
+	if (fmt->which != V4L2_SUBDEV_FORMAT_ACTIVE)
+		return 0;
+
+	fll = imx48x_default_fll(mode);
+
+	ret = __v4l2_ctrl_modify_range(sensor->vblank, mode->fll - mode->height,
+				       IMX48X_FRAME_LENGTH_MAX - mode->height, 1,
+				       fll - mode->height);
+	if (!ret)
+		ret = __v4l2_ctrl_s_ctrl(sensor->vblank, fll - mode->height);
+	if (!ret)
+		ret = __v4l2_ctrl_modify_range(sensor->hblank,
+					       mode->llp - mode->width,
+					       mode->llp - mode->width, 1,
+					       mode->llp - mode->width);
+	if (!ret)
+		ret = __v4l2_ctrl_modify_range(sensor->pixel_rate, mode->pixel_rate,
+					       mode->pixel_rate, 1, mode->pixel_rate);
+	if (!ret)
+		ret = __v4l2_ctrl_s_ctrl(sensor->link_freq, mode->link_freq_index);
+
+	return ret;
+}
+
+static int imx48x_get_selection(struct v4l2_subdev *sd,
+				struct v4l2_subdev_state *state,
+				struct v4l2_subdev_selection *sel)
+{
+	struct imx48x *sensor = to_imx48x(sd);
+
+	switch (sel->target) {
+	case V4L2_SEL_TGT_CROP:
+		sel->r = *v4l2_subdev_state_get_crop(state, 0);
+		return 0;
+	case V4L2_SEL_TGT_NATIVE_SIZE:
+	case V4L2_SEL_TGT_CROP_DEFAULT:
+	case V4L2_SEL_TGT_CROP_BOUNDS:
+		sel->r = sensor->native;
+		return 0;
+	}
+
+	return -EINVAL;
+}
+
+static int imx48x_init_state(struct v4l2_subdev *sd,
+			     struct v4l2_subdev_state *state)
+{
+	struct imx48x *sensor = to_imx48x(sd);
+	struct v4l2_subdev_format fmt = {
+		.which = V4L2_SUBDEV_FORMAT_TRY,
+		.pad = 0,
+		.format = {
+			.width = sensor->modes[0].width,
+			.height = sensor->modes[0].height,
+		},
+	};
+
+	return imx48x_set_pad_format(sd, state, &fmt);
+}
