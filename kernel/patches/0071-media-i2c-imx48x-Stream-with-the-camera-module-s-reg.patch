From 00ae5fa4e563debcc934798ab84cc47b82d6c5a2 Mon Sep 17 00:00:00 2001
From: Andy1210 <andy1210@gmail.com>
Date: Sun, 8 Nov 2026 00:50:40 +0100
Subject: [PATCH 071/149] media: i2c: imx48x: Stream with the camera module's
 register tables

Turn the identification driver into a V4L2 sensor driver. The IMX481 and
IMX563 use Sony's CCS-style register layout, which the driver programs
(format, frame length, exposure, analogue and digital gain, test
pattern); the settings a mode needs beyond the standard registers are
the module maker's register tables, which the driver loads as firmware
(the DT's firmware-name, a simple documented layout): an initial list and
one list per mode. The modes' sizes, crop, lanes, frame timing, link
frequency and pixel rate are read from the standard registers of the
tables; modes the endpoint's lanes and link frequencies cannot carry are
dropped.

No binding yet.

Assisted-by: Claude:claude-opus-5-5
---
 drivers/media/i2c/Kconfig  |   8 +-
 drivers/media/i2c/imx48x.c | 954 +++++++++++++++++++++++++++++++++++--
 2 files changed, 915 insertions(+), 47 deletions(-)

diff --git a/drivers/media/i2c/Kconfig b/drivers/media/i2c/Kconfig
index f0aa4bf4bd55..8653b71d1aca 100644
--- a/drivers/media/i2c/Kconfig
+++ b/drivers/media/i2c/Kconfig
@@ -290,13 +290,13 @@ config VIDEO_IMX415
 	  module will be called imx415.
 
 config VIDEO_IMX48X
-	tristate "Sony IMX481 and IMX563 sensors (power and identification only)"
+	tristate "Sony IMX481 and IMX563 sensor support"
 	depends on OF
 	select V4L2_CCI_I2C
 	help
-	  Bring-up driver for the Sony IMX481 and IMX563 camera sensors of
-	  the Surface Duo 2: it powers a sensor up, reads its model number
-	  and powers it down. It does not stream.
+	  This is a Video4Linux2 sensor driver for the Sony IMX481 and
+	  IMX563 camera sensors. A camera module's register tables are
+	  loaded as firmware.
 
 	  To compile this driver as a module, choose M here: the
 	  module will be called imx48x.
diff --git a/drivers/media/i2c/imx48x.c b/drivers/media/i2c/imx48x.c
index 0e6371daeb3c..7b7dc9c4b454 100644
--- a/drivers/media/i2c/imx48x.c
+++ b/drivers/media/i2c/imx48x.c
@@ -1,48 +1,125 @@
 // SPDX-License-Identifier: GPL-2.0-only
 /*
- * Sony IMX481 and IMX563 camera sensors: power and identification.
+ * Sony IMX481 and IMX563 image sensors
  *
- * BRING-UP ONLY (Surface Duo 2): the sensor is powered up in its module's
- * order, its model number read over the camera control interface and the
- * sensor powered down again. There is no V4L2 subdevice yet: streaming
- * needs the vendor's initialisation, which is not in the kernel.
+ * Both sensors follow Sony's SMIA++ / CCS-style register layout: the output
+ * format, lane count, PLLs, frame and line length, crop, binning and output
+ * size, exposure, gains and the test pattern are standard registers. What a
+ * mode needs beyond those (the analogue timing and readout settings of the
+ * pixel array) is not documented: the camera module maker provides it as
+ * register tables for each module. The driver loads them from a firmware
+ * file, so a module's own tables are used unchanged, and programs the
+ * standard controls over them.
  *
- * The power sequence is the one the Surface Duo 2's camera module
- * descriptions give (all four modules, 19.2 MHz MCLK): the I/O supply, the
- * analogue supply, (IMX563: its second 1.8 V supply,) the digital supply,
- * 1 ms apart, then MCLK, then XCLR released 1 ms later; the sensor answers
- * after 9 ms (IMX563: 11 ms). Off in the opposite order: XCLR, MCLK, the
- * supplies.
+ * Firmware file layout (little endian):
  *
- * Both sensors keep their model number in the 16-bit register 0x0016
- * (Sony's standard layout, 16-bit register addresses).
+ *	struct imx48x_fw_header		magic "IMX48XT1", model, number of lists
+ *	then the lists, each:
+ *	  struct imx48x_fw_list		type, number of registers
+ *	  struct imx48x_fw_reg[]	16-bit address, 8-bit value, delay (ms)
+ *
+ * One list of type INIT (written after every power-up, before a mode) and
+ * one list of type MODE per sensor mode. A mode list is the complete
+ * register setting of the mode, standard registers included: the driver
+ * reads the mode's output size, crop, lanes, frame timing and PLL settings
+ * from it, and applies its exposure, gains, frame length and test pattern
+ * after it.
  */
 
 #include <linux/clk.h>
 #include <linux/delay.h>
+#include <linux/firmware.h>
 #include <linux/gpio/consumer.h>
 #include <linux/i2c.h>
 #include <linux/module.h>
 #include <linux/of.h>
+#include <linux/pm_runtime.h>
 #include <linux/regulator/consumer.h>
 
 #include <media/v4l2-cci.h>
+#include <media/v4l2-ctrls.h>
+#include <media/v4l2-device.h>
+#include <media/v4l2-fwnode.h>
+#include <media/v4l2-mediabus.h>
+#include <media/v4l2-subdev.h>
 
 #define IMX48X_REG_MODEL_ID		CCI_REG16(0x0016)
 #define IMX48X_REG_REVISION		CCI_REG8(0x0018)
+#define IMX48X_REG_MODE_SELECT		CCI_REG8(0x0100)
+#define   IMX48X_MODE_STANDBY			0x00
+#define   IMX48X_MODE_STREAMING			0x01
+#define IMX48X_REG_EXPOSURE		CCI_REG16(0x0202)
+#define IMX48X_REG_ANALOG_GAIN		CCI_REG16(0x0204)
+#define IMX48X_REG_DIGITAL_GAIN		CCI_REG16(0x020e)
+#define IMX48X_REG_FRAME_LENGTH		CCI_REG16(0x0340)
+#define IMX48X_REG_TEST_PATTERN		CCI_REG16(0x0600)
+
+/* the standard registers a mode table is read for (8-bit halves) */
+#define IMX48X_CSI_DATA_FORMAT		0x0112
+#define IMX48X_CSI_LANE_MODE		0x0114
+#define IMX48X_VT_PIX_CLK_DIV		0x0301
+#define IMX48X_VT_SYS_CLK_DIV		0x0303
+#define IMX48X_PRE_PLL_CLK_DIV		0x0305
+#define IMX48X_PLL_MULTIPLIER		0x0306
+#define IMX48X_OP_SYS_CLK_DIV		0x030b
+#define IMX48X_OP_PRE_PLL_CLK_DIV	0x030d
+#define IMX48X_OP_PLL_MULTIPLIER	0x030e
+#define IMX48X_FRAME_LENGTH_LINES	0x0340
+#define IMX48X_LINE_LENGTH_PCK		0x0342
+#define IMX48X_X_ADDR_START		0x0344
+#define IMX48X_Y_ADDR_START		0x0346
+#define IMX48X_X_ADDR_END		0x0348
+#define IMX48X_Y_ADDR_END		0x034a
+#define IMX48X_X_OUTPUT_SIZE		0x034c
+#define IMX48X_Y_OUTPUT_SIZE		0x034e
+
 #define IMX48X_MCLK_RATE		19200000
+#define IMX48X_FRAME_LENGTH_MAX		0xffff
+#define IMX48X_EXPOSURE_MIN		1
+#define IMX48X_EXPOSURE_OFFSET		48
+#define IMX48X_ANA_GAIN_MIN		0
+#define IMX48X_ANA_GAIN_MAX		960	/* 16x: gain = 1024 / (1024 - code) */
+#define IMX48X_DGTL_GAIN_MIN		0x0100
+#define IMX48X_DGTL_GAIN_MAX		0x0fff
+#define IMX48X_DGTL_GAIN_DEFAULT	0x0100
+#define IMX48X_DEFAULT_FPS		30
+
+#define IMX48X_FW_MAGIC			"IMX48XT1"
+#define IMX48X_FW_LIST_INIT		1
+#define IMX48X_FW_LIST_MODE		2
+#define IMX48X_MAX_MODES		16
+
+struct imx48x_fw_header {
+	u8 magic[8];
+	__le16 model;
+	__le16 num_lists;
+	__le32 reserved;
+} __packed;
+
+struct imx48x_fw_list {
+	__le16 type;
+	__le16 num_regs;
+} __packed;
+
+struct imx48x_fw_reg {
+	__le16 addr;
+	u8 val;
+	u8 delay_ms;
+} __packed;
 
 struct imx48x_variant {
 	const char *name;
 	u16 model;
 	bool vcustom;			/* the IMX563's second 1.8 V supply */
 	unsigned int settle_ms;		/* from XCLR released to the first access */
+	const char *firmware;		/* the tables' default file name */
 };
 
 static const struct imx48x_variant imx481_variant = {
 	.name = "IMX481",
 	.model = 0x0481,
 	.settle_ms = 9,
+	.firmware = "imx481.bin",
 };
 
 static const struct imx48x_variant imx563_variant = {
@@ -50,10 +127,27 @@ static const struct imx48x_variant imx563_variant = {
 	.model = 0x0563,
 	.vcustom = true,
 	.settle_ms = 11,
+	.firmware = "imx563.bin",
+};
+
+struct imx48x_mode {
+	const struct imx48x_fw_reg *regs;
+	unsigned int num_regs;
+	u32 width;
+	u32 height;
+	struct v4l2_rect crop;
+	u32 llp;			/* line length, pixel clocks */
+	u32 fll;			/* the table's frame length: its fastest */
+	u32 lanes;
+	s64 link_freq;
+	u64 pixel_rate;
+	unsigned int link_freq_index;
 };
 
 struct imx48x {
 	struct device *dev;
+	struct v4l2_subdev sd;
+	struct media_pad pad;
 	const struct imx48x_variant *variant;
 	struct regmap *regmap;
 	struct clk *mclk;
@@ -62,10 +156,650 @@ struct imx48x {
 	struct regulator *avdd;
 	struct regulator *vcustom;
 	struct regulator *dvdd;
+
+	const struct firmware *fw;
+	const struct imx48x_fw_reg *init_regs;
+	unsigned int num_init_regs;
+	struct imx48x_mode modes[IMX48X_MAX_MODES];
+	unsigned int num_modes;
+	struct v4l2_rect native;
+
+	s64 link_freqs[IMX48X_MAX_MODES];
+	unsigned int num_link_freqs;
+	u32 lanes;
+
+	struct v4l2_ctrl_handler ctrls;
+	struct v4l2_ctrl *pixel_rate;
+	struct v4l2_ctrl *link_freq;
+	struct v4l2_ctrl *vblank;
+	struct v4l2_ctrl *hblank;
+	struct v4l2_ctrl *exposure;
+};
+
+static const char * const imx48x_test_pattern_menu[] = {
+	"Disabled",
+	"Solid Colour",
+	"Colour Bars",
+	"Colour Bars With Fade to Grey",
+	"Pseudorandom Sequence (PN9)",
+};
+
+/* the standard (CCS) test pattern codes, in the order of the menu */
+static const u16 imx48x_test_pattern_val[] = { 0, 1, 2, 3, 4 };
+
+static inline struct imx48x *to_imx48x(struct v4l2_subdev *sd)
+{
+	return container_of(sd, struct imx48x, sd);
+}
+
+static const struct imx48x_mode *imx48x_find_mode(struct imx48x *sensor,
+						  u32 width, u32 height)
+{
+	const struct imx48x_mode *best = &sensor->modes[0];
+	u32 best_err = U32_MAX;
+	unsigned int i;
+
+	for (i = 0; i < sensor->num_modes; i++) {
+		const struct imx48x_mode *m = &sensor->modes[i];
+		u32 err = abs((s32)m->width - (s32)width) +
+			  abs((s32)m->height - (s32)height);
+
+		if (err < best_err) {
+			best = m;
+			best_err = err;
+		}
+	}
+
+	return best;
+}
+
+/* the frame length for the default frame rate, no shorter than the table's */
+static u32 imx48x_default_fll(const struct imx48x_mode *mode)
+{
+	u64 fll = div_u64(mode->pixel_rate, mode->llp * IMX48X_DEFAULT_FPS);
+
+	return clamp_t(u64, fll, mode->fll, IMX48X_FRAME_LENGTH_MAX);
+}
+
+/* -----------------------------------------------------------------------------
+ * Register tables
+ */
+
+static int imx48x_write_table(struct imx48x *sensor,
+			      const struct imx48x_fw_reg *regs, unsigned int n)
+{
+	unsigned int i;
+	int ret = 0;
+
+	for (i = 0; i < n && !ret; i++) {
+		cci_write(sensor->regmap, CCI_REG8(le16_to_cpu(regs[i].addr)),
+			  regs[i].val, &ret);
+		if (regs[i].delay_ms)
+			msleep(regs[i].delay_ms);
+	}
+
+	return ret;
+}
+
+/* the last value a table writes to an 8-bit register, -1 if it writes none */
+static int imx48x_table_reg(const struct imx48x_fw_reg *regs, unsigned int n,
+			    u16 addr)
+{
+	int val = -1;
+	unsigned int i;
+
+	for (i = 0; i < n; i++)
+		if (le16_to_cpu(regs[i].addr) == addr)
+			val = regs[i].val;
+
+	return val;
+}
+
+static int imx48x_table_reg16(const struct imx48x_fw_reg *regs, unsigned int n,
+			      u16 addr)
+{
+	int hi = imx48x_table_reg(regs, n, addr);
+	int lo = imx48x_table_reg(regs, n, addr + 1);
+
+	if (hi < 0 || lo < 0)
+		return -1;
+
+	return hi << 8 | lo;
+}
+
+static int imx48x_parse_mode(struct imx48x_mode *mode)
+{
+	const struct imx48x_fw_reg *r = mode->regs;
+	unsigned int n = mode->num_regs;
+	int fmt, lanes, w, h, x0, y0, x1, y1, llp, fll;
+	int vt_pix, vt_sys, pre, mult, op_sys, op_pre, op_mult;
+	u64 rate;
+
+	fmt = imx48x_table_reg16(r, n, IMX48X_CSI_DATA_FORMAT);
+	lanes = imx48x_table_reg(r, n, IMX48X_CSI_LANE_MODE);
+	w = imx48x_table_reg16(r, n, IMX48X_X_OUTPUT_SIZE);
+	h = imx48x_table_reg16(r, n, IMX48X_Y_OUTPUT_SIZE);
+	x0 = imx48x_table_reg16(r, n, IMX48X_X_ADDR_START);
+	y0 = imx48x_table_reg16(r, n, IMX48X_Y_ADDR_START);
+	x1 = imx48x_table_reg16(r, n, IMX48X_X_ADDR_END);
+	y1 = imx48x_table_reg16(r, n, IMX48X_Y_ADDR_END);
+	llp = imx48x_table_reg16(r, n, IMX48X_LINE_LENGTH_PCK);
+	fll = imx48x_table_reg16(r, n, IMX48X_FRAME_LENGTH_LINES);
+	vt_pix = imx48x_table_reg(r, n, IMX48X_VT_PIX_CLK_DIV);
+	vt_sys = imx48x_table_reg(r, n, IMX48X_VT_SYS_CLK_DIV);
+	pre = imx48x_table_reg(r, n, IMX48X_PRE_PLL_CLK_DIV);
+	mult = imx48x_table_reg16(r, n, IMX48X_PLL_MULTIPLIER);
+	op_sys = imx48x_table_reg(r, n, IMX48X_OP_SYS_CLK_DIV);
+	op_pre = imx48x_table_reg(r, n, IMX48X_OP_PRE_PLL_CLK_DIV);
+	op_mult = imx48x_table_reg16(r, n, IMX48X_OP_PLL_MULTIPLIER);
+
+	/* RAW10 only */
+	if (fmt != 0x0a0a || lanes < 0 || w <= 0 || h <= 0 || x0 < 0 || y0 < 0 ||
+	    x1 < x0 || y1 < y0 || llp <= w || fll <= h || vt_sys <= 0 ||
+	    pre <= 0 || mult <= 0 || op_sys <= 0 || op_pre <= 0 || op_mult <= 0)
+		return -EINVAL;
+
+	/* not every table sets it (the IMX563's): then it stays at 1 */
+	if (vt_pix <= 0)
+		vt_pix = 1;
+
+	mode->width = w;
+	mode->height = h;
+	mode->crop.left = x0;
+	mode->crop.top = y0;
+	mode->crop.width = x1 - x0 + 1;
+	mode->crop.height = y1 - y0 + 1;
+	mode->llp = llp;
+	mode->fll = fll;
+	mode->lanes = lanes + 1;
+
+	/* the output PLL clocks the CSI-2 lanes, two bits per link clock */
+	rate = (u64)IMX48X_MCLK_RATE * op_mult;
+	mode->link_freq = div_u64(rate, op_pre * op_sys * 2);
+
+	/* the video timing clock handles four pixels per cycle */
+	rate = (u64)IMX48X_MCLK_RATE * mult * 4;
+	mode->pixel_rate = div_u64(rate, pre * vt_sys * vt_pix);
+
+	return 0;
+}
+
+static int imx48x_load_tables(struct imx48x *sensor)
+{
+	const struct imx48x_fw_header *hdr;
+	const char *name = sensor->variant->firmware;
+	const u8 *p, *end;
+	unsigned int i;
+	int ret;
+
+	device_property_read_string(sensor->dev, "firmware-name", &name);
+
+	ret = request_firmware(&sensor->fw, name, sensor->dev);
+	if (ret)
+		return dev_err_probe(sensor->dev, ret,
+				     "no register tables (%s)\n", name);
+
+	p = sensor->fw->data;
+	end = p + sensor->fw->size;
+	hdr = (const void *)p;
+
+	if (sensor->fw->size < sizeof(*hdr) ||
+	    memcmp(hdr->magic, IMX48X_FW_MAGIC, sizeof(hdr->magic)) ||
+	    le16_to_cpu(hdr->model) != sensor->variant->model) {
+		ret = -EINVAL;
+		goto bad;
+	}
+	p += sizeof(*hdr);
+
+	for (i = 0; i < le16_to_cpu(hdr->num_lists); i++) {
+		const struct imx48x_fw_list *list = (const void *)p;
+		unsigned int n;
+
+		if (end - p < sizeof(*list)) {
+			ret = -EINVAL;
+			goto bad;
+		}
+		n = le16_to_cpu(list->num_regs);
+		p += sizeof(*list);
+		if (end - p < n * sizeof(struct imx48x_fw_reg)) {
+			ret = -EINVAL;
+			goto bad;
+		}
+
+		switch (le16_to_cpu(list->type)) {
+		case IMX48X_FW_LIST_INIT:
+			sensor->init_regs = (const void *)p;
+			sensor->num_init_regs = n;
+			break;
+		case IMX48X_FW_LIST_MODE: {
+			struct imx48x_mode *mode;
+
+			if (sensor->num_modes == IMX48X_MAX_MODES)
+				break;
+			mode = &sensor->modes[sensor->num_modes];
+			mode->regs = (const void *)p;
+			mode->num_regs = n;
+			if (imx48x_parse_mode(mode)) {
+				dev_warn(sensor->dev, "table %u: not a RAW10 mode, skipped\n", i);
+				break;
+			}
+			sensor->num_modes++;
+			break;
+		}
+		default:
+			break;
+		}
+
+		p += n * sizeof(struct imx48x_fw_reg);
+	}
+
+	if (!sensor->init_regs || !sensor->num_modes) {
+		ret = -EINVAL;
+		goto bad;
+	}
+
+	return 0;
+
+bad:
+	release_firmware(sensor->fw);
+	sensor->fw = NULL;
+	return dev_err_probe(sensor->dev, ret, "%s: not a valid %s table file\n",
+			     name, sensor->variant->name);
+}
+
+/*
+ * Keep the modes the board can carry: its lanes, at a link frequency the
+ * endpoint lists. Each mode notes the index of its frequency in the menu.
+ */
+static int imx48x_check_modes(struct imx48x *sensor)
+{
+	unsigned int i, j, kept = 0;
+
+	for (i = 0; i < sensor->num_modes; i++) {
+		struct imx48x_mode *mode = &sensor->modes[i];
+
+		for (j = 0; j < sensor->num_link_freqs; j++)
+			if (sensor->link_freqs[j] == mode->link_freq)
+				break;
+
+		if (mode->lanes != sensor->lanes || j == sensor->num_link_freqs) {
+			dev_info(sensor->dev,
+				 "mode %ux%u (%u lanes, %lld Hz) not on this board\n",
+				 mode->width, mode->height, mode->lanes,
+				 mode->link_freq);
+			continue;
+		}
+
+		mode->link_freq_index = j;
+		sensor->modes[kept++] = *mode;
+	}
+	sensor->num_modes = kept;
+
+	if (!kept)
+		return dev_err_probe(sensor->dev, -EINVAL, "no usable mode\n");
+
+	for (i = 0; i < kept; i++) {
+		const struct v4l2_rect *c = &sensor->modes[i].crop;
+
+		sensor->native.width = max_t(u32, sensor->native.width,
+					     c->left + c->width);
+		sensor->native.height = max_t(u32, sensor->native.height,
+					      c->top + c->height);
+	}
+
+	return 0;
+}
+
+/* -----------------------------------------------------------------------------
+ * Controls
+ */
+
+static int imx48x_set_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct imx48x *sensor = container_of(ctrl->handler, struct imx48x, ctrls);
+	const struct v4l2_mbus_framefmt *format;
+	struct v4l2_subdev_state *state;
+	int ret = 0;
+
+	state = v4l2_subdev_get_locked_active_state(&sensor->sd);
+	format = v4l2_subdev_state_get_format(state, 0);
+
+	if (ctrl->id == V4L2_CID_VBLANK) {
+		int exposure_max = format->height + ctrl->val - IMX48X_EXPOSURE_OFFSET;
+
+		ret = __v4l2_ctrl_modify_range(sensor->exposure,
+					       sensor->exposure->minimum,
+					       exposure_max, sensor->exposure->step,
+					       min_t(s64, sensor->exposure->default_value,
+						     exposure_max));
+		if (ret)
+			return ret;
+	}
+
+	/* the values reach the sensor when it is powered for streaming */
+	if (pm_runtime_get_if_in_use(sensor->dev) <= 0)
+		return 0;
+
+	switch (ctrl->id) {
+	case V4L2_CID_EXPOSURE:
+		cci_write(sensor->regmap, IMX48X_REG_EXPOSURE, ctrl->val, &ret);
+		break;
+	case V4L2_CID_ANALOGUE_GAIN:
+		cci_write(sensor->regmap, IMX48X_REG_ANALOG_GAIN, ctrl->val, &ret);
+		break;
+	case V4L2_CID_DIGITAL_GAIN:
+		cci_write(sensor->regmap, IMX48X_REG_DIGITAL_GAIN, ctrl->val, &ret);
+		break;
+	case V4L2_CID_VBLANK:
+		cci_write(sensor->regmap, IMX48X_REG_FRAME_LENGTH,
+			  format->height + ctrl->val, &ret);
+		break;
+	case V4L2_CID_TEST_PATTERN:
+		cci_write(sensor->regmap, IMX48X_REG_TEST_PATTERN,
+			  imx48x_test_pattern_val[ctrl->val], &ret);
+		break;
+	default:
+		/* read-only: pixel rate, link frequency, horizontal blanking */
+		break;
+	}
+
+	pm_runtime_put(sensor->dev);
+
+	return ret;
+}
+
+static const struct v4l2_ctrl_ops imx48x_ctrl_ops = {
+	.s_ctrl = imx48x_set_ctrl,
+};
+
+static int imx48x_init_controls(struct imx48x *sensor)
+{
+	const struct imx48x_mode *mode = &sensor->modes[0];
+	struct v4l2_ctrl_handler *hdl = &sensor->ctrls;
+	struct v4l2_fwnode_device_properties props;
+	u32 fll = imx48x_default_fll(mode);
+	int ret;
+
+	v4l2_ctrl_handler_init(hdl, 10);
+
+	sensor->pixel_rate = v4l2_ctrl_new_std(hdl, &imx48x_ctrl_ops,
+					       V4L2_CID_PIXEL_RATE,
+					       mode->pixel_rate, mode->pixel_rate,
+					       1, mode->pixel_rate);
+
+	sensor->link_freq = v4l2_ctrl_new_int_menu(hdl, &imx48x_ctrl_ops,
+						   V4L2_CID_LINK_FREQ,
+						   sensor->num_link_freqs - 1,
+						   mode->link_freq_index,
+						   sensor->link_freqs);
+	if (sensor->link_freq)
+		sensor->link_freq->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	sensor->vblank = v4l2_ctrl_new_std(hdl, &imx48x_ctrl_ops, V4L2_CID_VBLANK,
+					   mode->fll - mode->height,
+					   IMX48X_FRAME_LENGTH_MAX - mode->height,
+					   1, fll - mode->height);
+
+	sensor->hblank = v4l2_ctrl_new_std(hdl, &imx48x_ctrl_ops, V4L2_CID_HBLANK,
+					   mode->llp - mode->width,
+					   mode->llp - mode->width, 1,
+					   mode->llp - mode->width);
+	if (sensor->hblank)
+		sensor->hblank->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	sensor->exposure = v4l2_ctrl_new_std(hdl, &imx48x_ctrl_ops, V4L2_CID_EXPOSURE,
+					     IMX48X_EXPOSURE_MIN,
+					     fll - IMX48X_EXPOSURE_OFFSET, 1,
+					     fll - IMX48X_EXPOSURE_OFFSET);
+
+	v4l2_ctrl_new_std(hdl, &imx48x_ctrl_ops, V4L2_CID_ANALOGUE_GAIN,
+			  IMX48X_ANA_GAIN_MIN, IMX48X_ANA_GAIN_MAX, 1,
+			  IMX48X_ANA_GAIN_MIN);
+
+	v4l2_ctrl_new_std(hdl, &imx48x_ctrl_ops, V4L2_CID_DIGITAL_GAIN,
+			  IMX48X_DGTL_GAIN_MIN, IMX48X_DGTL_GAIN_MAX, 1,
+			  IMX48X_DGTL_GAIN_DEFAULT);
+
+	v4l2_ctrl_new_std_menu_items(hdl, &imx48x_ctrl_ops, V4L2_CID_TEST_PATTERN,
+				     ARRAY_SIZE(imx48x_test_pattern_menu) - 1,
+				     0, 0, imx48x_test_pattern_menu);
+
+	ret = v4l2_fwnode_device_parse(sensor->dev, &props);
+	if (ret)
+		goto error;
+
+	v4l2_ctrl_new_fwnode_properties(hdl, &imx48x_ctrl_ops, &props);
+
+	if (hdl->error) {
+		ret = hdl->error;
+		goto error;
+	}
+
+	sensor->sd.ctrl_handler = hdl;
+
+	return 0;
+
+error:
+	v4l2_ctrl_handler_free(hdl);
+	return dev_err_probe(sensor->dev, ret, "controls\n");
+}
