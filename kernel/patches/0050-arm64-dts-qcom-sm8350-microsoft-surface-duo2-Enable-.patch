From 711fa546947aa19a79f12643f034bdaa4e30e6d4 Mon Sep 17 00:00:00 2001
From: Andy1210 <andy1210@gmail.com>
Date: Sat, 7 Nov 2026 17:37:57 +0100
Subject: [PATCH 050/137] arm64: dts: qcom: sm8350-microsoft-surface-duo2:
 Enable the video codec

Enable the IRIS2 video codec. It loads the device's own firmware image,
vpu20_4v.mbn (VPU 2.0 with four pipes, Gen1 HFI, signed for this device),
from qcom/sm8350/microsoft/, where the device's other firmware lives.

Assisted-by: Claude:claude-opus-5-5
---
 arch/arm64/boot/dts/qcom/sm8350-microsoft-surface-duo2.dts | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/sm8350-microsoft-surface-duo2.dts b/arch/arm64/boot/dts/qcom/sm8350-microsoft-surface-duo2.dts
index 4d8d78384e50..ca1d03e4258b 100644
--- a/arch/arm64/boot/dts/qcom/sm8350-microsoft-surface-duo2.dts
+++ b/arch/arm64/boot/dts/qcom/sm8350-microsoft-surface-duo2.dts
@@ -602,6 +602,12 @@ &ipa {
 	status = "okay";
 };
 
+&iris {
+	firmware-name = "qcom/sm8350/microsoft/vpu20_4v.mbn";
+
+	status = "okay";
+};
+
