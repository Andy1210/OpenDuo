From 59077928efb4b5e2e62be01cc24882a7822ca519 Mon Sep 17 00:00:00 2001
From: Andy1210 <andy1210@gmail.com>
Date: Fri, 6 Nov 2026 16:16:35 +0100
Subject: [PATCH 019/147] arm64: dts: qcom: sm8350-microsoft-surface-duo2: Load
 the IPA firmware

The GSI firmware of IPA is loaded by Linux on this SoC; name the
device's own signed image, as the other SM8350 phones do.

Assisted-by: Claude:claude-opus-5-5
---
 arch/arm64/boot/dts/qcom/sm8350-microsoft-surface-duo2.dts | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/sm8350-microsoft-surface-duo2.dts b/arch/arm64/boot/dts/qcom/sm8350-microsoft-surface-duo2.dts
index c9759653dd67..19524ae76ca3 100644
--- a/arch/arm64/boot/dts/qcom/sm8350-microsoft-surface-duo2.dts
+++ b/arch/arm64/boot/dts/qcom/sm8350-microsoft-surface-duo2.dts
@@ -481,6 +481,10 @@ &gpu_zap_shader {
 };
 
 &ipa {
+	qcom,gsi-loader = "self";
+	memory-region = <&pil_ipa_fw_mem>;
+	firmware-name = "qcom/sm8350/microsoft/ipa_fws.mbn";
+
 	status = "okay";
 };
 
