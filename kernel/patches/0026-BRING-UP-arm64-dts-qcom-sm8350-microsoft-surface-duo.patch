From 5e6e5a6bf777b1d7f85bcf98616adebb16ad4217 Mon Sep 17 00:00:00 2001
From: Andy1210 <andy1210@gmail.com>
Date: Sat, 7 Nov 2026 00:45:41 +0100
Subject: [PATCH 026/149] BRING-UP: arm64: dts: qcom:
 sm8350-microsoft-surface-duo2: Add the SLPI sleepstate SMP2P entries

The sensor DSP waits for the SMP2P entry "sleepstate" before it
publishes remote_proc_state, and everything Microsoft built on it waits
too: with the entry missing, both AK0991x magnetometers, mag_cal,
device_state, the hinge angle, the posture, fold, flip, sar_posture and
lightfusion never appeared. Add the outgoing "sleepstate" and incoming
"sleepstate_see" entries to the SLPI edge, as in the stock DT, and the
qcom,smp2p-sleepstate node that keeps the awake bit current.

Measured: with this DTB all of them are published about 65 s after the SLPI
starts; the hinge angle reads 180-183 degrees with the phone open and flat
(as Android did), the posture 5.

Assisted-by: Claude:claude-opus-5-5
---
 .../qcom/sm8350-microsoft-surface-duo2.dts    | 31 +++++++++++++++++++
 1 file changed, 31 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/sm8350-microsoft-surface-duo2.dts b/arch/arm64/boot/dts/qcom/sm8350-microsoft-surface-duo2.dts
index ce877db6fbba..1f24ad6b63f8 100644
--- a/arch/arm64/boot/dts/qcom/sm8350-microsoft-surface-duo2.dts
+++ b/arch/arm64/boot/dts/qcom/sm8350-microsoft-surface-duo2.dts
@@ -704,6 +704,37 @@ &slpi {
 	firmware-name = "qcom/sm8350/microsoft/slpi.mbn";
 };
 
+/*
+ * The sensor DSP reads whether the APSS is awake from the SMP2P entry
+ * "sleepstate" (and may ask it to stay up through "sleepstate_see"); the
+ * stock DT has the same two entries on this edge. The DSP's remote_proc_state
+ * sensor is built on that entry, and without it neither that sensor nor the
+ * ones waiting on it are ever published: device_state, both magnetometers,
+ * mag_cal, the hinge angle, the posture and the rest of Microsoft's sensors.
+ * qcom,smp2p-sleepstate keeps the "awake" bit up to date.
+ */
+&{/smp2p-slpi} {
+	smp2p_slpi_sleepstate_out: sleepstate-out {
+		qcom,entry-name = "sleepstate";
+		#qcom,smem-state-cells = <1>;
+	};
+
+	smp2p_slpi_sleepstate_in: sleepstate-in {
+		qcom,entry-name = "sleepstate_see";
+		interrupt-controller;
+		#interrupt-cells = <2>;
+	};
+};
+
+/ {
+	slpi-sleepstate {
+		compatible = "qcom,smp2p-sleepstate";
+		qcom,smem-states = <&smp2p_slpi_sleepstate_out 0>;
+		interrupts-extended = <&smp2p_slpi_sleepstate_in 0 IRQ_TYPE_EDGE_RISING>;
+		interrupt-names = "smp2p-sleepstate-in";
+	};
+};
+
 &tlmm {
 	gpio-reserved-ranges = <4 4>, <12 4>, <56 4>, <76 4>;
 
