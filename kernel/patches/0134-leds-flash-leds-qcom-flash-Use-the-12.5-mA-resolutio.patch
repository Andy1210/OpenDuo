From a34116b881aac3bfcd347cd061a87806fe8f25f1 Mon Sep 17 00:00:00 2001
From: Andy1210 <andy1210@gmail.com>
Date: Fri, 13 Nov 2026 18:46:46 +0100
Subject: [PATCH 134/147] leds: flash: leds-qcom-flash: Use the 12.5 mA
 resolution for torch on 4ch rev 0.1

The torch of the 4-channel flash module revision 0.1 (PM8350C on SM8350,
Microsoft Surface Duo 2) never lights: within 200 us of enabling a
channel with the 5 mA current resolution, the module's LED fault and
all-ramp-down-done real-time status bits are set, all-ramp-up-done never
is, and no bit of STATUS1/2/3 explains it. It does so at every target
current from the lowest code up and on each of the four channels alone,
including the ones without an LED, and also without the thermal
threshold check before the enable.

With the 12.5 mA resolution and the same current, the module ramps up
without a fault and the battery current rises by the torch's load. The
vendor driver programs the torch with 12.5 mA as well (the stock device
tree's qcom,ires-ua for every torch node).

Use the 12.5 mA resolution for the torch on that revision. Only the
IRESOLUTION and ITARGET values change; the torch clamp keeps its value,
which is not below the target in either resolution.

Assisted-by: Claude:claude-opus-5-5
---
 drivers/leds/flash/leds-qcom-flash.c | 21 +++++++++++++++++----
 1 file changed, 17 insertions(+), 4 deletions(-)

diff --git a/drivers/leds/flash/leds-qcom-flash.c b/drivers/leds/flash/leds-qcom-flash.c
index b03a6833e3e3..cc8177c6237b 100644
--- a/drivers/leds/flash/leds-qcom-flash.c
+++ b/drivers/leds/flash/leds-qcom-flash.c
@@ -176,6 +176,7 @@ struct qcom_flash_data {
 	u8			chan_en_bits;
 	u8			revision;
 	u8			torch_clamp;
+	u32			torch_ires_ua;
 };
 
 struct qcom_flash_led {
@@ -349,7 +350,7 @@ static int set_flash_current(struct qcom_flash_led *led, u32 current_ma, enum le
 	 * IRESOLUTION and ITARGET registers accordingly.
 	 */
 	itarg_ua = (current_ma * UA_PER_MA) / led->chan_count + 1;
-	ires_ua = (mode == FLASH_MODE) ? FLASH_IRES_UA : TORCH_IRES_UA;
+	ires_ua = (mode == FLASH_MODE) ? FLASH_IRES_UA : flash_data->torch_ires_ua;
 
 	for (i = 0; i < led->chan_count; i++) {
 		u8 itarget = 0;
@@ -366,13 +367,13 @@ static int set_flash_current(struct qcom_flash_led *led, u32 current_ma, enum le
 		if (flash_data->hw_type == QCOM_MVFLASH_3CH) {
 			shift = chan_id * 2;
 			ires_mask |= FLASH_IRES_MASK_3CH << shift;
-			ires_val |= ((mode == FLASH_MODE) ?
+			ires_val |= ((ires_ua == FLASH_IRES_UA) ?
 				(FLASH_IRES_12P5MA_VAL << shift) :
 				(FLASH_IRES_5MA_VAL_3CH << shift));
 		} else if (flash_data->hw_type == QCOM_MVFLASH_4CH) {
 			shift = chan_id;
 			ires_mask |= FLASH_IRES_MASK_4CH << shift;
-			ires_val |= ((mode == FLASH_MODE) ?
+			ires_val |= ((ires_ua == FLASH_IRES_UA) ?
 				(FLASH_IRES_12P5MA_VAL << shift) :
 				(FLASH_IRES_5MA_VAL_4CH << shift));
 		} else {
@@ -683,7 +684,7 @@ qcom_flash_v4l2_init(struct device *dev, struct qcom_flash_led *led, struct fwno
 	if (!(led->flash.led_cdev.flags & LED_DEV_CAP_FLASH))
 		return 0;
 
-	intensity->min = intensity->step = TORCH_IRES_UA * led->chan_count;
+	intensity->min = intensity->step = flash_data->torch_ires_ua * led->chan_count;
 	intensity->max = led->max_torch_current_ma * UA_PER_MA;
 	intensity->val = min_t(u32, intensity->max, TORCH_CURRENT_DEFAULT_UA);
 
@@ -849,6 +850,8 @@ static int qcom_flash_led_probe(struct platform_device *pdev)
 	if (!flash_data)
 		return -ENOMEM;
 
+	flash_data->torch_ires_ua = TORCH_IRES_UA;
+
 	regmap = dev_get_regmap(dev->parent, NULL);
 	if (!regmap) {
 		dev_err(dev, "Failed to get parent regmap\n");
@@ -907,6 +910,16 @@ static int qcom_flash_led_probe(struct platform_device *pdev)
 		}
 
 		flash_data->revision = val;
+
+		/*
+		 * The torch of the 4-channel module revision 0.1 (PM8350C on
+		 * SM8350) faults within microseconds of enabling a channel
+		 * with the 5 mA current resolution, at any current and on
+		 * every channel, and never ramps up. With the 12.5 mA one it
+		 * works, which is also what the vendor driver uses for torch.
+		 */
+		if (flash_data->revision == FLASH_4CH_REVISION_V0P1)
+			flash_data->torch_ires_ua = FLASH_IRES_UA;
 	} else {
 		dev_err(dev, "flash LED subtype %#x is not yet supported\n", val);
 		return -ENODEV;
