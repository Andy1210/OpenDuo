From 3042391a958dea93ef74e8e0c110af3988b1ebaf Mon Sep 17 00:00:00 2001
From: Andy1210 <andy1210@gmail.com>
Date: Sun, 8 Nov 2026 11:15:56 +0100
Subject: [PATCH 118/149] arm64: dts: qcom: sm8350-microsoft-surface-duo2: Wake
 on the modem and sensor DSP

Mark the GLINK edges of the modem and of the sensor DSP as wakeup
sources, so that what they say may wake the phone: an incoming call or
SMS reaches ModemManager and Calls while it sleeps. Which messages do is
the IPC router's choice (by default the modem's Voice and WMS
indications and requests the remotes wait on; the sensor DSP's sensor
service only when added to qrtr.wake_services), and each edge can be
switched off at run time (power/wakeup of its IPCRTR device).

Assisted-by: Claude:claude-opus-5-5
---
 .../boot/dts/qcom/sm8350-microsoft-surface-duo2.dts | 13 +++++++++++++
 1 file changed, 13 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/sm8350-microsoft-surface-duo2.dts b/arch/arm64/boot/dts/qcom/sm8350-microsoft-surface-duo2.dts
index 27af2a53ecc0..1233925175e3 100644
--- a/arch/arm64/boot/dts/qcom/sm8350-microsoft-surface-duo2.dts
+++ b/arch/arm64/boot/dts/qcom/sm8350-microsoft-surface-duo2.dts
@@ -937,6 +937,11 @@ &mdss_dsi1_phy {
 &mpss {
 	status = "okay";
 	firmware-name = "qcom/sm8350/microsoft/modem.mbn";
+
+	glink-edge {
+		/* an incoming call or SMS wakes the phone (the IPC router picks) */
+		wakeup-source;
+	};
 };
 
 &pcie0 {
@@ -1193,6 +1198,14 @@ bluetooth {
 &slpi {
 	status = "okay";
 	firmware-name = "qcom/sm8350/microsoft/slpi.mbn";
+
+	glink-edge {
+		/*
+		 * the sensor DSP's wakeup sensors (the fold) may wake the phone;
+		 * the IPC router decides (qrtr.wake_services)
+		 */
+		wakeup-source;
+	};
 };
 
