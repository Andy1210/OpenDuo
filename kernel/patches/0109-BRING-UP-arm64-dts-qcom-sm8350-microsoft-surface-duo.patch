From b8c1f55ca6799134797bd2c52095cdc002f222f2 Mon Sep 17 00:00:00 2001
From: Andy1210 <andy1210@gmail.com>
Date: Sat, 7 Nov 2026 19:31:56 +0100
Subject: [PATCH 109/149] BRING-UP: arm64: dts: qcom:
 sm8350-microsoft-surface-duo2: Enable voice calls and the earpiece

Enable the Q6 voice services and add the VoiceMMode1 and VoiceMMode2
front ends (the modem's voice sessions of the first and the second
subscription; PCM devices 3 and 4). The voice runs in the ADSP between
the modem and the WSA and VA codec DMA ports.

Put the earpiece amplifier ("Receiver", the WSA8830 at the top centre
of the right half) on the WSA link, fed from WSA_SPK1 like SpkrLeft.
The two share master ports 1-3: the UCM switches the ports of only one
of them on, and wsa883x keeps the PA of the other off.

Assisted-by: Claude:claude-opus-5-5
---
 .../qcom/sm8350-microsoft-surface-duo2.dts    | 42 +++++++++++++++++--
 1 file changed, 39 insertions(+), 3 deletions(-)

diff --git a/arch/arm64/boot/dts/qcom/sm8350-microsoft-surface-duo2.dts b/arch/arm64/boot/dts/qcom/sm8350-microsoft-surface-duo2.dts
index 2fe9c3bb616a..a87f8c9f0c6e 100644
--- a/arch/arm64/boot/dts/qcom/sm8350-microsoft-surface-duo2.dts
+++ b/arch/arm64/boot/dts/qcom/sm8350-microsoft-surface-duo2.dts
@@ -9,6 +9,7 @@
 #include <dt-bindings/input/input.h>
 #include <dt-bindings/interrupt-controller/irq.h>
 #include <dt-bindings/regulator/qcom,rpmh-regulator.h>
+#include <dt-bindings/sound/qcom,q6voice.h>
 #include "sm8350.dtsi"
 #include "pm8350.dtsi"
 #include "pm8350b.dtsi"
@@ -109,14 +110,21 @@ cont_splash_mem: memory@e1000000 {
 	 * are digital, on the LPASS DMIC pins, recorded through the VA macro
 	 * (stock records through the TX macro; same pins).
 	 *
-	 * The earpiece is left out of the card until the speakers work: with the
-	 * same master ports as SpkrLeft it must never stream at the same time.
+	 * The earpiece shares SpkrLeft's SoundWire master ports: only one of the
+	 * two may have its ports switched on (the UCM picks), and an amplifier
+	 * whose DAC port is off keeps its PA off.
+	 *
+	 * Calls: the modem's voice runs in the ADSP (VoiceMMode1 = the first
+	 * subscription, VoiceMMode2 = the second), straight to the WSA and VA
+	 * codec DMA ports; opening the front end's PCM in both directions starts
+	 * it.
 	 */
 	sound {
 		compatible = "qcom,sm8350-sndcard";
 		model = "Microsoft-SurfaceDuo2";
 		audio-routing = "SpkrLeft IN", "WSA_SPK1 OUT",
 				"SpkrRight IN", "WSA_SPK2 OUT",
+				"Receiver IN", "WSA_SPK1 OUT",
 				"VA DMIC0", "vdd-micb",
 				"VA DMIC1", "vdd-micb",
 				"VA DMIC2", "vdd-micb",
@@ -148,6 +156,22 @@ cpu {
 			};
 		};
 
+		voicemmode1-dai-link {
+			link-name = "VoiceMMode1";
+
+			cpu {
+				sound-dai = <&q6voicedai VOICEMMODE1>;
+			};
+		};
+
+		voicemmode2-dai-link {
+			link-name = "VoiceMMode2";
+
+			cpu {
+				sound-dai = <&q6voicedai VOICEMMODE2>;
+			};
+		};
+
 		wsa-dai-link {
 			link-name = "WSA Playback";
 
@@ -156,7 +180,7 @@ cpu {
 			};
 
 			codec {
-				sound-dai = <&spkr_left>, <&spkr_right>,
+				sound-dai = <&spkr_left>, <&spkr_right>, <&earpiece>,
 					    <&swr0 0>, <&wsamacro 0>;
 			};
 
@@ -1116,6 +1140,18 @@ vreg_l7j_2p8: ldo7 {
 	};
 };
 
+&q6cvp {
+	status = "okay";
+};
+
+&q6cvs {
+	status = "okay";
+};
+
+&q6mvm {
+	status = "okay";
+};
+
 &qupv3_id_0 {
 	status = "okay";
 };
