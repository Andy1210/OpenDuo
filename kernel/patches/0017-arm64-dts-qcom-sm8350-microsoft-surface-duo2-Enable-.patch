From 1f431df951a05ffca7dde5d2e94abcbfb703dcbb Mon Sep 17 00:00:00 2001
From: Andy1210 <andy1210@gmail.com>
Date: Fri, 6 Nov 2026 15:01:28 +0100
Subject: [PATCH 017/137] arm64: dts: qcom: sm8350-microsoft-surface-duo2:
 Enable the PMIC RTC

The PMK8350 RTC and its alarm wake the phone from suspend (the stock
Android does the same); the RTC of the UEFI runtime services fails to
read on this device.

Assisted-by: Claude:claude-opus-5-5
---
 arch/arm64/boot/dts/qcom/sm8350-microsoft-surface-duo2.dts | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/sm8350-microsoft-surface-duo2.dts b/arch/arm64/boot/dts/qcom/sm8350-microsoft-surface-duo2.dts
index 1745c838a067..b3244290512f 100644
--- a/arch/arm64/boot/dts/qcom/sm8350-microsoft-surface-duo2.dts
+++ b/arch/arm64/boot/dts/qcom/sm8350-microsoft-surface-duo2.dts
@@ -623,6 +623,10 @@ vol_up_n: vol-up-n-state {
 	};
 };
 
+&pmk8350_rtc {
+	status = "okay";
+};
+
 &pon_pwrkey {
 	status = "okay";
 };
