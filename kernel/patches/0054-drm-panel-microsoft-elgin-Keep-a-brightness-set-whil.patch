From 6ac36671e80ae2d3a904be5373bcee9db1b88e9d Mon Sep 17 00:00:00 2001
From: Andy1210 <andy1210@gmail.com>
Date: Sun, 8 Nov 2026 01:49:28 +0100
Subject: [PATCH 054/149] drm/panel: microsoft-elgin: Keep a brightness set
 while the panel is off

The brightness is a DCS command, which the DSI host cannot send before
the panel is powered: systemd-backlight restores the saved level at
boot, before the first modeset, and the write failed with -EINVAL (the
restore unit failed and the panel kept the boot loader's level). Return
early while the panel is not enabled; drm_panel_enable() applies the
level through backlight_enable() once it is.

Assisted-by: Claude:claude-opus-5-5
---
 drivers/gpu/drm/panel/panel-microsoft-elgin.c | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/drivers/gpu/drm/panel/panel-microsoft-elgin.c b/drivers/gpu/drm/panel/panel-microsoft-elgin.c
index 77b27ee62ba1..cf47030841db 100644
--- a/drivers/gpu/drm/panel/panel-microsoft-elgin.c
+++ b/drivers/gpu/drm/panel/panel-microsoft-elgin.c
@@ -283,8 +283,18 @@ static const struct drm_panel_funcs elgin_panel_funcs = {
 static int elgin_bl_update_status(struct backlight_device *bl)
 {
 	struct mipi_dsi_device *dsi = bl_get_data(bl);
+	struct elgin *ctx = mipi_dsi_get_drvdata(dsi);
 	u16 brightness = backlight_get_brightness(bl);
 
+	/*
+	 * The level is a DCS command, which the DSI host cannot send while
+	 * the panel is off (userspace restores the saved level at boot,
+	 * before the first modeset): keep it, drm_panel_enable() applies it
+	 * through backlight_enable() once the panel is on.
+	 */
+	if (!ctx->panel.enabled)
+		return 0;
+
 	/* big endian on the wire, like the vendor's "inverted dbv" */
 	return mipi_dsi_dcs_set_display_brightness_large(dsi, brightness);
 }
