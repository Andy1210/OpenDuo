From 00cb1c4d15b46b047a85bfb538a698f6fa7d5e9f Mon Sep 17 00:00:00 2001
From: Andy1210 <andy1210@gmail.com>
Date: Fri, 6 Nov 2026 18:08:07 +0100
Subject: [PATCH 021/137] clk: qcom: gcc-sm8350: Use retention for the PCIe
 power domains

As on SM8450 and SC8280XP, the PCIe GDSCs do not reach the off state
when their controller is powered down for system suspend; every suspend
of a Surface Duo 2 with a WCN6855 on PCIe0 warned "pcie_0_gdsc status
stuck at 'on'". Use retention instead.

Assisted-by: Claude:claude-opus-5-5
---
 drivers/clk/qcom/gcc-sm8350.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/drivers/clk/qcom/gcc-sm8350.c b/drivers/clk/qcom/gcc-sm8350.c
index 2d94f3046b71..35f8d2d6b9a5 100644
--- a/drivers/clk/qcom/gcc-sm8350.c
+++ b/drivers/clk/qcom/gcc-sm8350.c
@@ -3421,7 +3421,7 @@ static struct gdsc pcie_0_gdsc = {
 	.pd = {
 		.name = "pcie_0_gdsc",
 	},
-	.pwrsts = PWRSTS_OFF_ON,
+	.pwrsts = PWRSTS_RET_ON,
 };
 
 static struct gdsc pcie_1_gdsc = {
@@ -3429,7 +3429,7 @@ static struct gdsc pcie_1_gdsc = {
 	.pd = {
 		.name = "pcie_1_gdsc",
 	},
-	.pwrsts = PWRSTS_OFF_ON,
+	.pwrsts = PWRSTS_RET_ON,
 };
 
 static struct gdsc ufs_card_gdsc = {
