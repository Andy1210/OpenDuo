-static int q6voice_dai_startup(struct snd_pcm_substream *substream,
+/*
+ * The vocproc connects straight to the AFE ports of the back ends: tell it
+ * the format they run at (the back end's fixed-up hw_params), for the back
+ * end whose port is the one the path uses.
+ */
+static void q6voice_dai_set_be_format(struct q6voice *v,
+				      enum q6voice_path_type path,
+				      struct snd_pcm_substream *substream)
+{
+	struct snd_soc_pcm_runtime *fe = snd_soc_substream_to_rtd(substream);
+	int stream = substream->stream;
+	int port = q6voice_get_port(v, path, stream == SNDRV_PCM_STREAM_CAPTURE);
+	struct snd_soc_dpcm *dpcm;
+
+	for_each_dpcm_be(fe, stream, dpcm) {
+		struct snd_soc_pcm_runtime *be = dpcm->be;
+		struct snd_pcm_hw_params *params = &be->dpcm[stream].hw_params;
+		struct q6voice_port_format fmt;
+
+		if (snd_soc_rtd_to_cpu(be, 0)->id != port)
+			continue;
+
+		fmt.rate = params_rate(params);
+		fmt.channels = params_channels(params);
+		fmt.bits = params_width(params);
+		q6voice_set_format(v, path, stream == SNDRV_PCM_STREAM_CAPTURE,
+				   &fmt);
+		dev_dbg(fe->dev, "voice path %d %s: %s, %u Hz, %u ch, %u bit\n",
+			path, stream ? "tx" : "rx", be->dai_link->name,
+			fmt.rate, fmt.channels, fmt.bits);
+		return;
+	}
+}
+
+/*
+ * The path starts when both of its directions are prepared: by then the
+ * back ends have their parameters and their AFE ports run.
+ */
+static int q6voice_dai_prepare(struct snd_pcm_substream *substream,
 			       struct snd_soc_dai *dai)
 {
 	struct q6voice *v = snd_soc_dai_get_drvdata(dai);
 	enum q6voice_path_type path = q6voice_get_path(dai->driver->id);
+	int ret;
 
 	if (path == Q6VOICE_PATH_COUNT) {
 		dev_err(dai->dev, "Invalid DAI ID %u\n", dai->driver->id);
 		return -EINVAL;
 	}
 
-	return q6voice_start(v, path, substream->stream);
+	q6voice_dai_set_be_format(v, path, substream);
+
+	ret = q6voice_start(v, path, substream->stream);
+	return ret == -EALREADY ? 0 : ret;
 }
 
