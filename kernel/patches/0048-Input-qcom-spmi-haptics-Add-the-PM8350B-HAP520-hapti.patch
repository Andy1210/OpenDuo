+static const struct qcom_haptics_variant hap530_variant = {
+	.fault_clr = FAULT_CLR_ALL,
+	.fifo_thresh_lsb = HAP530_FIFO_THRESH_LSB,
+	.fifo_empty_thresh = HAP530_FIFO_EMPTY_THRESH,
