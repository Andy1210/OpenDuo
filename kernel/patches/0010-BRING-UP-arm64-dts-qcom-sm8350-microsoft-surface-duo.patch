From f188eb210321f0b72a5502fcd8a8cac5b7c35c58 Mon Sep 17 00:00:00 2001
From: Andy1210 <andy1210@gmail.com>
Date: Fri, 6 Nov 2026 09:09:53 +0100
Subject: [PATCH 010/147] BRING-UP: arm64: dts: qcom:
 sm8350-microsoft-surface-duo2: Disable usb_2 in variant H

The second USB controller's GDSC (usb30_sec_gdsc) is stuck off on this
phone, and nothing needs the controller during bring-up.

Not for upstream: a bring-up variant, built next to the main DTB.

Assisted-by: Claude:claude-opus-5-5
---
 .../boot/dts/qcom/sm8350-microsoft-surface-duo2-keepfb3.dts  | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/sm8350-microsoft-surface-duo2-keepfb3.dts b/arch/arm64/boot/dts/qcom/sm8350-microsoft-surface-duo2-keepfb3.dts
index 1786a6de1767..68d467d713d4 100644
--- a/arch/arm64/boot/dts/qcom/sm8350-microsoft-surface-duo2-keepfb3.dts
+++ b/arch/arm64/boot/dts/qcom/sm8350-microsoft-surface-duo2-keepfb3.dts
@@ -45,3 +45,8 @@ &usb_1_dwc3 {
 	phys = <&usb_1_hsphy>;
 	phy-names = "usb2-phy";
 };
+
+/* The second controller's GDSC is stuck off on this phone; not needed. */
+&usb_2 {
+	status = "disabled";
+};
