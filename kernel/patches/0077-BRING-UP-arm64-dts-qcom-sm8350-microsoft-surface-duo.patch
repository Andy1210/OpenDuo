From 3125e372eb5317b57a3e75a62de1eb5dc587bf63 Mon Sep 17 00:00:00 2001
From: Andy1210 <andy1210@gmail.com>
Date: Sun, 8 Nov 2026 01:27:44 +0100
Subject: [PATCH 077/137] BRING-UP: arm64: dts: qcom:
 sm8350-microsoft-surface-duo2: Add all four cameras' endpoints

Tele IMX481 on CSIPHY0 (768 MHz), wide IMX563 on CSIPHY2 (1248 MHz),
front IMX481 on CSIPHY5 (768 MHz), the ultrawide on CSIPHY4 as before;
each with its module's register tables and its orientation.

Assisted-by: Claude:claude-opus-5-5
---
 .../qcom/sm8350-microsoft-surface-duo2.dts    | 69 ++++++++++++++++++-
 1 file changed, 66 insertions(+), 3 deletions(-)

diff --git a/arch/arm64/boot/dts/qcom/sm8350-microsoft-surface-duo2.dts b/arch/arm64/boot/dts/qcom/sm8350-microsoft-surface-duo2.dts
index 95ab0d800a91..69a5ebf7606b 100644
--- a/arch/arm64/boot/dts/qcom/sm8350-microsoft-surface-duo2.dts
+++ b/arch/arm64/boot/dts/qcom/sm8350-microsoft-surface-duo2.dts
@@ -559,9 +559,9 @@ vreg_l1d_1p2: ldo1 {
  * factory calibration of the modules.
  */
 /*
- * CSIPHY supplies as in the vendor DT. The ultrawide camera streams through
- * CSIPHY4 (BRING-UP: the other three have no endpoints yet). The modules'
- * lanes are in order (the vendor laneAssign 0x3210).
+ * CSIPHY supplies as in the vendor DT. The cameras stream through CSIPHY0
+ * (tele), 2 (wide), 4 (ultrawide) and 5 (front), four D-PHY lanes each, in
+ * order (the vendor laneAssign 0x3210).
  */
 &camss {
 	vdda-phy-supply = <&vreg_l5b_0p88>;
@@ -570,6 +570,22 @@ &camss {
 	status = "okay";
 
 	ports {
+		port@0 {
+			csiphy0_ep: endpoint {
+				clock-lanes = <7>;
+				data-lanes = <0 1 2 3>;
+				remote-endpoint = <&camera_tele_ep>;
+			};
+		};
+
+		port@2 {
+			csiphy2_ep: endpoint {
+				clock-lanes = <7>;
+				data-lanes = <0 1 2 3>;
+				remote-endpoint = <&camera_wide_ep>;
+			};
+		};
+
 		port@4 {
 			csiphy4_ep: endpoint {
 				clock-lanes = <7>;
@@ -577,6 +593,14 @@ csiphy4_ep: endpoint {
 				remote-endpoint = <&camera_uw_ep>;
 			};
 		};
+
+		port@5 {
+			csiphy5_ep: endpoint {
+				clock-lanes = <7>;
+				data-lanes = <0 1 2 3>;
+				remote-endpoint = <&camera_front_ep>;
+			};
+		};
 	};
 };
 
@@ -610,6 +634,19 @@ camera_tele: camera@1a {
 
 		pinctrl-0 = <&cam_mclk1_default &cam_tele_reset_default>;
 		pinctrl-names = "default";
+
+		/* generated from the phone's own vendor image, see docs/hardware/camera.md */
+		firmware-name = "qcom/sm8350/microsoft/imx481-tele.bin";
+
+		orientation = <1>;
+
+		port {
+			camera_tele_ep: endpoint {
+				data-lanes = <1 2 3 4>;
+				link-frequencies = /bits/ 64 <768000000>;
+				remote-endpoint = <&csiphy0_ep>;
+			};
+		};
 	};
 };
 
@@ -631,6 +668,19 @@ camera_wide: camera@1a {
 
 		pinctrl-0 = <&cam_mclk0_default &cam_wide_reset_default>;
 		pinctrl-names = "default";
+
+		/* generated from the phone's own vendor image, see docs/hardware/camera.md */
+		firmware-name = "qcom/sm8350/microsoft/imx563-wide.bin";
+
+		orientation = <1>;
+
+		port {
+			camera_wide_ep: endpoint {
+				data-lanes = <1 2 3 4>;
+				link-frequencies = /bits/ 64 <1248000000>;
+				remote-endpoint = <&csiphy2_ep>;
+			};
+		};
 	};
 };
 
@@ -691,6 +741,19 @@ camera_front: camera@1a {
 
 		pinctrl-0 = <&cam_mclk3_default &cam_front_reset_default>;
 		pinctrl-names = "default";
+
+		/* generated from the phone's own vendor image, see docs/hardware/camera.md */
+		firmware-name = "qcom/sm8350/microsoft/imx481-front.bin";
+
+		orientation = <0>;
+
+		port {
+			camera_front_ep: endpoint {
+				data-lanes = <1 2 3 4>;
+				link-frequencies = /bits/ 64 <768000000>;
+				remote-endpoint = <&csiphy5_ep>;
+			};
+		};
 	};
 
 	eeprom@50 {
