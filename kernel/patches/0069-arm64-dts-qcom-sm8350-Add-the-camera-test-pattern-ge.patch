From 40c8351ae5a94148c2b252452180db5e60e09905 Mon Sep 17 00:00:00 2001
From: Andy1210 <andy1210@gmail.com>
Date: Sun, 8 Nov 2026 00:50:40 +0100
Subject: [PATCH 069/147] arm64: dts: qcom: sm8350: Add the camera test pattern
 generators

Describe the two TPG 1.0.2 blocks and the camera top registers that
route them into the CSI receivers.

Assisted-by: Claude:claude-opus-5-5
---
 arch/arm64/boot/dts/qcom/sm8350.dtsi | 10 ++++++++--
 1 file changed, 8 insertions(+), 2 deletions(-)

diff --git a/arch/arm64/boot/dts/qcom/sm8350.dtsi b/arch/arm64/boot/dts/qcom/sm8350.dtsi
index 6d2c943ca9ae..39df7577add3 100644
--- a/arch/arm64/boot/dts/qcom/sm8350.dtsi
+++ b/arch/arm64/boot/dts/qcom/sm8350.dtsi
@@ -3175,7 +3175,10 @@ camss: isp@ac6a000 {
 			       <0 0x0acc3000 0 0xd000>,
 			       <0 0x0acef000 0 0xd000>,
 			       <0 0x0acd9000 0 0x2200>,
-			       <0 0x0acdb200 0 0x2200>;
+			       <0 0x0acdb200 0 0x2200>,
+			       <0 0x0ac97000 0 0x100>,
+			       <0 0x0ac98000 0 0x100>,
+			       <0 0x0ac40000 0 0x1000>;
 			reg-names = "csiphy0",
 				     "csiphy1",
 				     "csiphy2",
@@ -3186,7 +3189,10 @@ camss: isp@ac6a000 {
 				     "vfe1",
 				     "vfe2",
 				     "vfe_lite0",
-				     "vfe_lite1";
+				     "vfe_lite1",
+				     "tpg0",
+				     "tpg1",
+				     "cpas_top";
 
 			clocks = <&gcc GCC_CAMERA_HF_AXI_CLK>,
 				  <&gcc GCC_CAMERA_SF_AXI_CLK>,
