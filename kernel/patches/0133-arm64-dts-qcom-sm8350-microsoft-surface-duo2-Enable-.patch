From 753d0e5be5bf5a101bdfe403f02419d7c9f9e6c2 Mon Sep 17 00:00:00 2001
From: Andy1210 <andy1210@gmail.com>
Date: Fri, 13 Nov 2026 17:13:27 +0100
Subject: [PATCH 133/147] arm64: dts: qcom: sm8350-microsoft-surface-duo2:
 Enable the camera flash LED

The rear camera flash LED is driven by the PM8350C flash LED module, on
its channels 1 and 2 driven together: the stock device tree's camera
flash uses those two channels, symmetrically, for both flash and torch.

Describe it as one LED on the two channels with the stock limits: 200 mA
per channel in torch mode, a 500 ms flash timeout. Stock allows 1.8 A
per channel for a flash; the module's limit for a ganged pair, 2 A in
all, is the lower one.

Assisted-by: Claude:claude-opus-5-5
---
 .../qcom/sm8350-microsoft-surface-duo2.dts    | 20 +++++++++++++++++++
 1 file changed, 20 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/sm8350-microsoft-surface-duo2.dts b/arch/arm64/boot/dts/qcom/sm8350-microsoft-surface-duo2.dts
index 20f1793e03e5..d24efbf99ebb 100644
--- a/arch/arm64/boot/dts/qcom/sm8350-microsoft-surface-duo2.dts
+++ b/arch/arm64/boot/dts/qcom/sm8350-microsoft-surface-duo2.dts
@@ -11,6 +11,7 @@
 #include <dt-bindings/iio/qcom,spmi-adc7-pmk8350.h>
 #include <dt-bindings/input/input.h>
 #include <dt-bindings/interrupt-controller/irq.h>
+#include <dt-bindings/leds/common.h>
 #include <dt-bindings/regulator/qcom,rpmh-regulator.h>
 #include <dt-bindings/sound/qcom,q6voice.h>
 #include "sm8350.dtsi"
@@ -1079,6 +1080,25 @@ &pm8350b_haptics {
 	status = "okay";
 };
 
+&pm8350c_flash {
+	status = "okay";
+
+	/*
+	 * The rear camera flash, on channels 1 and 2 driven together, as the
+	 * stock device tree does. Torch: 200 mA per channel, the stock limit.
+	 * Flash: stock allows 1.8 A per channel for 500 ms; the module's limit
+	 * for a ganged pair (2 A) is the lower one.
+	 */
+	led-0 {
+		function = LED_FUNCTION_FLASH;
+		color = <LED_COLOR_ID_WHITE>;
+		led-sources = <1>, <2>;
+		led-max-microamp = <400000>;
+		flash-max-microamp = <2000000>;
+		flash-max-timeout-us = <500000>;
+	};
+};
+
 /*
  * The board thermistors (the stock DT's xo / cam / soc / chgr / tdm / bat
  * therm on PMK8350, PM8350 and PM8350B): what Android's thermal engine
