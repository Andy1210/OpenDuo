From bb186e57bcf909e59f3947d25f581463e65b51c2 Mon Sep 17 00:00:00 2001
From: Andy1210 <andy1210@gmail.com>
Date: Fri, 6 Nov 2026 00:05:25 +0100
Subject: [PATCH 007/149] arm64: dts: qcom: sm8350-microsoft-surface-duo2:
 Raise the S11B maximum to the stock 1.012 V

Same trap as S2E: a max below the bootloader's voltage makes the core pull
the rail down at probe.

Assisted-by: Claude:claude-opus-5-5
---
 arch/arm64/boot/dts/qcom/sm8350-microsoft-surface-duo2.dts | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/qcom/sm8350-microsoft-surface-duo2.dts b/arch/arm64/boot/dts/qcom/sm8350-microsoft-surface-duo2.dts
index 8f87aad76bd7..ec2987dd232b 100644
--- a/arch/arm64/boot/dts/qcom/sm8350-microsoft-surface-duo2.dts
+++ b/arch/arm64/boot/dts/qcom/sm8350-microsoft-surface-duo2.dts
@@ -222,7 +222,7 @@ vreg_s10b_1p8: smps10 {
 		vreg_s11b_0p95: smps11 {
 			regulator-name = "vreg_s11b_0p95";
 			regulator-min-microvolt = <752000>;
-			regulator-max-microvolt = <1000000>;
+			regulator-max-microvolt = <1012000>;
 		};
 
 		vreg_s12b_1p25: smps12 {
