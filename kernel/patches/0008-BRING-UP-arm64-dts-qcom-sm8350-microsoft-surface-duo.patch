From 57c280b81e72e460aba26d5765f9603091511c02 Mon Sep 17 00:00:00 2001
From: Andy1210 <andy1210@gmail.com>
Date: Fri, 6 Nov 2026 00:08:09 +0100
Subject: [PATCH 008/137] BRING-UP: arm64: dts: qcom:
 sm8350-microsoft-surface-duo2: Run variant H at USB 2.0 only

The USB console gadget must not depend on the QMP combo PHY, which
needs the plug orientation for USB3/DP: run the primary controller high
speed only, on its HS PHY.

Not for upstream: a bring-up variant, built next to the main DTB.

Assisted-by: Claude:claude-opus-5-5
---
 .../dts/qcom/sm8350-microsoft-surface-duo2-keepfb3.dts | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/sm8350-microsoft-surface-duo2-keepfb3.dts b/arch/arm64/boot/dts/qcom/sm8350-microsoft-surface-duo2-keepfb3.dts
index 2e3b464ff398..1786a6de1767 100644
--- a/arch/arm64/boot/dts/qcom/sm8350-microsoft-surface-duo2-keepfb3.dts
+++ b/arch/arm64/boot/dts/qcom/sm8350-microsoft-surface-duo2-keepfb3.dts
@@ -35,3 +35,13 @@ &vreg_l12c_1p8 {
 &vreg_l13c_3p0 {
 	regulator-always-on;
 };
+
+/*
+ * USB 2.0 only for bring-up: the console gadget must not depend on the QMP
+ * combo PHY (USB3/DP, needs the plug orientation).
+ */
+&usb_1_dwc3 {
+	maximum-speed = "high-speed";
+	phys = <&usb_1_hsphy>;
+	phy-names = "usb2-phy";
+};
