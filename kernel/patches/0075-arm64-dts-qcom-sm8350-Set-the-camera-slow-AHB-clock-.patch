From a4a6f3e29205de5d2b027fdb51585a785378ff7e Mon Sep 17 00:00:00 2001
From: Andy1210 <andy1210@gmail.com>
Date: Sun, 8 Nov 2026 01:19:44 +0100
Subject: [PATCH 075/137] arm64: dts: qcom: sm8350: Set the camera slow AHB
 clock rate

The vendor camera driver runs the camera slow AHB clock at 80 MHz at
every performance level; the camera clock controller starts it at
19.2 MHz and nothing else sets it.

Assisted-by: Claude:claude-opus-5-5
---
 arch/arm64/boot/dts/qcom/sm8350.dtsi | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/sm8350.dtsi b/arch/arm64/boot/dts/qcom/sm8350.dtsi
index 39df7577add3..1e669917b159 100644
--- a/arch/arm64/boot/dts/qcom/sm8350.dtsi
+++ b/arch/arm64/boot/dts/qcom/sm8350.dtsi
@@ -3279,6 +3279,10 @@ camss: isp@ac6a000 {
 				       "vfe_lite_cphy_rx",
 				       "vfe_lite_csid";
 
+			/* the vendor driver's rate at every level */
+			assigned-clocks = <&camcc CAM_CC_SLOW_AHB_CLK_SRC>;
+			assigned-clock-rates = <80000000>;
+
 			interrupts = <GIC_SPI 477 IRQ_TYPE_EDGE_RISING>,
 				      <GIC_SPI 478 IRQ_TYPE_EDGE_RISING>,
 				      <GIC_SPI 479 IRQ_TYPE_EDGE_RISING>,
