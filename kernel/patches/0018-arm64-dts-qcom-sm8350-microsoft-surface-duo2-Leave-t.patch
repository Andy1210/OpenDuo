From 6cc72f650e5719ea368a4a123daeda2813b80848 Mon Sep 17 00:00:00 2001
From: Andy1210 <andy1210@gmail.com>
Date: Fri, 6 Nov 2026 15:43:48 +0100
Subject: [PATCH 018/147] arm64: dts: qcom: sm8350-microsoft-surface-duo2:
 Leave the gauge buses to the ADSP

The fuel gauges of the two battery packs sit on QUP SE10 and SE11, and
the ADSP's battery firmware talks to them; the vendor device tree keeps
both I2C controllers disabled for Linux. Enabling them gains nothing and
the first access from Linux wedged the controller and stopped charging.

Assisted-by: Claude:claude-opus-5-5
---
 .../arm64/boot/dts/qcom/sm8350-microsoft-surface-duo2.dts | 8 --------
 1 file changed, 8 deletions(-)

diff --git a/arch/arm64/boot/dts/qcom/sm8350-microsoft-surface-duo2.dts b/arch/arm64/boot/dts/qcom/sm8350-microsoft-surface-duo2.dts
index b3244290512f..c9759653dd67 100644
--- a/arch/arm64/boot/dts/qcom/sm8350-microsoft-surface-duo2.dts
+++ b/arch/arm64/boot/dts/qcom/sm8350-microsoft-surface-duo2.dts
@@ -480,14 +480,6 @@ &gpu_zap_shader {
 	firmware-name = "qcom/sm8350/microsoft/a660_zap.mbn";
 };
 
-&i2c10 {
-	status = "okay";
-};
-
-&i2c11 {
-	status = "okay";
-};
-
 &ipa {
 	status = "okay";
 };
