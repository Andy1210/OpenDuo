From 349df1df2d84adde8eb1d7cda2aff9f9c0606cda Mon Sep 17 00:00:00 2001
From: Andy1210 <andy1210@gmail.com>
Date: Thu, 5 Nov 2026 20:43:38 +0100
Subject: [PATCH 001/147] arm64: dts: qcom: sm8350-microsoft-surface-duo2: Add
 the charger, USB-C, WiFi, BT and keys

Describe what the phone needs first, taken from Microsoft's own device
tree for it (surfaceduo2/11/2023.501.541):

- pmic_glink (battery manager + UCSI) with the USB-C connector, and
  dwc3 in OTG mode taking its role from UCSI
- WCN6855 (QCA6490) power sequencer with the stock enable lines and
  rails, WiFi on PCIe0, Bluetooth on a new SE13 UART
- the pmr735a rails S2E (WCN) and L7E (antenna switch)
- volume up (pm8350 gpio6), volume down (PON resin), power key
- the ABL's SoC/board ids and the continuous-splash carve-out

Assisted-by: Claude:claude-opus-5-5
---
 .../qcom/sm8350-microsoft-surface-duo2.dts    | 336 +++++++++++++++++-
 1 file changed, 335 insertions(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/qcom/sm8350-microsoft-surface-duo2.dts b/arch/arm64/boot/dts/qcom/sm8350-microsoft-surface-duo2.dts
index 442405ba5f6a..36373bcaea4e 100644
--- a/arch/arm64/boot/dts/qcom/sm8350-microsoft-surface-duo2.dts
+++ b/arch/arm64/boot/dts/qcom/sm8350-microsoft-surface-duo2.dts
@@ -5,6 +5,9 @@
 
 /dts-v1/;
 
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/input/input.h>
+#include <dt-bindings/interrupt-controller/irq.h>
 #include <dt-bindings/regulator/qcom,rpmh-regulator.h>
 #include "sm8350.dtsi"
 #include "pm8350.dtsi"
@@ -19,8 +22,151 @@ / {
 	compatible = "microsoft,surface-duo2", "qcom,sm8350";
 	chassis-type = "handset";
 
+	/*
+	 * The ABL picks a DTB by SoC id and revision and refuses one without
+	 * them; same values as the stock DTB (SM8350 v2.1, soc_id 415).
+	 * Not needed when booting through the UEFI.
+	 */
+	qcom,msm-id = <0x19f 0x20001>, <0x1c8 0x20001>, <0x1f5 0x20001>;
+	qcom,board-id = <0 0>;
+
 	aliases {
 		serial0 = &uart2;
+		serial1 = &uart13;
+	};
+
+	gpio-keys {
+		compatible = "gpio-keys";
+
+		pinctrl-0 = <&vol_up_n>;
+		pinctrl-names = "default";
+
+		key-volume-up {
+			label = "Volume Up";
+			linux,code = <KEY_VOLUMEUP>;
+			gpios = <&pm8350_gpios 6 GPIO_ACTIVE_LOW>;
+			debounce-interval = <15>;
+			linux,can-disable;
+			wakeup-source;
+		};
+	};
+
+	/*
+	 * Charging, both battery packs and the USB-C port are run by the ADSP
+	 * firmware (stock DT: battery_charger + ucsi over glink).
+	 * TODO: the plug orientation GPIO is not known yet; without it the
+	 * SuperSpeed lanes may work in one orientation only (USB 2 and
+	 * charging are unaffected).
+	 */
+	pmic-glink {
+		compatible = "qcom,sm8350-pmic-glink", "qcom,pmic-glink";
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		connector@0 {
+			compatible = "usb-c-connector";
+			reg = <0>;
+			power-role = "dual";
+			data-role = "dual";
+
+			ports {
+				#address-cells = <1>;
+				#size-cells = <0>;
+
+				port@0 {
+					reg = <0>;
+
+					pmic_glink_hs_in: endpoint {
+						remote-endpoint = <&usb_1_dwc3_hs>;
+					};
+				};
+
+				port@1 {
+					reg = <1>;
+
+					pmic_glink_ss_in: endpoint {
+						remote-endpoint = <&usb_1_qmpphy_out>;
+					};
+				};
+			};
+		};
+	};
+
+	reserved-memory {
+		/* The splash the ABL leaves on screen; the display keeps scanning it. */
+		cont_splash_mem: memory@e1000000 {
+			reg = <0x0 0xe1000000 0x0 0x2300000>;
+			no-map;
+		};
+	};
+
+	/*
+	 * QCA6490 (= WCN6855) WiFi on PCIe0 + Bluetooth on UART13. Enable lines
+	 * and rails from the stock DT: WL_EN gpio64, BT_EN gpio65, SW_CTRL
+	 * gpio153; aon S2E, dig S11B, io S10B, rfa1 S1C, rfa2 S12B.
+	 */
+	wcn6855-pmu {
+		compatible = "qcom,wcn6855-pmu";
+
+		pinctrl-0 = <&bt_en>, <&wlan_en>, <&wcn_sw_ctrl>;
+		pinctrl-names = "default";
+
+		wlan-enable-gpios = <&tlmm 64 GPIO_ACTIVE_HIGH>;
+		bt-enable-gpios = <&tlmm 65 GPIO_ACTIVE_HIGH>;
+		swctrl-gpios = <&tlmm 153 GPIO_ACTIVE_HIGH>;
+
+		vddio-supply = <&vreg_s10b_1p8>;
+		vddaon-supply = <&vreg_s11b_0p95>;
+		vddpmu-supply = <&vreg_s12b_1p25>;
+		vddpmumx-supply = <&vreg_s2e_0p95>;
+		vddpmucx-supply = <&vreg_s11b_0p95>;
+		vddrfa0p95-supply = <&vreg_s11b_0p95>;
+		vddrfa1p3-supply = <&vreg_s12b_1p25>;
+		vddrfa1p9-supply = <&vreg_s1c_1p86>;
+		vddpcie1p3-supply = <&vreg_s12b_1p25>;
+		vddpcie1p9-supply = <&vreg_s1c_1p86>;
+
+		regulators {
+			vreg_pmu_rfa_cmn_0p8: ldo0 {
+				regulator-name = "vreg_pmu_rfa_cmn_0p8";
+			};
+
+			vreg_pmu_aon_0p8: ldo1 {
+				regulator-name = "vreg_pmu_aon_0p8";
+			};
+
+			vreg_pmu_wlcx_0p8: ldo2 {
+				regulator-name = "vreg_pmu_wlcx_0p8";
+			};
+
+			vreg_pmu_wlmx_0p8: ldo3 {
+				regulator-name = "vreg_pmu_wlmx_0p8";
+			};
+
+			vreg_pmu_btcmx_0p8: ldo4 {
+				regulator-name = "vreg_pmu_btcmx_0p8";
+			};
+
+			vreg_pmu_pcie_1p8: ldo5 {
+				regulator-name = "vreg_pmu_pcie_1p8";
+			};
+
+			vreg_pmu_pcie_0p9: ldo6 {
+				regulator-name = "vreg_pmu_pcie_0p9";
+			};
+
+			vreg_pmu_rfa_0p8: ldo7 {
+				regulator-name = "vreg_pmu_rfa_0p8";
+			};
+
+			vreg_pmu_rfa_1p2: ldo8 {
+				regulator-name = "vreg_pmu_rfa_1p2";
+			};
+
+			vreg_pmu_rfa_1p7: ldo9 {
+				regulator-name = "vreg_pmu_rfa_1p7";
+			};
+		};
 	};
 
 	chosen {
@@ -274,6 +420,33 @@ vreg_l13c_3p0: ldo13 {
 			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
 		};
 	};
+
+	regulators-2 {
+		compatible = "qcom,pmr735a-rpmh-regulators";
+		qcom,pmic-id = "e";
+
+		vdd-s2-supply = <&vph_pwr>;
+		vdd-l7-bob-supply = <&vreg_bob>;
+
+		/* WCN6855 aon/mx rail (stock: 0.95 V) */
+		vreg_s2e_0p95: smps2 {
+			regulator-name = "vreg_s2e_0p95";
+			regulator-min-microvolt = <950000>;
+			regulator-max-microvolt = <976000>;
+		};
+
+		/*
+		 * WiFi antenna switch. Android's cnss driver switches it with
+		 * the radio; mainline has no consumer for it yet, so keep it on.
+		 */
+		vreg_l7e_2p8: ldo7 {
+			regulator-name = "vreg_l7e_2p8";
+			regulator-min-microvolt = <2800000>;
+			regulator-max-microvolt = <2800000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+			regulator-always-on;
+		};
+	};
 };
 
 &cdsp {
@@ -298,12 +471,92 @@ &mpss {
 	firmware-name = "qcom/sm8350/microsoft/modem.mbn";
 };
 
+&pcie0 {
+	pinctrl-0 = <&pcie0_default_state>;
+	pinctrl-names = "default";
+
+	perst-gpios = <&tlmm 94 GPIO_ACTIVE_LOW>;
+	wake-gpios = <&tlmm 96 GPIO_ACTIVE_HIGH>;
+
+	status = "okay";
+
+	pcie@0 {
+		wifi@0 {
+			compatible = "pci17cb,1103";
+			reg = <0x10000 0x0 0x0 0x0 0x0>;
+
+			vddrfacmn-supply = <&vreg_pmu_rfa_cmn_0p8>;
+			vddaon-supply = <&vreg_pmu_aon_0p8>;
+			vddwlcx-supply = <&vreg_pmu_wlcx_0p8>;
+			vddwlmx-supply = <&vreg_pmu_wlmx_0p8>;
+			vddpcie1p8-supply = <&vreg_pmu_pcie_1p8>;
+			vddpcie0p9-supply = <&vreg_pmu_pcie_0p9>;
+			vddrfa0p8-supply = <&vreg_pmu_rfa_0p8>;
+			vddrfa1p2-supply = <&vreg_pmu_rfa_1p2>;
+			vddrfa1p8-supply = <&vreg_pmu_rfa_1p7>;
+		};
+	};
+};
+
+&pcie0_phy {
+	vdda-phy-supply = <&vreg_l5b_0p88>;
+	vdda-pll-supply = <&vreg_l6b_1p2>;
+
+	status = "okay";
+};
+
+&pm8350_gpios {
+	vol_up_n: vol-up-n-state {
+		pins = "gpio6";
+		function = "normal";
+		power-source = <1>;
+		input-enable;
+		bias-pull-up;
+	};
+};
+
+&pon_pwrkey {
+	status = "okay";
+};
+
+&pon_resin {
+	linux,code = <KEY_VOLUMEDOWN>;
+
+	status = "okay";
+};
+
 &qupv3_id_0 {
 	status = "okay";
 };
 
 &qupv3_id_1 {
 	status = "okay";
+
+	/* SE13 as a 4-wire UART for Bluetooth; sm8350.dtsi has only i2c13/spi13 here. */
+	uart13: serial@a94000 {
+		compatible = "qcom,geni-uart";
+		reg = <0 0x00a94000 0 0x4000>;
+		clock-names = "se";
+		clocks = <&gcc GCC_QUPV3_WRAP1_S5_CLK>;
+		pinctrl-0 = <&qup_uart13_default>;
+		pinctrl-names = "default";
+		interrupts = <GIC_SPI 358 IRQ_TYPE_LEVEL_HIGH>;
+		power-domains = <&rpmhpd RPMHPD_CX>;
+		operating-points-v2 = <&qup_opp_table_100mhz>;
+
+		bluetooth {
+			compatible = "qcom,wcn6855-bt";
+
+			vddrfacmn-supply = <&vreg_pmu_rfa_cmn_0p8>;
+			vddaon-supply = <&vreg_pmu_aon_0p8>;
+			vddwlcx-supply = <&vreg_pmu_wlcx_0p8>;
+			vddwlmx-supply = <&vreg_pmu_wlmx_0p8>;
+			vddbtcmx-supply = <&vreg_pmu_btcmx_0p8>;
+			vddrfa0p8-supply = <&vreg_pmu_rfa_0p8>;
+			vddrfa1p2-supply = <&vreg_pmu_rfa_1p2>;
+			vddrfa1p7-supply = <&vreg_pmu_rfa_1p7>;
+		};
+	};
 };
 
 &slpi {
@@ -313,6 +566,77 @@ &slpi {
 
 &tlmm {
 	gpio-reserved-ranges = <4 4>, <12 4>, <56 4>, <76 4>;
+
+	/* BT UART on SE13 (stock: gpio0 CTS, gpio1 RTS, gpio2 RX, gpio3 TX). */
+	qup_uart13_default: qup-uart13-default-state {
+		cts-rx-pins {
+			pins = "gpio0", "gpio2";
+			function = "qup13";
+			drive-strength = <2>;
+			bias-disable;
+		};
+
+		rts-pins {
+			pins = "gpio1";
+			function = "qup13";
+			drive-strength = <2>;
+			bias-pull-down;
+		};
+
+		tx-pins {
+			pins = "gpio3";
+			function = "qup13";
+			drive-strength = <2>;
+			bias-pull-up;
+		};
+	};
+
+	/* Same pins as the stock DT and the SM8350 HDK. */
+	pcie0_default_state: pcie0-default-state {
+		perst-pins {
+			pins = "gpio94";
+			function = "gpio";
+			drive-strength = <2>;
+			bias-pull-down;
+		};
+
+		clkreq-pins {
+			pins = "gpio95";
+			function = "pcie0_clkreqn";
+			drive-strength = <2>;
+			bias-pull-up;
+		};
+
+		wake-pins {
+			pins = "gpio96";
+			function = "gpio";
+			drive-strength = <2>;
+			bias-pull-up;
+		};
+	};
+
+	wlan_en: wlan-en-state {
+		pins = "gpio64";
+		function = "gpio";
+		drive-strength = <16>;
+		output-low;
+		bias-pull-down;
+	};
+
+	bt_en: bt-en-state {
+		pins = "gpio65";
+		function = "gpio";
+		drive-strength = <16>;
+		output-low;
+		bias-pull-down;
+	};
+
+	wcn_sw_ctrl: wcn-sw-ctrl-state {
+		pins = "gpio153";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-pull-down;
+	};
 };
 
 &uart2 {
@@ -342,7 +666,17 @@ &usb_1 {
 };
 
 &usb_1_dwc3 {
-	dr_mode = "peripheral";
+	/* Role from the ADSP's UCSI (pmic_glink) instead of fixed peripheral. */
+	dr_mode = "otg";
+	usb-role-switch;
+};
+
+&usb_1_dwc3_hs {
+	remote-endpoint = <&pmic_glink_hs_in>;
+};
+
+&usb_1_qmpphy_out {
+	remote-endpoint = <&pmic_glink_ss_in>;
 };
 
 &usb_1_hsphy {
