index 73562627ef2e..e6f14a111841 100644
--- a/sound/soc/qcom/qdsp6/q6voice.h
+++ b/sound/soc/qcom/qdsp6/q6voice.h
@@ -34,6 +34,11 @@ void q6voice_set_port(struct q6voice *v, enum q6voice_path_type path,
 void q6voice_set_format(struct q6voice *v, enum q6voice_path_type path,
 			bool capture, const struct q6voice_port_format *fmt);
 
+int q6voice_set_mute(struct q6voice *v, enum q6voice_path_type path,
+		     bool capture, bool mute);
+bool q6voice_get_mute(struct q6voice *v, enum q6voice_path_type path,
+		      bool capture);
+
 u32 q6voice_get_topology(struct q6voice *v, enum q6voice_path_type path,
 			 bool capture);
 void q6voice_set_topology(struct q6voice *v, enum q6voice_path_type path,
