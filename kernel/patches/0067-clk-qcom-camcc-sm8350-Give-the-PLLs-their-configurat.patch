From d870098c413e2cd8c61f85b1d2f6fcefc01f7d7d Mon Sep 17 00:00:00 2001
From: Andy1210 <andy1210@gmail.com>
Date: Sun, 8 Nov 2026 00:25:15 +0100
Subject: [PATCH 067/149] clk: qcom: camcc-sm8350: Give the PLLs their
 configurations

qcom_cc_probe() configures the PLLs from clk_alpha_pll.config: without it
the probe stopped at "cam_cc_pll0: missing pll config or regs".

Assisted-by: Claude:claude-opus-5-5
---
 drivers/clk/qcom/camcc-sm8350.c | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/drivers/clk/qcom/camcc-sm8350.c b/drivers/clk/qcom/camcc-sm8350.c
index 4cdb77355fc6..b281e995f4f7 100644
--- a/drivers/clk/qcom/camcc-sm8350.c
+++ b/drivers/clk/qcom/camcc-sm8350.c
@@ -69,6 +69,7 @@ static const struct alpha_pll_config cam_cc_pll0_config = {
 
 static struct clk_alpha_pll cam_cc_pll0 = {
 	.offset = 0x0,
+	.config = &cam_cc_pll0_config,
 	.vco_table = lucid_5lpe_vco,
 	.num_vco = ARRAY_SIZE(lucid_5lpe_vco),
 	.regs = clk_alpha_pll_regs[CLK_ALPHA_PLL_TYPE_LUCID],
