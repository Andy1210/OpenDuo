From 96e1b79bfc09585256d5f614158c2c353948a939 Mon Sep 17 00:00:00 2001
From: Andy1210 <andy1210@gmail.com>
Date: Fri, 6 Nov 2026 14:39:59 +0100
Subject: [PATCH 016/147] arm64: dts: qcom: sm8350-microsoft-surface-duo2:
 Enable the GPU

Enable the Adreno 660 with the device's own signed zap shader.

Assisted-by: Claude:claude-opus-5-5
---
 .../arm64/boot/dts/qcom/sm8350-microsoft-surface-duo2.dts | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/sm8350-microsoft-surface-duo2.dts b/arch/arm64/boot/dts/qcom/sm8350-microsoft-surface-duo2.dts
index f2b7c3e4bcc4..1745c838a067 100644
--- a/arch/arm64/boot/dts/qcom/sm8350-microsoft-surface-duo2.dts
+++ b/arch/arm64/boot/dts/qcom/sm8350-microsoft-surface-duo2.dts
@@ -472,6 +472,14 @@ &cdsp {
 	firmware-name = "qcom/sm8350/microsoft/cdsp.mbn";
 };
 
+&gpu {
+	status = "okay";
+};
+
+&gpu_zap_shader {
+	firmware-name = "qcom/sm8350/microsoft/a660_zap.mbn";
+};
+
 &i2c10 {
 	status = "okay";
 };
