From 0e7d819683194d98e764ae0e90befc4c528ac13f Mon Sep 17 00:00:00 2001
From: Andy1210 <andy1210@gmail.com>
Date: Sun, 8 Nov 2026 11:15:40 +0100
Subject: [PATCH 115/149] dt-bindings: remoteproc: qcom,glink-edge: Add
 wakeup-source

A GLINK edge's remote processor may say things the system has to wake
up for while it sleeps: a modem's incoming call or SMS. Let the edge be
marked as such; which messages actually wake the system is the business
of the protocol on top (the IPC router).

Assisted-by: Claude:claude-opus-5-5
---
 .../devicetree/bindings/remoteproc/qcom,glink-edge.yaml      | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/Documentation/devicetree/bindings/remoteproc/qcom,glink-edge.yaml b/Documentation/devicetree/bindings/remoteproc/qcom,glink-edge.yaml
index e78a89c9ec41..aaa18d66a702 100644
--- a/Documentation/devicetree/bindings/remoteproc/qcom,glink-edge.yaml
+++ b/Documentation/devicetree/bindings/remoteproc/qcom,glink-edge.yaml
@@ -52,6 +52,11 @@ properties:
       ID of the shared memory used by GLINK for communication with remote
       processor.
 
+  wakeup-source:
+    description:
+      Messages from the remote processor may wake the system from a
+      system sleep (the IPC router picks which: a modem's incoming call).
+
 required:
   - interrupts
   - label
