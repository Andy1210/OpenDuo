# Surface Duo 2 additions on top of arm64 defconfig (7.3.y stable).
# Picture on the first boots: the UEFI GOP framebuffer.
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_DRM_SIMPLEDRM=m
# Touch (spi-hid comes later as a patch): raw HID frames to userspace.
CONFIG_HIDRAW=y
CONFIG_UHID=m
CONFIG_HID_MICROSOFT=m
# Bluetooth on the QCA UART.
CONFIG_BT_HCIUART=m
CONFIG_BT_HCIUART_SERDEV=y
CONFIG_BT_HCIUART_QCA=y
# Root on UFS and a USB console without an initramfs module dance.
CONFIG_SCSI_UFS_QCOM=y
CONFIG_PHY_QCOM_QMP_UFS=y
CONFIG_PHY_QCOM_QMP_COMBO=m
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_NCM=y
# Charging / power measurements early.
CONFIG_QCOM_PMIC_GLINK=m
CONFIG_BATTERY_QCOM_BATTMGR=m
CONFIG_QCOM_STATS=y
# Keep the kernel log of a crashed boot.
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_LOCALVERSION="-duo2"
CONFIG_PHY_QCOM_USB_SNPS_FEMTO_V2=y
# The QMP PHY drivers sit under PHY_QCOM_QMP: built in, or UFS (and so the
# root filesystem) cannot come up without loading modules from it.
CONFIG_PHY_QCOM_QMP=y
CONFIG_PHY_QCOM_QMP_UFS=y
CONFIG_PHY_QCOM_QMP_USB=y
# A stable release string ("7.3.4-duo2+"), so a rebuilt kernel finds its
# modules without reinstalling them under a new git-hash name every time.
# CONFIG_LOCALVERSION_AUTO is not set
# ath11k debug messages (debug_mask=) while WiFi is brought up
CONFIG_ATH11K_DEBUG=y
# debugfs for the WLAN chip: simulate_fw_crash hw-restart restarts a stuck
# firmware by hand (ath11k's crash recovery), fw_stats
CONFIG_CFG80211_DEBUGFS=y
CONFIG_MAC80211_DEBUGFS=y
CONFIG_ATH11K_DEBUGFS=y
# Hang detectors instead of a hardware watchdog: the APSS watchdog registers
# (0x17c10000) fault for Linux under the WOA UEFI (synchronous external abort
# in qcom_wdt_probe). The boot entries add hung_task_panic=1 softlockup_panic=1
# nmi_watchdog=panic, so a wedged kernel panics, and panic=30 cold-resets it.
# The hard-lockup detector is the "buddy" one: CPUs watch each other with
# timers, no NMI needed.
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_DETECT_HUNG_TASK=y
CONFIG_HARDLOCKUP_DETECTOR=y
# Surface Duo 2 panels (both DSI links), and the watchdog the Gunyah
# hypervisor offers through SMCCC (the APSS MMIO watchdog is its own)
CONFIG_DRM_PANEL_MICROSOFT_ELGIN=m
CONFIG_GUNYAH_WATCHDOG=m
# Surface Duo 2 touch digitizer: HID over SPI (Microsoft vendor driver)
CONFIG_SPI_HID=m
CONFIG_SPI_QCOM_GENI=m
# uinput: duo2-touchd creates the two touchscreens through it
CONFIG_INPUT_UINPUT=m
# The SLPI's "APSS awake" SMP2P bit: without it the sensor DSP never publishes
# remote_proc_state, device_state, the magnetometers, hinge angle and posture.
# Built in, so the bit is set before the SLPI is started.
CONFIG_QCOM_SMP2P_SLEEPSTATE=y
# Yama: a process may ptrace only its own descendants (ptrace_scope 1, also
# set by the image's sysctl.d/60-duo2-ptrace.conf), so an app of the GUI user
# cannot attach to the on-screen keyboard or the session script and use their
# trusted connections (docs/hardware/security.md). The default LSM list
# (CONFIG_LSM) has it already.
CONFIG_SECURITY_YAMA=y
# PM8350B haptics (HAP520): the vibration motor, an input force-feedback
# device (FF_RUMBLE / FF_PERIODIC / FF_CONSTANT) for feedbackd
CONFIG_INPUT_QCOM_SPMI_HAPTICS=m
# Waydroid (Android apps in an LXC container, docs/hardware/android.md): binder through binderfs (waydroid creates its own binder,
# hwbinder and vndbinder devices in a binderfs instance, so no static devices),
# PSI for Android's low-memory killer (lmkd), and the container's diagnostic
# sockets lxc-checkconfig lists.
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_ANDROID_BINDER_DEVICES=""
CONFIG_PSI=y
# CONFIG_PSI_DEFAULT_DISABLED is not set
CONFIG_UNIX_DIAG=m
CONFIG_PACKET_DIAG=m
CONFIG_NETLINK_DIAG=m
CONFIG_CHECKPOINT_RESTORE=y
CONFIG_CGROUP_NET_PRIO=y
CONFIG_CGROUP_NET_CLASSID=y
# Waydroid's network: the container's veth on the waydroid0 bridge, NATed out
# (waydroid-net.sh; nft directly, or iptables, which is iptables-nft on
# Debian), dnsmasq for DHCP + DNS on the bridge, and the duo2-waydroid-fw nft
# table (no inbound, nothing to the host but DHCP + DNS). waydroid-net.sh
# prefers iptables-legacy whenever the binary exists (Debian's iptables
# package ships it beside iptables-nft), so the legacy tables are here too;
# both feed the same netfilter hooks, and a drop in either one is final.
CONFIG_NF_TABLES=m
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NF_TABLES_BRIDGE=m
CONFIG_NF_TABLES_NETDEV=y
CONFIG_NFT_NUMGEN=m
CONFIG_NFT_CT=m
CONFIG_NFT_CONNLIMIT=m
CONFIG_NFT_LOG=m
CONFIG_NFT_LIMIT=m
CONFIG_NFT_MASQ=m
CONFIG_NFT_REDIR=m
CONFIG_NFT_NAT=m
CONFIG_NFT_TUNNEL=m
CONFIG_NFT_QUOTA=m
CONFIG_NFT_REJECT=m
CONFIG_NFT_COMPAT=m
CONFIG_NFT_HASH=m
CONFIG_NFT_FIB_INET=m
CONFIG_NFT_FIB_IPV4=m
CONFIG_NFT_FIB_IPV6=m
CONFIG_NFT_SOCKET=m
CONFIG_NFT_TPROXY=m
CONFIG_NF_NAT=m
CONFIG_NF_CONNTRACK_MARK=y
CONFIG_NF_CONNTRACK_ZONES=y
CONFIG_NF_CONNTRACK_EVENTS=y
CONFIG_NF_CT_NETLINK=m
CONFIG_NETFILTER_NETLINK_ACCT=m
CONFIG_NETFILTER_XT_CONNMARK=m
CONFIG_NETFILTER_XT_NAT=m
CONFIG_NETFILTER_XT_TARGET_CHECKSUM=m
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=m
CONFIG_NETFILTER_XT_TARGET_REDIRECT=m
CONFIG_NETFILTER_XT_TARGET_CT=m
CONFIG_NETFILTER_XT_TARGET_LOG=m
CONFIG_NETFILTER_XT_TARGET_TCPMSS=m
CONFIG_NETFILTER_XT_MATCH_COMMENT=m
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=m
CONFIG_NETFILTER_XT_MATCH_STATE=m
CONFIG_NETFILTER_XT_MATCH_LIMIT=m
CONFIG_NETFILTER_XT_MATCH_MARK=m
CONFIG_NETFILTER_XT_MATCH_PKTTYPE=m
CONFIG_NETFILTER_XT_MATCH_IPRANGE=m
CONFIG_NETFILTER_XT_MATCH_PHYSDEV=m
CONFIG_NETFILTER_XT_MATCH_OWNER=m
CONFIG_NETFILTER_XT_MATCH_TCPMSS=m
CONFIG_NETFILTER_XT_MATCH_CONNLIMIT=m
CONFIG_NETFILTER_XT_MATCH_STATISTIC=m
CONFIG_NETFILTER_XT_MATCH_RECENT=m
CONFIG_NF_REJECT_IPV4=m
CONFIG_NF_REJECT_IPV6=m
CONFIG_NETFILTER_XTABLES_LEGACY=y
CONFIG_IP_NF_IPTABLES=m
CONFIG_IP_NF_IPTABLES_LEGACY=m
CONFIG_IP_NF_FILTER=m
CONFIG_IP_NF_NAT=m
CONFIG_IP_NF_TARGET_MASQUERADE=m
CONFIG_IP_NF_MANGLE=m
CONFIG_IP_NF_TARGET_REJECT=m
CONFIG_IP6_NF_IPTABLES=m
CONFIG_IP6_NF_IPTABLES_LEGACY=m
CONFIG_IP6_NF_FILTER=m
CONFIG_IP6_NF_NAT=m
CONFIG_IP6_NF_TARGET_MASQUERADE=m
CONFIG_IP6_NF_MANGLE=m
CONFIG_IP6_NF_TARGET_REJECT=m
# AppArmor: the confinement of the Waydroid container (a privileged LXC
# container: without a MAC policy its root could mount procfs / sysfs /
# debugfs read-write and so reach the host). The duo2-waydroid profile is
# android/apparmor/duo2-waydroid; the other profiles are Debian's own
# (package apparmor). Added to the default LSM list after yama.
CONFIG_SECURITY_APPARMOR=y
CONFIG_LSM="landlock,lockdown,yama,loadpin,safesetid,ipe,apparmor,bpf"
# Voice calls: the ADSP voice services (q6mvm, q6cvs, q6cvp) and the
# VoiceMMode1/2 front ends (docs/hardware/audio.md)
CONFIG_SND_SOC_QDSP6_Q6VOICE=m
# Android's network stack inside Waydroid: netd routes every network through
# its own table selected by fwmark rules (policy routing; without it the
# container has no default route), and its iptables setup uses the raw tables
# and these matches / targets (in the container's own network namespace).
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_IPV6_MULTIPLE_TABLES=y
CONFIG_IP_NF_RAW=m
CONFIG_IP6_NF_RAW=m
CONFIG_NETFILTER_XT_TARGET_IDLETIMER=m
CONFIG_NETFILTER_XT_TARGET_NFLOG=m
CONFIG_NETFILTER_XT_MATCH_HL=m
CONFIG_NETFILTER_XT_MATCH_QUOTA=m
CONFIG_NETFILTER_XT_MATCH_SOCKET=m
# Sleep (docs/hardware/power.md): /sys/power/pm_wakeup_irq (which interrupt
# ended a suspend), pm_debug_messages, pm_print_times. The EFI RTC (rtc0)
# cannot be read or set on this phone: the kernel does not try to keep it in
# sync with NTP (each failed attempt took rtc0's wakeup source).
CONFIG_PM_DEBUG=y
CONFIG_PM_SLEEP_DEBUG=y
# CONFIG_RTC_SYSTOHC is not set
# The hung-task detector is off for the whole system suspend: a device
# suspend/resume callback that blocks there would hang the phone for good
# (nothing else can reset it). The PM core's watchdog panics after 60 s in
# one callback (its stack after 20 s), and panic=30 cold-resets. Needs EXPERT
# (no other symbol changes with it).
CONFIG_EXPERT=y
CONFIG_DPM_WATCHDOG=y
CONFIG_DPM_WATCHDOG_ENABLED=y
CONFIG_DPM_WATCHDOG_TIMEOUT=60
CONFIG_DPM_WATCHDOG_WARNING_TIMEOUT=20
# Camera bring-up (docs/hardware/camera.md): the IMX481 / IMX563 sensors' power and
# identification driver (BRING-UP patch; streaming comes later)
CONFIG_VIDEO_IMX48X=m

# The WiFi country from the user or the mobile network (hotspot/README.md
# "Regulatory domain"): ath11k takes a user's country (iw reg set XX) only
# with this; without it the hint is dropped and only 11d sets one.
# CERTIFICATION_ONUS itself turns nothing on (its other options default n).
CONFIG_CFG80211_CERTIFICATION_ONUS=y
CONFIG_ATH_REG_DYNAMIC_USER_REG_HINTS=y

# Optional data encryption tied to the lock screen's PIN (homecrypt/README.md):
# fscrypt v2 policies on ext4, the contents AES-256-XTS, the names
# AES-256-HCTR2. fscrypt always goes through blk-crypto: the UFS Inline Crypto
# Engine with -o inlinecrypt when the UFS host has one (sm8350.dtsi's ice
# node), else blk-crypto-fallback on the CPU's AES instructions. XTS built in:
# the first encrypted file is opened before any module could be loaded.
CONFIG_FS_ENCRYPTION=y
CONFIG_FS_ENCRYPTION_INLINE_CRYPT=y
CONFIG_BLK_INLINE_ENCRYPTION_FALLBACK=y
CONFIG_CRYPTO_XTS=y
CONFIG_CRYPTO_HCTR2=y
