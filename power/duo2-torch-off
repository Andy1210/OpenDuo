#!/bin/sh
# duo2-torch-off: switch the torch off (the rear camera's flash LED lit as a
# light, ), through the kernel's LED class only
# (brightness 0 for every <colour>:torch / <colour>:flash LED that is lit).
#
#   duo2-torch-off [WHY]        by hand, or duo2-torch-off.service's ExecStop
#                               (every shutdown and reboot)
#   duo2-torch-off pre suspend  as the system-sleep hook
#                               /usr/lib/systemd/system-sleep/duo2-torch
#                               ("post" does nothing): a suspend with the
#                               torch lit switches it off (duo2-autosleep does
#                               not suspend while it is lit; this is for a
#                               suspend that happens anyway), and it stays off
#
# Nothing in the kernel switches it off by itself: the driver has no suspend
# or shutdown hook, and the flash module is in the PMIC, which stays powered
# while the SoC sleeps (whether the module's supply holds up in s2idle is not
# known: it must not be left to chance) and is not necessarily reset by a
# restart. Prints a line for each LED it switched off (the journal).
set -u
case "${1:-}" in
    post) exit 0 ;;
    pre) why=${2:-sleep} ;;
    *) why=${1:-request} ;;
esac
for d in /sys/class/leds/*:torch /sys/class/leds/*:flash; do
    [ -e "$d/brightness" ] || continue
    b=$(cat "$d/brightness" 2>/dev/null) || continue
    [ "$b" = 0 ] && continue
    if echo 0 >"$d/brightness"; then
        echo "duo2-torch-off: ${d##*/} switched off (brightness was $b; $why)"
    fi
done
exit 0
