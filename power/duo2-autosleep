    "wifi_sleep": "off",  # off (the WLAN chip powered off) | wowlan (it stays associated)
    "wowlan_wake": "tcp,disconnect",  # what wakes the phone in WoWLAN (WOWLAN_TRIGGERS)
    "wifi_grace": 12,  # s awake after a wake by the WiFi (WoWLAN), from WiFi's answer
    "wowlan_max_failures": 2,  # WoWLAN sleeps in a row WiFi did not survive: WoWLAN off
