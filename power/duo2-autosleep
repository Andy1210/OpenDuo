HOLD = "/etc/duo2/autosleep-hold"
HOLD_UNTIL = "/etc/duo2/autosleep-hold-until"  # a timed hold's end (epoch s, first line)
HOLD_MAX_S = 24 * 3600  # the longest timed hold; an end further ahead is not trusted
HOLD_SLACK_S = 300  # ... plus this (a clock corrected by NTP after the hold was set)
CHARGING_HOLD_FLOOR = 10  # % at or below which a battery not charging ends the charging hold
LEDS = "/sys/class/leds"
TEST_WALL = 300  # s: a --test-max / --dry-run run ends after this, wall clock
CONF = "/etc/duo2/autosleep.conf"
RUN_CONF = "/run/duo2/autosleep.conf"  # settings until the next boot (tmpfs), over CONF
SOCK = "/run/duo-wc/admin.sock"
CLOCK_REALTIME_ALARM = 8

