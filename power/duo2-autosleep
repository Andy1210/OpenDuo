    "delay": 20,  # s dark before the first suspend
    "resume_grace": 15,  # s awake after a resume at least, counted from WiFi's return
    "wifi_wait": 45,  # s after a resume to wait for WiFi before sleeping without it
    "modem_grace": 8,  # s awake after a wake by the modem alone (no WiFi wait)
    "request_grace": 3,  # s awake after a wake by a modem request alone (rmtfs: its EFS)
    "check_interval": 10,  # s between checks while something holds it awake
    "alarm_lead": 45,  # s before a Clocks alarm to wake
    "wake_every": 0,  # s, 0 = no periodic wake
