#!/bin/sh
# duo2-wifi-mac-trial: try the factory WLAN MAC at runtime, with a way back.
#
# Before the MAC goes into the .link drop-in (duo2-factory-addr install), this
# proves that the network accepts it, without risking the only link to a phone
# nobody can touch. Run it detached, then confirm from the outside:
#
#   sudo systemd-run --unit=duo2-wifi-mac-trial --collect /usr/local/sbin/duo2-wifi-mac-trial
#   ... reconnect over ssh (the DHCP lease may move) ...
#   sudo touch /run/duo2-wifi-mac-trial.ok          # within CONFIRM s: keep it
#
# wlan0 gets WLAN_MAC from /etc/duo2/factory-addresses (wpa_supplicant
# stopped, link down, address, up, wpa_supplicant started). Unless the phone
# is online again within ONLINE s AND confirmed within CONFIRM s, the old
# address is put back the same way; still offline after that: reboot (the
# runtime change is gone, the boot falls back to the old setup). The log,
# /run/duo2-wifi-mac-trial.log, names no address.
set -u
ONLINE=${ONLINE:-60}
CONFIRM=${CONFIRM:-240}
log=/run/duo2-wifi-mac-trial.log
ok=/run/duo2-wifi-mac-trial.ok
new=$(sed -n 's/^WLAN_MAC=//p' /etc/duo2/factory-addresses 2>/dev/null)
echo "$new" | grep -qiE '^[0-9a-f]{2}(:[0-9a-f]{2}){5}$' || { echo "no WLAN_MAC in /etc/duo2/factory-addresses" >&2; exit 1; }
old=$(cat /sys/class/net/wlan0/address)
rm -f "$ok"
say() { echo "$(date +%T) $*" >>"$log"; }

setmac() {
	systemctl stop wpa_supplicant@wlan0.service
	ip link set wlan0 down
	ip link set wlan0 address "$1"
	ip link set wlan0 up
	systemctl start wpa_supplicant@wlan0.service
	[ "$(cat /sys/class/net/wlan0/address)" = "$1" ]
}

online() {
	i=0
	while [ $i -lt "$1" ]; do
		gw=$(ip -4 route show default dev wlan0 2>/dev/null | awk '{ print $3; exit }')
		if [ -n "$gw" ] && ping -c 1 -W 1 -I wlan0 "$gw" >/dev/null 2>&1; then
			say "online: $(ip -4 -br addr show wlan0 | awk '{ print $3 }') via $gw"
			return 0
		fi
		sleep 1
		i=$((i + 1))
	done
	return 1
}

say "trial: factory MAC on wlan0 (was $( [ "$old" = "$new" ] && echo the same || echo another ))"
if setmac "$new" && online "$ONLINE"; then
	i=0
	while [ $i -lt "$CONFIRM" ]; do
		[ -e "$ok" ] && { say "confirmed: keeping the factory MAC"; exit 0; }
		sleep 1
		i=$((i + 1))
	done
	say "not confirmed within $CONFIRM s"
else
	say "factory MAC: not online within $ONLINE s"
fi
say "reverting to the previous MAC"
if setmac "$old" && online "$ONLINE"; then
	say "reverted, online"
	exit 1
fi
say "still offline: reboot"
sync
t=$(cat /proc/sys/kernel/tainted)
if [ $((t & 128)) -ne 0 ]; then
	echo 1 >/proc/sys/kernel/sysrq
	echo b >/proc/sysrq-trigger
fi
systemctl reboot
