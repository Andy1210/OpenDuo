#!/usr/bin/env bash
# A read-only health snapshot of the running phone, the list every try is
# checked against : kernel and try id, WiFi, the USB UDC,
# the bring-up services, the remote processors and the modem's DOG crashes,
# frames presented per panel, the pose from the sensors, the sound card and
# the audio modules (looked at, never touched), the GPU runtime state, oopses
# and warnings, and the GPU / GMU kernel lines of this boot.
#
#   scripts/duo2-health
#
# Prints no MAC, BSSID or serial. Changes nothing on the phone.
set -eu
. "$(dirname "$0")/lib/remote.sh"

duo2_ssh "bash -s" <<'EOF'
set -u
k() { sudo journalctl -k -b --no-pager "$@"; }
echo "kernel $(uname -r), up $(cut -d. -f1 /proc/uptime) s, tainted $(cat /proc/sys/kernel/tainted)"
echo "options: $(tr ' ' '\n' < /proc/cmdline | grep -E '^(duo2\.try|msm\.|panel_|clk_ignore|pd_ignore|fw_devlink\.sync)' | tr '\n' ' ')"
echo "wifi: $(cat /sys/class/net/wlan0/operstate 2>/dev/null), carrier $(cat /sys/class/net/wlan0/carrier 2>/dev/null), ipv4 $(ip -4 -o addr show wlan0 2>/dev/null | grep -c inet)"
echo "udc: $(ls /sys/class/udc 2>/dev/null) ($(cat /sys/class/udc/*/state 2>/dev/null))"
for s in duo-wc duo2-touchd hexagonrpcd duo-posed rmtfs qrtr-ns tqftpserv; do printf '%s=%s ' $s "$(systemctl is-active $s)"; done; echo
for r in /sys/class/remoteproc/remoteproc*; do printf '%s:%s ' "$(cat $r/name)" "$(cat $r/state)"; done; echo
echo "modem: 'DOG detects' $(k | grep -c 'DOG detects'), crash/recovery lines $(k | grep -c -i -E 'remoteproc.*(crash|recover)')"
# duoctl as the administrator: duo-wc's admin socket (no session.env needed).
duoctl get_outputs | python3 -c "import json,sys; print('frames presented:', ', '.join('%s %s' % (o['name'], o.get('frames_presented')) for o in json.load(sys.stdin)['ok']['outputs']))"
echo "duo-posed: $(sudo journalctl -u duo-posed -b --no-pager -o cat | grep 'sensors say' | tail -1)"
echo "sound cards: $(sed -n 's/^ *[0-9]* \[\([^]]*\)\].*/\1/p' /proc/asound/cards 2>/dev/null | tr -d ' ' | tr '\n' ' ')"
echo "audio modules: $(lsmod | awk '{print $1}' | grep -E '^(snd_soc_sm8250|snd_q6|q6|snd_soc_wsa|soundwire|snd_soc_lpass|apr)' | sort | tr '\n' ' ')"
echo "gpu: $(cat /sys/bus/platform/devices/3d00000.gpu/power/runtime_status), autosuspend $(cat /sys/bus/platform/devices/3d00000.gpu/power/autosuspend_delay_ms) ms"
echo "oops / BUG: $(k | grep -c -E 'Oops|BUG:|Internal error|Unable to handle kernel'), warnings ('cut here'): $(k | grep -c 'cut here')"
k -o cat | grep -A1 'cut here' | grep -v -E 'cut here|^--$' | sed 's/CPU#[0-9]*: .*//' | sort | uniq -c
echo "GPU / GMU lines:"
k -o short-monotonic | grep -E 'a6xx|adreno|gmu|hangcheck|gpu fault|devcoredump|recovering' |
    grep -v -E 'supply .* not found|loaded qcom/|Loaded GMU|Adding to iommu|bound 3d00000' | tail -20
EOF
