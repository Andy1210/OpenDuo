#!/usr/bin/env bash
# Hardware video decoding on the phone (the iris video core, /dev/video0;
# docs/hardware/video.md): test clips, correctness, CPU, the idle state.
#
#   scripts/duo2-video-test clips            make the test clips here (ffmpeg,
#                                            out/video-test/) and copy them to
#                                            the phone's /var/tmp/duo2-video/
#   scripts/duo2-video-test [check]          bit-exactness (hardware = software),
#                                            mpv with the installed /etc/mpv in
#                                            real time, GStreamer in real time,
#                                            then the video core at rest
#   scripts/duo2-video-test celluloid CLIP [celluloid options]
#                                            open a clip in Celluloid on the
#                                            panels, CPU over 8 s, close it
#
# The clips are test patterns with noise and no audio track: 1080p30 H.264,
# HEVC, VP9, HEVC Main 10, 2160p30 H.264 and HEVC, 10 s each. Nothing 10-bit
# goes to the hardware directly here (the driver refuses it and its error
# path warns); mpv's installed configuration sends it to software.
set -euo pipefail
. "$(dirname "$0")/lib/remote.sh"
WHAT=${1:-check}
CLIPS=$R/out/video-test
DIR=/var/tmp/duo2-video

case $WHAT in
clips)
    mkdir -p "$CLIPS"
    src() { echo "testsrc2=size=$1:rate=30,noise=alls=12:allf=t+u,format=$2"; }
    enc() { # name size pixfmt codec options...
        local n=$1 s=$2 p=$3; shift 3
        [ -f "$CLIPS/$n" ] || nice ffmpeg -hide_banner -loglevel error -y -f lavfi -i "$(src "$s" "$p")" \
            -t 10 -an "$@" "$CLIPS/$n"
    }
    X265="-x265-params pools=8:log-level=error -tag:v hvc1"
    enc h264-1080p30.mp4 1920x1080 yuv420p -c:v libx264 -profile:v high -preset medium -b:v 8M \
        -maxrate 10M -bufsize 16M -threads 8
    # shellcheck disable=SC2086
    enc hevc-1080p30.mp4 1920x1080 yuv420p -c:v libx265 -preset fast -b:v 6M $X265
    enc vp9-1080p30.webm 1920x1080 yuv420p -c:v libvpx-vp9 -b:v 6M -deadline realtime -cpu-used 8 \
        -row-mt 1 -threads 8
    # shellcheck disable=SC2086
    enc hevc10-1080p30.mp4 1920x1080 yuv420p10le -c:v libx265 -preset fast -b:v 6M -profile:v main10 $X265
    enc h264-2160p30.mp4 3840x2160 yuv420p -c:v libx264 -profile:v high -preset faster -b:v 25M \
        -maxrate 30M -bufsize 50M -threads 8
    # shellcheck disable=SC2086
    enc hevc-2160p30.mp4 3840x2160 yuv420p -c:v libx265 -preset faster -b:v 15M $X265
    S=$(duo2_stage video-clips)
    duo2_ssh "mkdir -p $S"
    duo2_scp "$CLIPS"/*.mp4 "$CLIPS"/*.webm "$DUO2_HOST:$S/"
    duo2_ssh "sudo install -d -m 755 $DIR && sudo install -m 644 $S/* $DIR/ \
        && rm -rf $S && ls $DIR"
    ;;
check)
    duo2_ssh "sudo bash -s $DIR $DUO2_USER" <<'EOF'
set -u
cd "$1"
U="sudo -u $2"
echo "dma-coherent: $([ -e /proc/device-tree/soc@0/video-codec@aa00000/dma-coherent ] && echo yes || echo no)"
echo "== bit-exactness: hardware vs software (ffmpeg framemd5, NV12; VP9: GStreamer checksumsink)"
for c in "h264_v4l2m2m h264 h264-1080p30.mp4" "hevc_v4l2m2m hevc hevc-1080p30.mp4" \
         "h264_v4l2m2m h264 h264-2160p30.mp4" "hevc_v4l2m2m hevc hevc-2160p30.mp4"; do
    set -- $c
    $U ffmpeg -y -hide_banner -nostdin -loglevel error -c:v $1 -i $3 -pix_fmt nv12 -f framemd5 /tmp/v-hw.md5
    ffmpeg -y -hide_banner -nostdin -loglevel error -c:v $2 -i $3 -pix_fmt nv12 -f framemd5 /tmp/v-sw.md5
    printf '%-20s %s frames, %s\n' $3 "$(grep -vc '^#' /tmp/v-hw.md5)" \
        "$(cmp -s <(grep -v '^#' /tmp/v-hw.md5 | cut -d, -f6) <(grep -v '^#' /tmp/v-sw.md5 | cut -d, -f6) && echo equal || echo DIFFERENT)"
done
for d in v4l2vp9dec avdec_vp9; do
    $U timeout 120 gst-launch-1.0 -q filesrc location=vp9-1080p30.webm ! matroskademux ! $d ! videoconvert \
        ! video/x-raw,format=I420 ! checksumsink sync=false > /tmp/v-$d.txt 2>&1 < /dev/null
done
printf '%-20s %s frames, %s\n' vp9-1080p30.webm "$(wc -l < /tmp/v-v4l2vp9dec.txt)" \
    "$(cmp -s <(awk '{print $NF}' /tmp/v-v4l2vp9dec.txt) <(awk '{print $NF}' /tmp/v-avdec_vp9.txt) && echo equal || echo DIFFERENT)"
rm -f /tmp/v-hw.md5 /tmp/v-sw.md5 /tmp/v-*.txt
echo "== mpv in real time with the installed /etc/mpv (no video or audio output)"
for f in h264-1080p30.mp4 hevc-1080p30.mp4 h264-2160p30.mp4 hevc-2160p30.mp4 hevc10-1080p30.mp4 vp9-1080p30.webm; do
    TIMEFORMAT="%R %U %S"
    t=$( { time $U timeout 60 mpv --vo=null --ao=null --term-status-msg='STAT ${hwdec-current} dropped ${frame-drop-count}' \
        $f > /tmp/v-mpv.out 2>&1 < /dev/null; } 2>&1 )
    set -- $t
    awk -v f=$f -v r=$1 -v u=$2 -v s=$3 -v st="$(tr '\r' '\n' < /tmp/v-mpv.out | grep STAT | tail -1 | cut -d' ' -f2-)" \
        'BEGIN { printf "%-20s %5.2f s, CPU %4.0f %% of a core, hwdec %s\n", f, r, (u + s) / r * 100, st }'
    sleep 2
done
rm -f /tmp/v-mpv.out
echo "== GStreamer in real time (playbin's choice: the V4L2 decoders)"
for p in "h264-1080p30.mp4 v4l2h264dec" "hevc-1080p30.mp4 v4l2h265dec" "vp9-1080p30.webm v4l2vp9dec"; do
    set -- $p
    printf '%-20s %s\n' $1 "$($U timeout 60 gst-launch-1.0 -v filesrc location=$1 ! parsebin ! $2 \
        ! fpsdisplaysink video-sink=fakesink text-overlay=false sync=true 2>&1 < /dev/null |
        grep -o 'rendered: [0-9]*, dropped: [0-9]*, current: [0-9.,]*, average: [0-9.,]*' | tail -1)"
    sleep 2
done
sleep 3
D=/sys/bus/platform/devices/aa00000.video-codec
C=/sys/kernel/debug/clk
echo "== at rest: runtime PM $(cat $D/power/runtime_status), clocks enabled: axi $(cat $C/gcc_video_axi0_clk/clk_enable_count)" \
     "mvs0c $(cat $C/video_cc_mvs0c_clk/clk_enable_count) mvs0 $(cat $C/video_cc_mvs0_clk/clk_enable_count)," \
     "GDSCs: $(awk '/^mvs0c?_gdsc/ {printf "%s %s ", $1, $2}' /sys/kernel/debug/pm_genpd/pm_genpd_summary)"
echo "kernel: $(dmesg | grep -c qcom-iris) qcom-iris lines, $(dmesg | grep -c 'cut here') warnings this boot"
dmesg | grep qcom-iris | tail -5
EOF
    ;;
celluloid)
    CLIP=${2:?usage: $0 celluloid CLIP [celluloid options]}
    shift 2
    duo2_session "pgrep -x celluloid >/dev/null && { echo 'Celluloid is open already (it would take the clip over): close it first' >&2; exit 1; }
log=\$(mktemp /tmp/celluloid-XXXXXX.log)
celluloid --new-window --mpv-log-file=\$log --mpv-loop-file=inf $* $DIR/$CLIP >/dev/null 2>&1 &
pid=\$!
sleep 1.5
s0=\$(awk '{print \$14 + \$15}' /proc/\$pid/stat); t0=\$(date +%s%N)
sleep 8
s1=\$(awk '{print \$14 + \$15}' /proc/\$pid/stat); t1=\$(date +%s%N)
kill \$pid; wait \$pid 2>/dev/null
awk -v a=\$s0 -v b=\$s1 -v t0=\$t0 -v t1=\$t1 -v tk=\$(getconf CLK_TCK) -v c='$CLIP $*' \
    'BEGIN { printf \"celluloid %s: CPU %.0f %% of a core\\n\", c, (b - a) / tk / ((t1 - t0) / 1e9) * 100 }'
grep -h -E 'Using hardware decoding|duo2_hwdec\\] software|VO: \\[' \$log | cut -c1-120
rm -f \$log"
    ;;
*)
    echo "usage: $0 [clips|check|celluloid CLIP]" >&2
    exit 2
    ;;
esac
