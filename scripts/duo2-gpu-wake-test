#!/usr/bin/env bash
# GPU idle -> wake cycles without eyes: does the first frame after an idle
# period render, and does the GMU answer? (The 2026-11-07 08:15 hang: after a
# while idle, six "Timeout waiting for GMU OOB set GPU_SET", a CP fault at
# iova 0 and a recovery deadlock; docs/hardware/display.md.)
#
#   scripts/duo2-gpu-wake-test [CYCLES] [IDLE_SECONDS ...]
#                                   (default 20 cycles each of 2, 15, 60, 300 s)
#   WAKE_MAX_FAIL=N scripts/duo2-gpu-wake-test ...   (default 1)
#
# IDLE 0 = back-to-back resumes (the GPU autosuspends 66 ms after a frame):
# about 0.3 s a cycle, the closest to the 08:15 event, which came in the
# middle of heavy touch use, not after a long idle. First run 2026-11-07
# (20 0 2 15: 60/60).
#
# Runs against the duo-wc that is running. It lights both panels, sets the
# idle timeout to 0 and opens one terminal on DSI-1 that prints a line for
# every poke. Per cycle:
#   - waits until the GPU is runtime suspended, then IDLE seconds more, and
#     checks that it stayed suspended (runtime_suspended_time grew by ~IDLE);
#   - pokes the terminal (one line = one composited frame on the GPU) and
#     polls duo-wc's frames_presented for DSI-1 every 20 ms for 3 s;
#   - prints: idle, cycle, latency poke -> frame (ms) or FAIL, and every new
#     kernel line from msm / GMU / SMMU (OOB timeouts, gpu fault, hangcheck,
#     and with the BRING-UP draft 0006: the OOB latency maximum and the GMU
#     state dump).
# On the first FAIL it collects what the 120 s hung_task_panic would destroy:
# the stacks of every D-state task, a sysrq-w dump into the kernel log, the
# GPU/GMU runtime PM state, and syncs the journal. A devcoredump that appears
# is copied to /var/lib/duo2/devcoredump/ by a udev rule that lives in /run
# for this run only (it is read outside udev: reading it takes gpu->lock).
# Then it pokes once more and waits at least 10 s for a frame: with the recovery
# fixes (kernel patches 0038-0041) a GMU timeout should end in a recovery, not
# a hang. Not recovered: stop. Recovered: go on, until WAKE_MAX_FAIL failures
# (set it above 1 for unattended rate measurements).
#
# Useful variants (one per run, compare the failure rate):
#   msm.stall_on_fault=0 (draft 0005), msm.gmu_oob_timeout_ms=200 (draft
#   0006), the DT drafts 0007/0008, panel_microsoft_elgin.refresh=60, and the
#   old power options (clk_ignore_unused pd_ignore_unused, no
#   fw_devlink.sync_state=timeout): duo2-try --same-kernel --append ...
set -eu
. "$(dirname "$0")/lib/remote.sh"
cycles=${1:-20}
shift || true
idles=${*:-2 15 60 300}
maxfail=${WAKE_MAX_FAIL:-1}

duo2_ssh "bash -s" <<EOF
set -u
# duoctl as the administrator reaches duo-wc's admin socket; apps start as
# the GUI user inside the session (docs/hardware/security.md).
as_user() { sudo -u $DUO2_USER sh -c '. /run/duo-wc/session.env; exec "\$@"' sh "\$@"; }
conf_idle=\$(sed -n "s/^[[:space:]]*idle_timeout[[:space:]]*=[[:space:]]*\([0-9]*\).*/\1/p" /etc/duo-wc/duo-wc.conf 2>/dev/null)
conf_idle=\${conf_idle:-60}
G=/sys/bus/platform/devices/3d00000.gpu/power
F=/tmp/duo2-gpu-wake.fifo
pids=
cleanup() {
    for p in \$pids; do sudo kill \$p 2>/dev/null; done
    rm -f \$F
    sudo rm -f /run/udev/rules.d/90-duo2-devcoredump.rules /run/duo2-save-devcoredump
    sudo udevadm control --reload 2>/dev/null
    duoctl set_idle_timeout \$conf_idle >/dev/null
}
trap cleanup EXIT

# devcoredump saver, this run only
sudo mkdir -p /run/udev/rules.d /var/lib/duo2/devcoredump
sudo tee /run/duo2-save-devcoredump >/dev/null <<'SAVE'
#!/bin/sh
d=/sys/class/devcoredump/\$1/data
out=/var/lib/duo2/devcoredump/\$(date +%Y%m%d-%H%M%S)-\$1.txt
cat "\$d" > "\$out" 2>/dev/null
sync -f "\$out"
SAVE
sudo chmod 755 /run/duo2-save-devcoredump
echo 'ACTION=="add", SUBSYSTEM=="devcoredump", RUN+="/usr/bin/systemd-run --no-block --collect /run/duo2-save-devcoredump %k"' |
    sudo tee /run/udev/rules.d/90-duo2-devcoredump.rules >/dev/null
sudo udevadm control --reload

presented() { duoctl get_outputs | python3 -c "import json,sys; print(next(o['frames_presented'] for o in json.load(sys.stdin)['ok']['outputs'] if o['name'] == 'DSI-1'))"; }
klog() { sudo journalctl -k --since "\$1" --no-pager -o short-monotonic | grep -E -i 'gmu|a6xx|adreno|msm_dpu.*recover|gpu fault|hangcheck|smmu|gdsc|rsc' | grep -v '^-- ' || true; }
collect() {
    echo "=== FAIL: collecting (hung_task_panic fires 120 s after the hang)"
    echo "gpu: \$(cat \$G/runtime_status), gmu: \$(cat /sys/bus/platform/devices/3d6a000.gmu/power/runtime_status)"
    for p in /proc/[0-9]*; do
        [ "\$(awk '{print \$3}' \$p/stat 2>/dev/null)" = D ] || continue
        echo "--- D: \$(cat \$p/comm 2>/dev/null) (\${p#/proc/})"
        sudo cat \$p/stack 2>/dev/null
    done
    echo w | sudo tee /proc/sysrq-trigger >/dev/null
    sudo journalctl --sync
    ls -la /sys/class/devcoredump/ /var/lib/duo2/devcoredump/ 2>/dev/null
}

duoctl set_idle_timeout 0 >/dev/null
duoctl set_power all on >/dev/null
sleep 2
mkfifo \$F
duoctl expect_window DSI-1 3000 >/dev/null
as_user foot -a duo2-gpu-wake-test python3 -c '
n = 0
while True:
    with open("'\$F'") as f:
        for line in f:
            n += 1
            print(n, line.strip(), flush=True)
' >/dev/null 2>&1 &
pids="\$pids \$!"
sleep 3
echo "kernel \$(uname -r), \$(cat /proc/cmdline | tr ' ' '\n' | grep -E 'ignore_unused|sync_state|msm\.|refresh' | tr '\n' ' ')"
echo "idle  cycle  latency_ms  suspended_s  new kernel lines"
fails=0
for idle in $idles; do
  ok=0; lat_all=
  for c in \$(seq 1 $cycles); do
    for k in \$(seq 1 250); do [ "\$(cat \$G/runtime_status)" = suspended ] && break; sleep 0.02; done
    s0=\$(cat \$G/runtime_suspended_time)
    sleep \$idle
    s1=\$(cat \$G/runtime_suspended_time)
    t0=\$(date "+%Y-%m-%d %H:%M:%S.%N" | cut -c1-23)
    p0=\$(presented)
    a=\$(date +%s%N)
    echo "idle \$idle cycle \$c" > \$F
    lat=FAIL
    for k in \$(seq 1 150); do
        if [ "\$(presented)" -gt "\$p0" ]; then lat=\$(( (\$(date +%s%N) - a) / 1000000 )); break; fi
        sleep 0.02
    done
    lines=\$(klog "\$t0")
    printf "%4s  %5s  %10s  %11s  %s\n" \$idle \$c \$lat \$(( (s1 - s0) / 1000 )) "\$(echo "\$lines" | grep -c . )"
    [ -n "\$lines" ] && echo "\$lines" | sed 's/^/        /'
    if [ \$lat = FAIL ]; then
        collect
        fails=\$((fails + 1))
        # with the recovery fixes the GPU should come back: poke once more
        p0=\$(presented); a=\$(date +%s%N); rec=
        timeout 5 sh -c "echo 'idle \$idle cycle \$c retry' > \$F"
        for k in \$(seq 1 200); do
            if [ "\$(presented)" -gt "\$p0" ]; then rec=\$(( (\$(date +%s%N) - a) / 1000000 )); break; fi
            sleep 0.05
        done
        klog "\$t0" | sed 's/^/        /'
        if [ -z "\$rec" ]; then echo "=== NOT RECOVERED: no frame in 200 polls (at least 10 s) after the next poke"; exit 1; fi
        echo "=== recovered: a frame \$rec ms after the next poke (failure \$fails of at most $maxfail)"
        [ \$fails -ge $maxfail ] && { echo "=== \$fails failure(s): stopping (WAKE_MAX_FAIL=$maxfail)"; exit 1; }
        continue
    fi
    ok=\$((ok + 1)); lat_all="\$lat_all \$lat"
  done
  echo "idle \$idle s: \$ok/$cycles frames after the wake; latency ms (min/median/max): \$(echo \$lat_all | tr ' ' '\n' | sort -n | awk '{a[NR]=\$1} END {print a[1]"/"a[int((NR+1)/2)]"/"a[NR]}')"
done
echo "failures (no frame within 3 s, recovered): \$fails"
echo "--- GMU OOB latency maxima (BRING-UP draft 0006) since boot:"
sudo journalctl -k -b --no-pager | grep 'acked after' || echo "(none logged: draft 0006 not in this kernel)"
EOF
