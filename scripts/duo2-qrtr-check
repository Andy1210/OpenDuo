#!/usr/bin/env bash
# duo2-qrtr-check: is QRTR closed to the GUI user's programs? (docs/hardware/security.md, "QRTR"; scripts/install-no-qrtr.sh puts the pieces in place).
# Read-only, from the build machine (scripts/lib/remote.sh); nothing is masked away that a
# line needs, nothing identifying is printed (no EID / ICCID).
#
#   1. who holds QRTR sockets: system services only (none in user.slice or
#      duo-wc.service)
#   2. the filter on duo-wc.service and the user manager, and on each of the
#      GUI user's processes (Seccomp_filters > 0; NoNewPrivs 0: sudo works)
#   3. socket(AF_QIPCRTR) from a program the user manager starts: EAFNOSUPPORT
#   4. from there through sudo, the eSIM helper still reads the chip (lpac in
#      a service of its own); the old way (lpac as the helper's child) would
#      fail with euicc_init
#   5. the GUI user's ssh keys come from root's file
set -euo pipefail
R=$(cd "$(dirname "$0")/.." && pwd)
. "$R/scripts/lib/remote.sh"
indent() { sed 's/^/  /'; }
fail=0

echo "== 1. QRTR sockets (pid uid comm count cgroup)"
holders=$(duo2_ssh 'sudo python3 -I -' <<'EOF'
import ctypes, os, socket
libc = ctypes.CDLL(None, use_errno=True)
SYS_pidfd_getfd = 438
for pid in sorted(filter(str.isdigit, os.listdir("/proc")), key=int):
    try:
        socks = [int(fd) for fd in os.listdir("/proc/%s/fd" % pid)
                 if os.readlink("/proc/%s/fd/%s" % (pid, fd)).startswith("socket:")]
        pfd = os.pidfd_open(int(pid))
    except OSError:
        continue
    n = 0
    for fd in socks:
        nfd = libc.syscall(SYS_pidfd_getfd, pfd, fd, 0)
        if nfd < 0:
            continue
        try:
            s = socket.socket(fileno=nfd)
            n += s.family == 42
            s.detach()
        except OSError:
            pass
        os.close(nfd)
    os.close(pfd)
    if n:
        try:
            comm = open("/proc/%s/comm" % pid).read().strip()
            cg = open("/proc/%s/cgroup" % pid).read().strip().split("::")[-1]
            print(pid, os.stat("/proc/%s" % pid).st_uid, comm, n, cg)
        except OSError:
            pass
EOF
)
echo "$holders" | indent
if echo "$holders" | grep -Eq 'user\.slice|duo-wc\.service'; then
    echo "  FAIL: a QRTR socket in the GUI user's tree"; fail=1
fi

echo "== 2. the filter"
duo2_ssh 'for u in duo-wc.service user@$(id -u '"$DUO2_USER"').service; do
    printf "  %s: RestrictAddressFamilies=%s\n" "$u" "$(systemctl show -P RestrictAddressFamilies "$u")"
done
bad=0
for p in $(pgrep -u '"$DUO2_USER"'); do
    f=$(sed -n "s/^Seccomp_filters:\t//p" /proc/$p/status 2>/dev/null) || continue
    nnp=$(sed -n "s/^NoNewPrivs:\t//p" /proc/$p/status 2>/dev/null)
    c=$(cat /proc/$p/comm 2>/dev/null)
    # (sd-pam) is forked before the filter: it only closes the PAM session
    if [ "${f:-0}" = 0 ] && [ "$c" != "(sd-pam)" ]; then echo "  UNFILTERED: $p $c"; bad=1; fi
done
[ $bad = 0 ] && echo "  every process of '"$DUO2_USER"' carries a seccomp filter (except (sd-pam))"
exit $bad' || fail=1

echo "== 3. socket(AF_QIPCRTR) from the user manager's tree"
r=$(duo2_user 'systemd-run --user --quiet --wait --pipe --collect python3 -I -c "
import socket, errno
try:
    socket.socket(42, socket.SOCK_DGRAM); print(\"OPENED\")
except OSError as e:
    print(errno.errorcode[e.errno])
nnp = [l.split()[1] for l in open(\"/proc/self/status\") if l.startswith(\"NoNewPrivs\")][0]
print(\"NoNewPrivs\", nnp)"' 2>&1)
echo "$r" | indent
echo "$r" | grep -q EAFNOSUPPORT || { echo "  FAIL"; fail=1; }

echo "== 4. the eSIM helper through sudo from there (read-only: list)"
r=$(duo2_user 'systemd-run --user --quiet --wait --pipe --collect sh -c "sudo -n /usr/local/sbin/duo2-esim list" |
    python3 -I -c "import json, sys
d = json.loads(sys.stdin.read() or \"{}\")
print(\"ok=%s error=%r profiles=%d\" % (d.get(\"ok\"), d.get(\"error\"), len(d.get(\"profiles\") or [])))"' 2>&1)
echo "  $r"
echo "$r" | grep -q 'ok=True' || { echo "  FAIL"; fail=1; }

echo "== 5. ssh keys of $DUO2_USER"
r=$(duo2_ssh "sudo sshd -T -C user=$DUO2_USER,host=localhost,addr=127.0.0.1 | grep -i '^authorizedkeysfile'; stat -c '%U %a %n' /etc/ssh/authorized_keys.d/$DUO2_USER" 2>&1)
echo "$r" | indent
echo "$r" | grep -q '^authorizedkeysfile /etc/ssh/authorized_keys.d/%u' || { echo "  FAIL"; fail=1; }

[ $fail = 0 ] && echo "QRTR closed to the GUI user's programs" || echo "PROBLEMS above"
exit $fail
