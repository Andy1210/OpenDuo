# Copy to local.env (never committed) and fill in. See scripts/lib/remote.sh.
# The administrator: ssh key login, passwordless sudo, no GUI session.
DUO2_HOST=duo2admin@192.0.2.50
# The GUI user (duo-wc runs as this user; no sudo). Unset: the image's
# default, scripts/lib/defaults.sh; set it for a phone installed with another.
#DUO2_USER=duo
#DUO2_MAC=00:11:22:33:44:55
# scripts/build-images.sh: on = an image for your own phone with Settings >
# Developer on (sshd enabled, the USB network up); the default is off.
#DUO2_DEVELOPER_MODE=on
DUO2_SSH_OPTS="-o UserKnownHostsFile=$R/out/known_hosts"
# scripts/backup-userdata.sh (the phone on stock Android): where the backups go,
# and the mount point that has to be mounted for it (a NAS share).
#DUO2_BACKUP_DIR=/mnt/nas/backups/surface-duo2
#DUO2_BACKUP_MOUNT=/mnt/nas
